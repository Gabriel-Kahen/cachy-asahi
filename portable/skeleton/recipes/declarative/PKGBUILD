prepare() {
  python "$srcdir/source.py" verify --root "$srcdir/qtdeclarative-everywhere-src-$pkgver" \
    --policy "$srcdir/source-notices.json" || return
}

_qt_single_job() {
  if [[ "${MAX_JOBS-1}" != 1 || "${CMAKE_BUILD_PARALLEL_LEVEL-1}" != 1 ]]; then
    printf '%s\n' 'Qt612 candidate requires serial MAX_JOBS=1 and CMAKE_BUILD_PARALLEL_LEVEL=1' >&2
    return 1
  fi
  export MAX_JOBS=1 CMAKE_BUILD_PARALLEL_LEVEL=1
}

build() {
  _qt_single_job || return
  cmake -DCMAKE_AUTOGEN_PARALLEL:STRING=1 -C "$srcdir/configure.cmake" -S "$srcdir/qtdeclarative-everywhere-src-$pkgver" \
    -B "$srcdir/build" -G Ninja \
    -DCMAKE_PROJECT_QtDeclarative_INCLUDE="$srcdir/dependency_guard.cmake" || return
  python "$srcdir/source.py" configuration --build "$srcdir/build" \
    --contract "$srcdir/BUILD-CONTRACT.json" || return
  cmake --build "$srcdir/build" --parallel "$MAX_JOBS" || return
}

check() {
  _qt_single_job || return
  install -d "$srcdir/smoke-source" "$srcdir/smoke-home" || return
  install -m644 "$srcdir/SmokeCMakeLists.txt" "$srcdir/smoke-source/CMakeLists.txt" || return
  install -m644 "$srcdir/smoke.cpp" "$srcdir/smoke.qml" "$srcdir/Consumer.qml" "$srcdir/smoke-source/" || return
  cmake -S "$srcdir/smoke-source" -B "$srcdir/smoke-build" -G Ninja \
    -DQT612_BUILD_TREE="$srcdir/build" || return
  cmake --build "$srcdir/smoke-build" --parallel "$MAX_JOBS" || return
  HOME="$srcdir/smoke-home" QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software \
    QML_DISABLE_DISK_CACHE=1 QT_QUICK_CONTROLS_STYLE=Basic \
    QT_QPA_PLATFORM_PLUGIN_PATH=/usr/lib/qt6/plugins/platforms \
    QT_PLUGIN_PATH="$srcdir/build/lib/qt6/plugins:/usr/lib/qt6/plugins" \
    LD_LIBRARY_PATH="$srcdir/build/lib" \
    timeout 60 "$srcdir/smoke-build/qt612-declarative-smoke" "$srcdir/smoke-source/smoke.qml" || return
  printf '%s\n' 'PASS_QT612_FAMILY_CHECK_DECLARATIVE'
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build" || return
  python "$srcdir/source.py" install-notices --root "$srcdir/qtdeclarative-everywhere-src-$pkgver" \
    --policy "$srcdir/source-notices.json" --stage "$pkgdir" || return
  install -Dm644 "$srcdir/LICENSE.packaging" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.packaging" || return
  install -Dm644 "$srcdir/LICENSE.third-party" "$pkgdir/usr/share/licenses/$pkgname/LicenseRef-Qt-ThirdParty.txt" || return
  install -Dm644 "$srcdir/source-notices.json" "$pkgdir/usr/share/licenses/$pkgname/source-notices.json" || return
  install -Dm644 "$srcdir/BUILD-CONTRACT.json" "$pkgdir/usr/share/licenses/$pkgname/BUILD-CONTRACT.json" || return
  python "$srcdir/check_stage.py" --root "$pkgdir" --contract "$srcdir/BUILD-CONTRACT.json" \
    --notices "$srcdir/source-notices.json" > "$srcdir/stage-contract.json" || return
}
