# Original unselected source candidate; normal dependencies are mandatory.
pkgname=cachy-asahi-qt612-declarative-source-reference
pkgver=6.12.0
pkgrel=1
pkgdesc='Qt6.12 full Linux QML, Quick and Controls development source candidate'
arch=('aarch64')
url='https://code.qt.io/cgit/qt/qtdeclarative.git/'
license=('LGPL-3.0-only' 'GPL-3.0-only' 'Qt-GPL-exception-1.0' 'LicenseRef-Qt-ThirdParty')
depends=('glibc' 'libgcc' 'libstdc++' 'cachy-asahi-qt612-gui-server-source-reference=6.12.0'
         'qt6-shadertools=6.12.0' 'qt6-svg=6.12.0')
makedepends=('gcc' 'cmake>=3.25' 'ninja' 'pkgconf' 'python' 'perl')
provides=("qt6-declarative=$pkgver" 'libQt6Qml.so.6' 'libQt6QmlModels.so.6'
          'libQt6Quick.so.6' 'libQt6QuickControls2.so.6' 'libQt6QuickTemplates2.so.6'
          'libQt6QuickLayouts.so.6' 'libQt6QuickWidgets.so.6' 'libQt6QuickDialogs2.so.6')
conflicts=('qt6-declarative')
options=('!lto' '!debug' '!staticlibs')
PKGEXT='.pkg.tar.xz'
source=("https://download.qt.io/official_releases/qt/6.12/$pkgver/submodules/qtdeclarative-everywhere-src-$pkgver.tar.xz"
        'configure.cmake'
        'dependency_guard.cmake'
        'source.py'
        'check_stage.py'
        'BUILD-CONTRACT.json'
        'source-notices.json'
        'SmokeCMakeLists.txt'
        'smoke.cpp'
        'smoke.qml'
        'Consumer.qml'
        'LICENSE.packaging'
        'LICENSE.third-party'
)
sha256sums=('311f3a2603e1973bb59baef9dfa740a376de713157d4782ee043681e889c9260'
