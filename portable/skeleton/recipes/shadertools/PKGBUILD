pkgname=cachy-asahi-qt612-shadertools-source-reference
pkgver=6.12.0
pkgrel=1
pkgdesc='Qt6.12 ShaderTools and qsb source candidate with bundled compiler notices'
arch=('aarch64')
url='https://code.qt.io/cgit/qt/qtshadertools.git/'
license=('LGPL-3.0-only' 'GPL-3.0-only WITH Qt-GPL-exception-1.0' 'LicenseRef-Qt-ThirdParty')
depends=('glibc' 'libgcc' 'libstdc++' 'cachy-asahi-qt612-gui-server-source-reference=6.12.0')
makedepends=('gcc' 'cmake>=3.25' 'ninja' 'pkgconf' 'python' 'perl')
provides=("qt6-shadertools=$pkgver" 'libQt6ShaderTools.so.6')
conflicts=('qt6-shadertools')
options=('!lto' '!debug' '!staticlibs')
PKGEXT='.pkg.tar.xz'
source=("https://download.qt.io/official_releases/qt/6.12/$pkgver/submodules/qtshadertools-everywhere-src-$pkgver.tar.xz"
        'configure.cmake'
        'dependency_guard.cmake'
        'source.py'
        'check_stage.py'
        'elf.py'
        'reflection.py'
        'BUILD-CONTRACT.json'
        'source-notices.json'
        'vendored-inputs.lock.json'
        'SmokeCMakeLists.txt'
        'smoke.cpp'
        'smoke.vert'
        'smoke.frag'
        'LICENSE.packaging'
        'LICENSE.third-party'
)
