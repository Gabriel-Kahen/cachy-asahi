prepare() {
  python "$srcdir/source.py" verify --root "$srcdir/qtshadertools-everywhere-src-$pkgver" \
    --policy "$srcdir/source-notices.json" --vendors "$srcdir/vendored-inputs.lock.json" || return
}

_qt_single_job() {
  if [[ "${MAX_JOBS-1}" != 1 || "${CMAKE_BUILD_PARALLEL_LEVEL-1}" != 1 ]]; then
    printf '%s\n' 'Qt612 ShaderTools candidate requires serial MAX_JOBS=1 and CMAKE_BUILD_PARALLEL_LEVEL=1' >&2
    return 1
  fi
  export MAX_JOBS=1 CMAKE_BUILD_PARALLEL_LEVEL=1
}

build() {
  _qt_single_job || return
  cmake -DCMAKE_AUTOGEN_PARALLEL:STRING=1 -C "$srcdir/configure.cmake" -S "$srcdir/qtshadertools-everywhere-src-$pkgver" \
    -B "$srcdir/build" -G Ninja \
    -DCMAKE_PROJECT_QtShaderTools_INCLUDE="$srcdir/dependency_guard.cmake" || return
  # All qsb and API targets must configure; no successful empty/skipped build.
  python "$srcdir/source.py" configuration --build "$srcdir/build" || return
  cmake --build "$srcdir/build" --parallel "$MAX_JOBS" || return
}

check() {
  _qt_single_job || return
  local qsb="$srcdir/build/lib/qt6/bin/qsb" stage
  install -d "$srcdir/smoke-source" "$srcdir/smoke-output" || return
  install -m644 "$srcdir/SmokeCMakeLists.txt" "$srcdir/smoke-source/CMakeLists.txt" || return
  install -m644 "$srcdir/smoke.cpp" "$srcdir/smoke.vert" "$srcdir/smoke.frag" "$srcdir/smoke-source/" || return
  cmake -S "$srcdir/smoke-source" -B "$srcdir/smoke-build" -G Ninja \
    -DQT612_BUILD_TREE="$srcdir/build" || return
  cmake --build "$srcdir/smoke-build" --parallel "$MAX_JOBS" || return
  export LD_LIBRARY_PATH="$srcdir/build/lib"
  timeout 10 "$qsb" --version > "$srcdir/smoke-output/qsb-version.txt" || return
  timeout 10 "$qsb" -b --qt6 \
    -o "$srcdir/smoke-output/vertex.qsb" "$srcdir/smoke-source/smoke.vert" || return
  timeout 10 "$qsb" --qt6 \
    -o "$srcdir/smoke-output/fragment.qsb" "$srcdir/smoke-source/smoke.frag" || return
  for stage in vertex fragment; do
    timeout 10 "$qsb" -x reflect -o "$srcdir/smoke-output/$stage.json" "$srcdir/smoke-output/$stage.qsb" || return
    timeout 10 "$qsb" -x spirv,100 -o "$srcdir/smoke-output/$stage.spv" "$srcdir/smoke-output/$stage.qsb" || return
    timeout 10 "$qsb" -x glsl,150 -o "$srcdir/smoke-output/$stage.glsl" "$srcdir/smoke-output/$stage.qsb" || return
    timeout 10 "$qsb" -x hlsl,50 -o "$srcdir/smoke-output/$stage.hlsl" "$srcdir/smoke-output/$stage.qsb" || return
    timeout 10 "$qsb" -x msl,12 -o "$srcdir/smoke-output/$stage.msl" "$srcdir/smoke-output/$stage.qsb" || return
  done
  python "$srcdir/reflection.py" --directory "$srcdir/smoke-output" > "$srcdir/shader-smoke.json" || return
  timeout 60 "$srcdir/smoke-build/qt612-shader-api" "$srcdir/smoke-source/smoke.vert" \
    "$srcdir/smoke-source/smoke.frag" "$srcdir/smoke-output/vertex.qsb" "$srcdir/smoke-output/fragment.qsb" || return
  printf '%s\n' 'PASS_QT612_FAMILY_CHECK_SHADERTOOLS'
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build" || return
  python "$srcdir/source.py" install-notices --root "$srcdir/qtshadertools-everywhere-src-$pkgver" \
    --policy "$srcdir/source-notices.json" --stage "$pkgdir" || return
  install -Dm644 "$srcdir/LICENSE.packaging" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.packaging" || return
  install -Dm644 "$srcdir/LICENSE.third-party" "$pkgdir/usr/share/licenses/$pkgname/LicenseRef-Qt-ThirdParty.txt" || return
  install -Dm644 "$srcdir/source-notices.json" "$pkgdir/usr/share/licenses/$pkgname/source-notices.json" || return
  install -Dm644 "$srcdir/vendored-inputs.lock.json" "$pkgdir/usr/share/licenses/$pkgname/vendored-inputs.lock.json" || return
  install -Dm644 "$srcdir/BUILD-CONTRACT.json" "$pkgdir/usr/share/licenses/$pkgname/BUILD-CONTRACT.json" || return
  python "$srcdir/check_stage.py" --root "$pkgdir" --contract "$srcdir/BUILD-CONTRACT.json" \
    --notices "$srcdir/source-notices.json" > "$srcdir/stage-contract.json" || return
}
