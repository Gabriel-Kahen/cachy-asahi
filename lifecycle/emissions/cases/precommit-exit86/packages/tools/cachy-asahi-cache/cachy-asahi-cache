def main(argv=None):
    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('--version',action='version',version='cachy-asahi-cache '+VERSION)
    commands=parser.add_subparsers(dest='command',required=True)
    for name in ('list','plan'):
        command=commands.add_parser(name);command.add_argument('--cache',type=Path,default=Path('/var/cache/pacman/pkg'));command.add_argument('--dbpath',type=Path,default=Path('/var/lib/pacman'))
        command.add_argument('--protect',type=Path,required=name=='plan')
        if name=='plan':
            command.add_argument('--select',action='append',default=[]);command.add_argument('--output',type=Path,required=True);command.add_argument('--root',type=Path,default=Path('/'))
    for name in ('verify','apply'):
        command=commands.add_parser(name,help='verify a read-only plan' if name=='verify' else 'apply exact confirmed plan under real ALPM lock')
        command.add_argument('plan',type=Path)
        if name=='apply':
            command.add_argument('--confirm',choices=['REMOVE_SELECTED_CACHE_ARCHIVES'],required=True)
            command.add_argument('--plan-sha256',required=True);command.add_argument('--quarantine',type=Path,required=True)
    args=parser.parse_args(argv)
    try:
        if args.command=='list':
