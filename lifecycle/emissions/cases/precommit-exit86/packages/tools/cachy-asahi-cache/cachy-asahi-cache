            result=apply(absolute(args.plan),args.plan_sha256,absolute(args.quarantine))
            print(json.dumps(result,sort_keys=True));return 0 if result['status']=='APPLIED' else 1
        print(json.dumps(result,sort_keys=True));return 0
    except (Refused,OSError,ValueError,TypeError,KeyError,RecursionError) as error:
        print(json.dumps(dict(status='NOT_APPLIED',verification='REFUSED',reason=str(error)[:300],apply_supported=True),sort_keys=True));return 1


