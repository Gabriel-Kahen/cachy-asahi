                    need((os.fstat(fd).st_dev,os.fstat(fd).st_ino,stat.S_IMODE(os.fstat(fd).st_mode),os.fstat(fd).st_uid)==(qinfo.st_dev,qinfo.st_ino,0o700,os.geteuid()),'quarantine replaced or unsafe')
                    journal.fd=fd;journal.value['phase']='REFUSED_OR_INTERRUPTED';journal.value['error']=result['reason'];journal.value['lock_release']=result['lock'];journal.save()
