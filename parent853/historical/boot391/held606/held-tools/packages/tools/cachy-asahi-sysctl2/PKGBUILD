check() {
    python -B -Werror::ResourceWarning "$srcdir/test_sysctl.py"
}

package() {
    install -Dm755 "$srcdir/cachy-asahi-sysctl" "$pkgdir/usr/bin/cachy-asahi-sysctl"
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$srcdir/source-provenance.json" "$pkgdir/usr/share/doc/$pkgname/source-provenance.json"
    install -Dm644 "$srcdir/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
