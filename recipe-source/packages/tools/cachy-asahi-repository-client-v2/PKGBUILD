check() {
    python -I -B "$srcdir/check_source.py" --recipe-root "$startdir"
    python -I -B "$srcdir/test_runtime.py" --recipe-root "$startdir"
}

package() {
    [[ -n $pkgdir && $pkgdir != / ]] || return 1
    install -Dm644 "$srcdir/client_v2.py" "$pkgdir/usr/share/cachy-asahi/repository-runtime/scripts/client/client_v2.py" || return
    local file
    for file in README.md source-provenance.json helper-pins.json; do
        install -Dm644 "$srcdir/$file" "$pkgdir/usr/share/doc/$pkgname/$file" || return
    done
    for file in NOTICE LICENSE; do
        install -Dm644 "$srcdir/$file" "$pkgdir/usr/share/licenses/$pkgname/$file" || return
    done
}
