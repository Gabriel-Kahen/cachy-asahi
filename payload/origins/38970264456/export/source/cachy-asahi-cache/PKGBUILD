pkgname=cachy-asahi-cache
pkgver=0.2.0
pkgrel=1
pkgdesc='Protected selected package cache cleanup with real ALPM exclusion and quarantine'
arch=('any')
url='https://github.com/Gabriel-Kahen/cachy-asahi'
license=('MIT')
depends=('python>=3.11' 'pacman')
source=('cachy-asahi-cache' 'test_cache.py' 'README.md' 'NOTICE' 'LICENSE')
sha256sums=(
  '841e126d68656639175b07ccb39b8061e9eebd72862a2b8dd62301dda2ec6013'
  '6cf944285848c0d1fcb52aff8ef92d5d31ef3aa4fedbbace94daaccf1eb92033'
  'e9bcd08a9478d28eecb24a19dd6296c719ab10130570f017c8c291f7dfe911af'
  '202fdd819c9e47bac1cbf804c98709b81c790ef4771af5c45018f8f944209485'
  '51a352b3e94757560538ca5866bef929de5ec4864e5893fc635f291f7a5926c7'
)

check() {
    python -B "$srcdir/test_cache.py"
    python -B "$srcdir/cachy-asahi-cache" --help >/dev/null
}

package() {
    install -Dm755 "$srcdir/cachy-asahi-cache" "$pkgdir/usr/bin/cachy-asahi-cache"
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$srcdir/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
