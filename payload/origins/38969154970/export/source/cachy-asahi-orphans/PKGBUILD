check() {
    python -B "$srcdir/test_orphans.py"
    python -B "$srcdir/cachy-asahi-orphans" --help >/dev/null
}

package() {
    install -Dm755 "$srcdir/cachy-asahi-orphans" "$pkgdir/usr/bin/cachy-asahi-orphans"
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$srcdir/protection-floor.json" "$pkgdir/usr/share/$pkgname/protection-floor.json"
    install -Dm644 "$srcdir/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
