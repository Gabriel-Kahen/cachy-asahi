# SPDX-License-Identifier: MIT
# Experimental private prefix; never provides/conflicts with/replaces system zlib.
pkgname=cachy-asahi-zlib-lto
pkgver=1.3.2
pkgrel=1
pkgdesc='Unselected ARM-C01 lto zlib experiment with a finite installed probe'
arch=('aarch64')
url='https://zlib.net/'
license=('Zlib' 'MIT')
depends=('glibc')
makedepends=('gcc' 'binutils' 'make')
options=('staticlibs' '!buildflags' '!strip' '!debug' '!lto')
source=('https://zlib.net/zlib-1.3.2.tar.gz' 'probe.c' 'strict-gzip.c' 'LICENSE.project')
sha256sums=('bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16'
  'b85bab88cdb9048f26d5e812cc1ad2b8c783292882cbe3ab804e54353e4dfee1'
  '369e4e0e3f7c79b5d892edf7476ade41d6647332fb78f95ad7de7d8449bbaca9'
  '51a352b3e94757560538ca5866bef929de5ec4864e5893fc635f291f7a5926c7')
_variant=lto
_prefix=/usr/lib/cachy-asahi/experiments/zlib-lto

prepare() {
  [[ $CARCH == aarch64 && $(uname -m) == aarch64 ]] || return 2
}

build() {
  cd "$srcdir/zlib-1.3.2" || return
  export CC=gcc AR=gcc-ar RANLIB=gcc-ranlib CPPFLAGS='' MAKEFLAGS='-j2' QEMU_RUN=''
  export CFLAGS='-O2 -g -march=armv8-a -mtune=generic -fstack-protector-strong -D_FORTIFY_SOURCE=2 -fPIE -frandom-seed=$@ -flto=2 -Werror=lto-type-mismatch'
  export LDFLAGS='-pie -Wl,-z,relro,-z,now,-z,max-page-size=65536,-z,common-page-size=16384 -flto=2'
  export LC_ALL=C LANG=C TZ=UTC SOURCE_DATE_EPOCH=1791748800
  ./configure --static --prefix="$_prefix" || return
  make -j2 static || return
  # Direct GCC invocations expand the same target-specific random seed explicitly.
  local name
  for name in probe strict-gzip; do
    gcc ${CFLAGS//\$@/$name.o} -I. \
      -DEXPERIMENT_VARIANT=\"$_variant\" -DEXPERIMENT_PREFIX=\"$_prefix\" \
      -c "$srcdir/$name.c" -o "$name.o" || return
    gcc "$name.o" ./libz.a -o "$name" $LDFLAGS || return
  done
}

check() {
  cd "$srcdir/zlib-1.3.2" || return
  make -j2 teststatic || return
  ./probe --build-check || return
  # Full gzip rejection/cross-decoder workload runs separately after installation.
  printf '%s' 'cachy-asahi finite gzip check' | ./minigzip -6 > smoke.gz || return
  ./strict-gzip < smoke.gz > smoke.decoded || return
  printf '%s' 'cachy-asahi finite gzip check' | cmp - smoke.decoded || return
}

package() {
  local target="$pkgdir$_prefix" name
  install -d "$target/bin" "$target/lib" "$target/include" "$target/source" "$target/build" || return
  for name in minigzip probe strict-gzip; do
    install -m755 "$srcdir/zlib-1.3.2/$name" "$target/bin/$name" || return
  done
  install -m644 "$srcdir/zlib-1.3.2/libz.a" "$target/lib/libz.a" || return
  install -m644 "$srcdir/zlib-1.3.2/"{zlib.h,zconf.h} "$target/include/" || return
  install -m644 "$srcdir/zlib-1.3.2/Makefile" "$target/build/" || return
  install -m644 "$srcdir/zlib-1.3.2.tar.gz" "$target/source/" || return
  install -m644 "$srcdir/"{probe.c,strict-gzip.c,LICENSE.project} "$target/source/" || return
  install -m644 "$startdir/PKGBUILD" "$target/source/PKGBUILD" || return
  install -Dm644 "$srcdir/zlib-1.3.2/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.zlib" || return
  install -m644 "$srcdir/LICENSE.project" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.project" || return
}
