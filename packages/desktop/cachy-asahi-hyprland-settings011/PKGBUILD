check() {
    python -c 'import pathlib,sys; compile(pathlib.Path(sys.argv[1]).read_bytes(), sys.argv[1], "exec")' "$srcdir/cachy-asahi-screenshot" || return
    luac -p "$srcdir/hyprland.lua" || return
    python -m json.tool "$srcdir/waybar.json" >/dev/null || return
    python -I -B -Werror::ResourceWarning "$srcdir/test_settings.py" || return
    python -I -B -Werror::ResourceWarning "$srcdir/test_package.py" --recipe-root "$startdir"
}

package() {
    [[ -n ${pkgdir:-} && $pkgdir != / ]] || return 1
    local name
    install -Dm755 "$srcdir/cachy-asahi-screenshot" "$pkgdir/usr/bin/cachy-asahi-screenshot" || return
    for name in hyprland.lua waybar.json waybar.css mako.conf; do
        install -Dm644 "$srcdir/$name" "$pkgdir/usr/share/cachy-asahi/hyprland/$name" || return
    done
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md" || return
    install -Dm644 "$srcdir/source-provenance.json" "$pkgdir/usr/share/doc/$pkgname/source-provenance.json" || return
    install -Dm644 "$srcdir/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE" || return
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE" || return
}
