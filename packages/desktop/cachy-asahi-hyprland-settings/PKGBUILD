pkgname=cachy-asahi-hyprland-settings
pkgver=0.1.0
pkgrel=2
pkgdesc='Opt-in Hyprland Lua configuration preserving the existing Asahi platform'
arch=('any')
url='https://github.com/Gabriel-Kahen/cachy-asahi'
license=('MIT')
depends=('hyprland>=0.56.2' 'hyprland<0.57.0' 'alacritty' 'wofi' 'swaylock' 'wireplumber' 'brightnessctl' 'python')
makedepends=('lua' 'python')
optdepends=('waybar: optional status bar template'
            'mako: optional notification template'
            'noto-fonts: readable sans-serif text'
            'xdg-desktop-portal-hyprland: base-session screencast integration'
            'xdg-desktop-portal-gtk: base-session file chooser integration'
            'hyprpolkitagent: authorization agent if absent from the base session'
            'grim: optional explicit screenshot-to-file capture'
            'slurp: optional screenshot region selection')
source=('hyprland.lua' 'waybar.json' 'waybar.css' 'mako.conf' 'README.md' 'NOTICE' 'LICENSE' 'cachy-asahi-screenshot')
sha256sums=('f75aebb1111123dc86c7f1a85e00bff0320edef6e6f071e28370fbabd6a40a6a'
            '4c7adb2deb0403fefc4562d39105635cebfc44ce88e44fe84c4a90a00b2be3c0'
            'a97930965a4e622adc920491c7d433a803173bb6e644c4c3c88efb79187e11d5'
            'c6ab55ae475611bf2df2b7120b97a924eed5d65c149561d4da4f12b5b8c25504'
            '68fe115241e834594d8c43330b0564c4171e21f5c039dbd48f72ad27b8fbb17c'
            '0c8c331ce87a95b154e0e83c358a5cafc39bf08f2129ecc5be2438c6a97a325c'
            '51a352b3e94757560538ca5866bef929de5ec4864e5893fc635f291f7a5926c7'
            '5a920a5dd7a40463417a9b15e64a6620acfe7b2328960bf7014c9f587c4b69a8')

check() {
    python -c 'import pathlib,sys; compile(pathlib.Path(sys.argv[1]).read_bytes(), sys.argv[1], "exec")' "$srcdir/cachy-asahi-screenshot"
    luac -p "$srcdir/hyprland.lua"
    python -m json.tool "$srcdir/waybar.json" >/dev/null
}

package() {
    local name
    install -Dm755 "$srcdir/cachy-asahi-screenshot" "$pkgdir/usr/bin/cachy-asahi-screenshot"
    for name in hyprland.lua waybar.json waybar.css mako.conf; do
        install -Dm644 "$srcdir/$name" "$pkgdir/usr/share/cachy-asahi/hyprland/$name"
    done
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$srcdir/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
