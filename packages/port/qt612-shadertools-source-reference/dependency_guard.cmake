# Exact normal GUI-server provider; no Qt6.11 host fallback or version waiver.
if(QT_NO_PACKAGE_VERSION_CHECK)
    message(FATAL_ERROR "Normal Qt version checks cannot be disabled")
endif()
set(CMAKE_FIND_USE_PACKAGE_REGISTRY OFF)
set(CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY OFF)
set(Qt6_DIR /usr/lib/cmake/Qt6 CACHE PATH "" FORCE)
foreach(module IN ITEMS Core Gui)
    set(Qt6${module}_DIR "/usr/lib/cmake/Qt6${module}" CACHE PATH "" FORCE)
    find_package(Qt6${module} 6.12.0 EXACT CONFIG REQUIRED PATHS "/usr/lib/cmake/Qt6${module}" NO_DEFAULT_PATH)
    get_target_property(version Qt6::${module} _qt_package_version)
    get_target_property(configurations Qt6::${module} IMPORTED_CONFIGURATIONS)
    if(NOT version STREQUAL "6.12.0" OR NOT configurations)
        message(FATAL_ERROR "Exact normal Qt6.12 imported metadata required")
    endif()
    foreach(configuration IN LISTS configurations)
        string(TOUPPER "${configuration}" configuration)
        get_target_property(location Qt6::${module} IMPORTED_LOCATION_${configuration})
        if(NOT location STREQUAL "/usr/lib/libQt6${module}.so.6.12.0" OR NOT EXISTS "${location}")
            message(FATAL_ERROR "Missing/foreign selected Qt dependency: ${module}")
        endif()
    endforeach()
endforeach()
find_package(Qt6BuildInternals 6.12.0 EXACT CONFIG REQUIRED PATHS /usr/lib/cmake/Qt6BuildInternals NO_DEFAULT_PATH)
if(NOT TARGET Qt6::CorePrivate OR NOT TARGET Qt6::GuiPrivate)
    message(FATAL_ERROR "Matching Qt Core/Gui private ABI required")
endif()
foreach(feature IN ITEMS process commandlineparser temporaryfile thread)
    if(NOT QT_FEATURE_${feature})
        message(FATAL_ERROR "Required tool/base feature missing: ${feature}")
    endif()
endforeach()
if(CMAKE_CROSSCOMPILING)
    message(FATAL_ERROR "This finite candidate describes a native build, not a host-tool cross build")
endif()
