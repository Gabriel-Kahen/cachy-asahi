{
  "bindir": "bin",
  "buildtype": "release",
  "libdir": "lib",
  "libexecdir": "lib",
  "localstatedir": "/var",
  "options": {
    "b_lto": false,
    "bluez5_dun": false,
    "bpf-compiler": "clang",
    "clat": true,
    "concheck": true,
    "config_auth_polkit_default": "default",
    "config_dhcp_default": "internal",
    "config_dns_rc_manager_default": "symlink",
    "config_logging_backend_default": "journal",
    "config_plugins_default": "keyfile",
    "config_wifi_backend_default": "wpa_supplicant",
    "dbus_conf_dir": "/usr/share/dbus-1/system.d",
    "dhcpcd": "/usr/bin/dhcpcd",
    "dist_version": "1.58.1-2.1",
    "dnsmasq": "/usr/bin/dnsmasq",
    "docs": true,
    "ebpf": "true",
    "firewalld_zone": true,
    "ifcfg_rh": false,
    "ifupdown": "false",
    "introspection": true,
    "ip6tables": "/usr/bin/ip6tables",
    "iptables": "/usr/bin/iptables",
    "iwd": true,
    "kernel_firmware_dir": "/usr/lib/firmware",
    "libaudit": "yes",
    "libpsl": true,
    "man": true,
    "modem_manager": true,
    "modprobe": "/usr/bin/modprobe",
    "more_asserts": "no",
    "more_logging": false,
    "nbft": true,
    "netconfig": "no",
    "nft": "/usr/bin/nft",
    "nm_cloud_setup": true,
    "nmcli": true,
    "nmtui": true,
    "ovs": true,
    "polkit": true,
    "polkit_noauth_group": "",
    "ppp": true,
    "qt": "false",
    "readline": "libreadline",
    "resolvconf": "/usr/bin/resolvconf",
    "runtime_dir": "/run",
    "selinux": false,
    "session_tracking": "systemd",
    "session_tracking_consolekit": false,
    "suspend_resume": "systemd",
    "system_ca_path": "/etc/ssl/certs",
    "systemd_journal": true,
    "systemdsystemgeneratordir": "/usr/lib/systemd/system-generators",
    "systemdsystemunitdir": "/usr/lib/systemd/system",
    "teamdctl": true,
    "tests": "yes",
    "udev_dir": "/usr/lib/udev",
    "vapi": "true",
    "wifi": true
  },
  "package_version": "1.58.1-2.1",
  "prefix": "/usr",
  "sbindir": "bin",
  "schema_version": 1,
  "sysconfdir": "/etc"
}
