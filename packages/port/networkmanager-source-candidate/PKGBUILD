checkdepends=('libx11' 'python-dbus' 'dbus')
options=('!lto' '!debug')
source=('https://gitlab.freedesktop.org/NetworkManager/NetworkManager/-/archive/7406dfbcc35beed79bf2734e3e7376ead320bd99/NetworkManager-7406dfbcc35beed79bf2734e3e7376ead320bd99.tar.gz'
 'COPYING' 'COPYING.LGPL' 'COPYING.GFDL' 'LICENSE' 'feature-options.json'
