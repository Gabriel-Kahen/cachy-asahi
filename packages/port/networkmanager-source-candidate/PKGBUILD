prepare() {
  cd "$srcdir/NetworkManager-7406dfbcc35beed79bf2734e3e7376ead320bd99"
  patch --batch --forward -p1 < "$srcdir/glib-test-temporary.patch"
}

build() {
  local flags
  mapfile -d '' -t flags < <(python3 -I "$srcdir/check_profile.py" --flags)
  python3 -I "$srcdir/check_profile.py" --source "$srcdir/NetworkManager-7406dfbcc35beed79bf2734e3e7376ead320bd99"
  meson setup --wrap-mode=nodownload "${flags[@]}" "$srcdir/NetworkManager-7406dfbcc35beed79bf2734e3e7376ead320bd99" "$srcdir/build"
  python3 -I "$srcdir/check_profile.py" --build "$srcdir/build"
  meson compile -C "$srcdir/build" -j2
}

check() {
  python3 -I "$srcdir/check_profile.py" --build "$srcdir/build"
  dbus-run-session -- meson test -C "$srcdir/build" --num-processes 2 --print-errorlogs
}

_stage() {
  python3 -I "$srcdir/check_profile.py" --build "$srcdir/build"
  if [[ ! -e "$srcdir/_split/ownership.json" ]]; then
    python3 -I "$srcdir/check_profile.py" --build "$srcdir/build"
    meson install -C "$srcdir/build" --no-rebuild --destdir "$srcdir/_stage"
    install -Dm644 "$srcdir/NetworkManager.conf" "$srcdir/_stage/etc/NetworkManager/NetworkManager.conf"
    install -Dm644 "$srcdir/20-connectivity.conf" "$srcdir/_stage/usr/lib/NetworkManager/conf.d/20-connectivity.conf"
    chmod 700 "$srcdir/_stage/etc/NetworkManager/system-connections"
    python3 -I "$srcdir/partition.py" --stage "$srcdir/_stage" --output "$srcdir/_split"
  fi
  python3 -I "$srcdir/partition.py" --verify --output "$srcdir/_split"
}

_payload() {
  _stage
  cp -a "$srcdir/_split/$pkgname/." "$pkgdir/"
  for notice in COPYING COPYING.LGPL COPYING.GFDL LICENSE; do
    install -Dm644 "$srcdir/$notice" "$pkgdir/usr/share/licenses/$pkgname/$notice"
  done
  install -Dm644 "$srcdir/source-provenance.json" "$pkgdir/usr/share/doc/$pkgname/source-provenance.json"
}

package_networkmanager() {
  depends=('audit' 'bash' 'curl' 'glib2' 'glibc' 'iproute2' 'jansson' 'libbpf'
   'libgcc' 'libmm-glib' 'libndp' 'libnewt' 'libnm=1.58.1-2.1' 'libpsl'
   'libteam' 'mobile-broadband-provider-info' 'nspr' 'nss' 'readline' 'slang'
   'systemd-libs' 'wpa_supplicant')
  optdepends=('bluez: Bluetooth' 'dhcpcd: alternative DHCP' 'dnsmasq: connection sharing'
   'firewalld: firewall integration' 'iptables: connection sharing' 'iwd: alternative Wi-Fi backend'
   'libnvme: NBFT data' 'modemmanager: cellular' 'nftables: connection sharing'
   'openresolv: alternative resolver manager' 'pacrunner: PAC' 'polkit: non-root authorization' 'ppp: PPP/PPPoE')
  backup=('etc/NetworkManager/NetworkManager.conf')
  _payload
}

package_libnm() {
  pkgdesc='NetworkManager client library and bindings (source candidate)'
  depends=('glib2' 'glibc' 'libgcc' 'nspr' 'nss' 'systemd-libs' 'util-linux-libs')
  provides=('libnm.so')
  _payload
}

package_nm-cloud-setup() {
  pkgdesc='Optional NetworkManager cloud configuration (source candidate)'
  depends=('bash' 'curl' 'glib2' 'glibc' 'jansson' 'libgcc' 'libnm=1.58.1-2.1' 'networkmanager=1.58.1-2.1')
  _payload
}

package_networkmanager-docs() {
  pkgdesc='NetworkManager API documentation and inert OVS unit example'
  license+=('GFDL-1.1-or-later')
  _payload
}
