url='https://networkmanager.dev/'
license=('LGPL-2.1-or-later' 'GPL-2.0-or-later' 'MIT')
makedepends=('base-devel' 'meson' 'ninja' 'python' 'audit' 'bpf' 'clang' 'curl'
