# SPDX-License-Identifier: MIT
# Finite x86_64 software probe only, not a native ARM/Asahi image.
FROM docker.io/library/archlinux:base@sha256:fcee73ea1b96e236248f53a213f71276cc9072d9025b58bce9915e32f19963ae
RUN --mount=type=cache,id=cachy-asahi-nm-prereqs-20261114,target=/var/cache/pacman/pkg,sharing=locked curl --fail --silent --show-error --max-time 60 https://archive.archlinux.org/repos/2026/11/09/core/os/x86_64/core.db -o /tmp/core.db \
 && curl --fail --silent --show-error --max-time 60 https://archive.archlinux.org/repos/2026/11/09/extra/os/x86_64/extra.db -o /tmp/extra.db \
 && printf '%s\n' 'aec62efbfb59d300204f936a633a59d3c89d6a7e7f94852b8f621b61a253afae  /tmp/core.db' '1b4caf18e4a57ba10f201c7b19892bb55a37283c2b0369b39cc6c4f6b654151d  /tmp/extra.db' | sha256sum --check --strict \
 && printf '%s\n' '[options]' 'Architecture = x86_64' 'SigLevel = Required DatabaseOptional' 'DownloadUser = alpm' 'DisableSandboxFilesystem' '[core]' 'Server = https://archive.archlinux.org/repos/2026/11/09/$repo/os/$arch' '[extra]' 'Server = https://archive.archlinux.org/repos/2026/11/09/$repo/os/$arch' > /tmp/candidate-pacman.conf \
 && install -Dm644 /tmp/core.db /var/lib/pacman/sync/core.db \
 && install -Dm644 /tmp/extra.db /var/lib/pacman/sync/extra.db \
 && timeout --kill-after=10s 600s pacman --config /tmp/candidate-pacman.conf --disable-download-timeout --noconfirm -S --needed \
    base-devel meson ninja python gnu-free-fonts audit bpf clang curl dhcpcd dnsmasq glib2 glib2-devel \
    gobject-introspection gtk-doc iproute2 iptables iwd jansson libbpf libgcc libmm-glib \
    libndp libnewt libnvme libpsl libteam modemmanager nftables nspr nss openresolv \
    pacrunner perl-yaml polkit ppp python-gobject readline slang systemd systemd-libs \
    vala wpa_supplicant libx11 python-dbus dbus \
 && pacman --config /tmp/candidate-pacman.conf -Q > /opt/host-package-versions.txt \
 && useradd --uid 1000 --no-create-home --home-dir /work/home builder \
 && install -d -o 1000 -g 1000 -m700 /work
COPY input/ /opt/input/
RUN find /opt/input -type f -exec chmod 0444 {} + \
 && find /opt/input -type d -exec chmod 0555 {} +
USER 1000:1000
WORKDIR /work
ENTRYPOINT ["/usr/bin/python3", "-I", "-B", "/opt/input/host_probe.py"]
