# Source candidate only. Frozen GUI18 server-OFF cannot satisfy the full profile.
pkgname=cachy-asahi-qt612-wayland-source-reference
pkgver=6.12.0
pkgrel=1
pkgdesc='Qt6.12 client extensions and full Quick/QML compositor source candidate'
arch=('aarch64')
url='https://code.qt.io/cgit/qt/qtwayland.git/'
license=('GPL-3.0-only' 'LGPL-3.0-only' 'BSD-3-Clause' 'MIT' 'Qt-GPL-exception-1.0')
depends=('glibc' 'libgcc' 'libstdc++' 'qt6-base=6.12.0' 'qt6-declarative=6.12.0'
         'qt6-svg=6.12.0' 'wayland>=1.15' 'libxkbcommon>=0.5.0' 'libdrm' 'libglvnd')
makedepends=('gcc' 'cmake>=3.25' 'ninja' 'pkgconf' 'python' 'perl')
provides=("qt6-wayland=$pkgver" 'libQt6WaylandCompositor.so.6'
          'libQt6WaylandEglCompositorHwIntegration.so.6'
          'libQt6WaylandCompositorXdgShell.so.6' 'libQt6WaylandCompositorIviapplication.so.6'
          'libQt6WaylandCompositorWLShell.so.6' 'libQt6WaylandCompositorPresentationTime.so.6')
conflicts=('qt6-wayland')
options=('!lto' '!debug' '!staticlibs')
PKGEXT='.pkg.tar.xz'
source=("https://download.qt.io/archive/qt/6.12/$pkgver/submodules/qtwayland-everywhere-src-$pkgver.tar.xz"
        'configure.cmake' 'dependency_guard.cmake' 'source.py' 'check_stage.py'
        'source-notices.json' 'dependency-inputs.json' 'SmokeCMakeLists.txt' 'smoke.cpp' 'smoke.qml'
        'LICENSE.packaging' 'LICENSE.third-party')
sha256sums=('ae14d9bcf1bb3c300a3ab2e6a53f50284e5c6c966a4ac4cc5aedcb1bc74e4d02'
            '0f9ae5eb0c618cbe5a33a120b21b4135de390d16fdab46f2f340472fb9803cfc'
