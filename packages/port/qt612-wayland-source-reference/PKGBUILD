prepare() {
  python "$srcdir/source.py" verify --root "$srcdir/qtwayland-everywhere-src-$pkgver" \
    --policy "$srcdir/source-notices.json" || return
}

_qt_single_job() {
  if [[ "${MAX_JOBS-1}" != 1 || "${CMAKE_BUILD_PARALLEL_LEVEL-1}" != 1 ]]; then
    printf '%s\n' 'Qt612 serial experiment requires MAX_JOBS=1 and CMAKE_BUILD_PARALLEL_LEVEL=1' >&2
    return 1
  fi
  export MAX_JOBS=1 CMAKE_BUILD_PARALLEL_LEVEL=1
}

build() {
  _qt_single_job || return
  python "$srcdir/source.py" dependency-inputs --prefix /usr \
    --dependency-policy "$srcdir/dependency-inputs.json" || return
  cmake -C "$srcdir/configure.cmake" -S "$srcdir/qtwayland-everywhere-src-$pkgver" \
    -B "$srcdir/build" -G Ninja -DQT612_DEPENDENCY_PREFIX=/usr \
    -DCMAKE_PROJECT_QtWayland_INCLUDE="$srcdir/dependency_guard.cmake" || return
  python "$srcdir/source.py" configuration --build "$srcdir/build" \
    --profile "$srcdir/configure.cmake" || return
  cmake --build "$srcdir/build" --parallel "$MAX_JOBS" || return
}

check() {
  _qt_single_job || return
  install -d "$srcdir/smoke-source" "$srcdir/smoke-home" || return
  install -m644 "$srcdir/SmokeCMakeLists.txt" "$srcdir/smoke-source/CMakeLists.txt" || return
  install -m644 "$srcdir/smoke.cpp" "$srcdir/smoke.qml" "$srcdir/smoke-source/" || return
  cmake -S "$srcdir/smoke-source" -B "$srcdir/smoke-build" -G Ninja \
    -DQT612_BUILD_TREE="$srcdir/build" -DQT612_DEPENDENCY_PREFIX=/usr \
    -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF || return
  cmake --build "$srcdir/smoke-build" --parallel "$MAX_JOBS" || return
  HOME="$srcdir/smoke-home" QT_QPA_PLATFORM=offscreen QML_DISABLE_DISK_CACHE=1 \
    QT_PLUGIN_PATH="$srcdir/build/lib/qt6/plugins:/usr/lib/qt6/plugins" \
    QT_QPA_PLATFORM_PLUGIN_PATH=/usr/lib/qt6/plugins/platforms \
    LD_LIBRARY_PATH="$srcdir/build/lib" \
    timeout 60 "$srcdir/smoke-build/qt612-wayland-smoke" "$srcdir/smoke-source/smoke.qml" || return
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build" || return
  python "$srcdir/source.py" install-notices --root "$srcdir/qtwayland-everywhere-src-$pkgver" \
    --policy "$srcdir/source-notices.json" --stage "$pkgdir" || return
  python "$srcdir/source.py" install-dependency-notices --prefix /usr \
    --dependency-policy "$srcdir/dependency-inputs.json" --stage "$pkgdir" || return
  install -Dm644 "$srcdir/LICENSE.packaging" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.packaging" || return
  install -Dm644 "$srcdir/LICENSE.third-party" "$pkgdir/usr/share/licenses/$pkgname/LicenseRef-Qt-ThirdParty.txt" || return
  install -Dm644 "$srcdir/source-notices.json" "$pkgdir/usr/share/licenses/$pkgname/source-notices.json" || return
  install -Dm644 "$srcdir/dependency-inputs.json" "$pkgdir/usr/share/licenses/$pkgname/dependency-inputs.json" || return
  python "$srcdir/check_stage.py" --root "$pkgdir" --license-manifest "$srcdir/source-notices.json" \
    --dependency-policy "$srcdir/dependency-inputs.json" > "$srcdir/stage-contract.json" || return
}
