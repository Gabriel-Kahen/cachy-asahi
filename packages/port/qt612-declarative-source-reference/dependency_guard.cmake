# Loaded after project(QtDeclarative), before any module compilation.
if(QT_NO_PACKAGE_VERSION_CHECK)
    message(FATAL_ERROR "Normal Qt version checks cannot be disabled")
endif()
set(CMAKE_FIND_USE_PACKAGE_REGISTRY OFF)
set(CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY OFF)
foreach(module IN ITEMS Core Gui Network Widgets OpenGL OpenGLWidgets Sql Concurrent Test DBus Svg ShaderTools)
    set(Qt6${module}_DIR "/usr/lib/cmake/Qt6${module}" CACHE PATH "" FORCE)
    find_package(Qt6${module} 6.12.0 EXACT CONFIG REQUIRED PATHS "/usr/lib/cmake/Qt6${module}" NO_DEFAULT_PATH)
    if(NOT TARGET Qt6::${module})
        message(FATAL_ERROR "Required matching Qt6.12 provider missing: ${module}")
    endif()
    get_target_property(version Qt6::${module} _qt_package_version)
    get_target_property(locations Qt6::${module} IMPORTED_CONFIGURATIONS)
    if(NOT version STREQUAL "6.12.0")
        message(FATAL_ERROR "Exact Qt6.12 imported API required")
    endif()
    if(NOT locations)
        message(FATAL_ERROR "Imported Qt provider configurations are missing: ${module}")
    endif()
    foreach(configuration IN LISTS locations)
        string(TOUPPER "${configuration}" configuration)
        get_target_property(location Qt6::${module} IMPORTED_LOCATION_${configuration})
        if(NOT location STREQUAL "/usr/lib/libQt6${module}.so.6.12.0" OR NOT EXISTS "${location}")
            message(FATAL_ERROR "Wrong selected provider location: ${module}")
        endif()
    endforeach()
endforeach()
find_package(Qt6BuildInternals 6.12.0 EXACT CONFIG REQUIRED PATHS /usr/lib/cmake/Qt6BuildInternals NO_DEFAULT_PATH)
find_package(Qt6ShaderToolsTools 6.12.0 EXACT CONFIG REQUIRED PATHS /usr/lib/cmake/Qt6ShaderToolsTools NO_DEFAULT_PATH)
if(NOT TARGET Qt6::qsb)
    message(FATAL_ERROR "qsb is required: upstream otherwise silently skips ALL Quick modules")
endif()
get_target_property(qsb Qt6::qsb IMPORTED_LOCATION)
if(NOT qsb)
    get_target_property(qsb Qt6::qsb IMPORTED_LOCATION_RELEASE)
endif()
if(NOT qsb STREQUAL "/usr/lib/qt6/bin/qsb" OR NOT EXISTS "${qsb}")
    message(FATAL_ERROR "Normal matching ShaderTools qsb must be delivered in /usr/lib/qt6/bin")
endif()
foreach(feature IN ITEMS wayland_server opengl egl movie thread systemsemaphore settings network ssl animation itemmodel future regularexpression commandlineparser temporaryfile)
    if(NOT QT_FEATURE_${feature})
        message(FATAL_ERROR "QtBase GUI-server prerequisite is disabled: ${feature}")
    endif()
endforeach()
