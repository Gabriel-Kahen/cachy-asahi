prepare() {
  python -I "$srcdir/reference.py" prepare --work "$srcdir" || return
}

build() {
  python -I "$srcdir/reference.py" build --work "$srcdir" || return
}

package() {
  python -I "$srcdir/reference.py" package --work "$srcdir" --destination "$pkgdir" || return
}
