prepare() {
  local patchfile
  for patchfile in CVE-2026-116337-qtbase-6.12-0002.diff \
                   CVE-2026-116337-qtbase-6.12-0001.diff \
                   CVE-2026-105924-qtbase-6.12.diff \
                   CVE-2026-105943-qtbase-6.12.diff; do
    patch --batch --forward --fuzz=0 -d "$srcdir/qtbase-everywhere-src-$pkgver" \
      -p1 -i "$srcdir/$patchfile" || return
  done
  python "$srcdir/source.py" verify --root "$srcdir/qtbase-everywhere-src-$pkgver" \
    --policy "$srcdir/source-notices.json" || return
}

build() {
  cmake -C "$srcdir/configure.cmake" -S "$srcdir/qtbase-everywhere-src-$pkgver" \
    -B "$srcdir/build" -G Ninja || return
  python "$srcdir/source.py" configuration --build "$srcdir/build" \
    --profile "$srcdir/configure.cmake" || return
  cmake --build "$srcdir/build" || return
}

check() {
  install -d "$srcdir/smoke-source" "$srcdir/smoke-home" || return
  install -m644 "$srcdir/SmokeCMakeLists.txt" "$srcdir/smoke-source/CMakeLists.txt" || return
  install -m644 "$srcdir/smoke.cpp" "$srcdir/smoke-source/smoke.cpp" || return
  cmake -S "$srcdir/smoke-source" -B "$srcdir/smoke-build" -G Ninja \
    -DQT612_BUILD_TREE="$srcdir/build" -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF || return
  cmake --build "$srcdir/smoke-build" || return
  HOME="$srcdir/smoke-home" QT_QPA_PLATFORM=offscreen \
    QT_PLUGIN_PATH="$srcdir/build/lib/qt6/plugins" \
    QT_QPA_PLATFORM_PLUGIN_PATH="$srcdir/build/lib/qt6/plugins/platforms" \
    LD_LIBRARY_PATH="$srcdir/build/lib" timeout 60 "$srcdir/smoke-build/qt612-smoke" || return
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build" || return
  python "$srcdir/source.py" install-notices --root "$srcdir/qtbase-everywhere-src-$pkgver" \
    --policy "$srcdir/source-notices.json" --stage "$pkgdir" || return
  install -Dm644 "$srcdir/LICENSE.packaging" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.packaging" || return
  install -Dm644 "$srcdir/LICENSE.third-party" \
    "$pkgdir/usr/share/licenses/$pkgname/LicenseRef-Qt-ThirdParty.txt" || return
  install -Dm644 "$srcdir/source-notices.json" \
    "$pkgdir/usr/share/licenses/$pkgname/source-notices.json" || return
  python "$srcdir/check_stage.py" --root "$pkgdir" \
    --license-manifest "$srcdir/source-notices.json" > "$srcdir/stage-contract.json" || return
}
