# Does not correspond to the unrecovered foreign qt6-base6.12.0-3 recipe.
pkgname=cachy-asahi-qt612-base-source-reference
pkgver=6.12.0
pkgrel=1
pkgdesc='Independent Qt6.12 XCB/offscreen source provider; TEST-only and unselected'
arch=('aarch64')
url='https://code.qt.io/cgit/qt/qtbase.git/'
license=('GPL-3.0-only' 'LGPL-3.0-only' 'Qt-GPL-exception-1.0' 'LicenseRef-Qt-ThirdParty')
depends=('brotli' 'dbus' 'double-conversion' 'fontconfig' 'freetype2' 'glib2'
         'glibc' 'harfbuzz' 'icu' 'libb2' 'libgcc' 'libgl' 'libice'
         'libjpeg-turbo' 'libpng' 'libsm' 'libstdc++' 'libx11' 'libxcb'
         'libxkbcommon' 'libxkbcommon-x11' 'md4c>=0.5.3' 'md4c<0.6' 'openssl'
         'pcre2' 'shared-mime-info' 'sqlite' 'xcb-util-cursor' 'xcb-util-image'
         'xcb-util-keysyms' 'xcb-util-renderutil' 'xcb-util-wm' 'xdg-utils' 'zlib' 'zstd')
makedepends=('gcc' 'cmake>=3.25' 'ninja' 'pkgconf' 'python' 'perl' 'patch')
provides=("qt6-base=$pkgver" 'libQt6Core.so.6')
conflicts=('qt6-base')
options=('!lto' '!debug' '!staticlibs')
PKGEXT='.pkg.tar.xz'
source=("https://download.qt.io/archive/qt/6.12/$pkgver/submodules/qtbase-everywhere-src-$pkgver.tar.xz"
        'configure.cmake'
        'source-notices.json'
        'source.py'
        'check_stage.py'
        'smoke.cpp'
        'SmokeCMakeLists.txt'
        'LICENSE.packaging'
        'LICENSE.third-party'
        'CVE-2026-116337-qtbase-6.12-0002.diff'
        'CVE-2026-116337-qtbase-6.12-0001.diff'
        'CVE-2026-105924-qtbase-6.12.diff'
        'CVE-2026-105943-qtbase-6.12.diff'
)
