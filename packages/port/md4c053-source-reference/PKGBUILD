# SPDX-License-Identifier: MIT
# Project-built source provider; never an authenticated ALARM binary replacement.
pkgname=md4c
pkgver=0.5.3
pkgrel=1
pkgdesc='CommonMark parser and HTML renderer (pinned source-reference provider)'
arch=('aarch64')
url='https://github.com/mity/md4c'
license=('MIT')
depends=('glibc')
makedepends=('cmake' 'ninja')
checkdepends=('python' 'pkgconf')
options=('!debug' '!lto')
PKGEXT='.pkg.tar.xz'
_commit=472c417005c2c71b8617de4f7b8d6b30411d78f4
source=("md4c-${_commit}.tar.gz::https://codeload.github.com/mity/md4c/tar.gz/${_commit}"
        'smoke.sh' 'smoke.c')
sha256sums=('ecbd85292465df929839897e314d809b5c8b267e20c4e5e24d51a1602d16d99a'
            'b9249cc75dbd96f85947046ffc4131925f0d760e4c2bb78073e8c2b04f1e819a' '4f0dbc190dd58841cfe0a892c8927dbeee682211f0e1c01f9f31e4730edb5d17')

build() {
  cmake -S "md4c-${_commit}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib -DBUILD_SHARED_LIBS=ON \
    -DBUILD_MD2HTML_EXECUTABLE=ON -DCMAKE_BUILD_RPATH_USE_ORIGIN=ON
  cmake --build build
}

check() {
  local suite
  for suite in spec regressions; do
    python "md4c-${_commit}/test/run-testsuite.py" \
      --program "$srcdir/build/md2html/md2html" \
      --spec "md4c-${_commit}/test/${suite}.txt"
  done
  DESTDIR="$srcdir/check-stage" cmake --install build
  bash "$srcdir/smoke.sh" "$srcdir/check-stage" "$srcdir/smoke-work"
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "md4c-${_commit}/LICENSE.md" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
}
