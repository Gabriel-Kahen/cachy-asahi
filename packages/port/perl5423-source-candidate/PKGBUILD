prepare() {
  [[ ${CACHY_ASAHI_PERL_BUILD:-} == 1 && $EUID != 0 ]] || return 2
  cd "$srcdir/$_tree" || return
  cmp README "$srcdir/UPSTREAM-README" && cmp Artistic "$srcdir/UPSTREAM-Artistic" && cmp Copying "$srcdir/UPSTREAM-Copying" || return
  patch -Np1 --batch --fuzz=0 < "$srcdir/568e6fd238867bb9e99fa3f47cba3169009239e0.patch" || return
  patch -Np1 --batch --fuzz=0 < "$srcdir/54cf3d44cbbedd17d774e9a37921963e8fd5d0cb.patch" || return
}

build() {
  cd "$srcdir/$_tree" || return
  export LC_ALL=C TZ=UTC
  export CFLAGS='-O2 -g -fstack-protector-strong -fno-plt'
  export CPPFLAGS='-D_FORTIFY_SOURCE=3'
  export LDFLAGS='-Wl,-O1,--sort-common,--as-needed,-z,relro,-z,now'
  export BUILD_ZLIB=0 BUILD_BZIP2=0
  export ZLIB_INCLUDE=/usr/include ZLIB_LIB=/usr/lib BZIP2_INCLUDE=/usr/include BZIP2_LIB=/usr/lib
  sh Configure -des -Dcc=gcc -Duseshrplib -Dusethreads -Duse64bitint \
    -Dprefix=/usr -Dvendorprefix=/usr -Dsiteprefix=/usr/local \
    -Dprivlib=/usr/share/perl5/core_perl -Darchlib=/usr/lib/perl5/5.42/core_perl \
    -Dvendorlib=/usr/share/perl5/vendor_perl -Dvendorarch=/usr/lib/perl5/5.42/vendor_perl \
    -Dsitelib=/usr/local/share/perl5/site_perl -Dsitearch=/usr/local/lib/perl5/5.42/site_perl \
    -Dscriptdir=/usr/bin/core_perl -Dvendorbin=/usr/bin/vendor_perl -Dvendorscript=/usr/bin/vendor_perl \
    -Dsitebin=/usr/local/bin -Dsitescript=/usr/local/bin -Dinc_version_list=none \
    -Dman1dir=/usr/share/man/man1 -Dman3dir=/usr/share/man/man3 -Dman1ext=1perl -Dman3ext=3perl \
    -Doptimize="$CFLAGS" -Dcppflags="$CPPFLAGS" \
    -Dldflags="$LDFLAGS -Wl,-rpath,/usr/lib/perl5/5.42/core_perl/CORE" \
    -Dlddlflags="-shared $LDFLAGS" -Dloclibpth='/usr/lib/db5.3 /usr/lib' -Dlocincpth='/usr/include/db5.3 /usr/include' || return
  make -j2 || return
}

check() {
  cd "$srcdir/$_tree" || return
  # Actual dynamic dependencies must establish the requested system-library composition.
  readelf -d lib/auto/Compress/Raw/Zlib/Zlib.so | grep -F '[libz.so.1]' || return
  readelf -d lib/auto/Compress/Raw/Bzip2/Bzip2.so | grep -F '[libbz2.so.1.0]' || return
  # No test exclusions or conversion of a failure into package credit.
  TEST_JOBS=2 make test_harness || return
  LD_LIBRARY_PATH="$PWD${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" ./perl -Ilib "$srcdir/check_config.pl" "$srcdir/provides.txt" || return
}

package() {
  [[ $pkgdir = /* && $pkgdir != / && $pkgdir != "$srcdir" && $pkgdir != "$startdir" ]] || return 2
  cd "$srcdir/$_tree" || return
  make DESTDIR="$pkgdir" install || return
  # Only empty staging directories are removed; local module files must never enter this package.
  if [[ -d $pkgdir/usr/local ]]; then
    find "$pkgdir/usr/local" -depth -type d -empty -delete || return
  fi
  rm -f "$pkgdir/usr/bin/perl$pkgver" || return
  # ALPM owns the payload; discard only upstream's package-local install ledger.
  find "$pkgdir/usr/lib/perl5/5.42/core_perl" -name .packlist -type f -delete || return
  python "$srcdir/stage_commands.py" --root "$pkgdir" || return
  install -Dm644 README "$pkgdir/usr/share/licenses/perl/README" || return
  install -Dm644 Artistic "$pkgdir/usr/share/licenses/perl/Artistic" || return
  install -Dm644 Copying "$pkgdir/usr/share/licenses/perl/Copying" || return
  install -Dm644 "$srcdir/LICENSE.packaging" "$pkgdir/usr/share/licenses/perl/LICENSE.packaging" || return
  # Retain named upstream component notices without copying the historical packaging scripts.
  while IFS= read -r -d '' notice; do
    install -Dm644 "$notice" "$pkgdir/usr/share/licenses/perl/upstream/${notice#./}" || return
  done < <(find . -type f \( -iname 'license*' -o -iname 'copying*' -o -iname 'artistic*' -o -iname 'notice*' \) -print0)
  python "$srcdir/check_stage.py" --root "$pkgdir" --arch "$CARCH" || return
}
