# SPDX-License-Identifier: MIT
# Both SVG modules/plugins stay enabled; imported Qtbase features are required.
set(CMAKE_BUILD_TYPE Release CACHE STRING "" FORCE)
set(CMAKE_AUTOGEN_PARALLEL 1 CACHE STRING "" FORCE)
set(CMAKE_INSTALL_PREFIX /usr CACHE STRING "" FORCE)
set(INSTALL_LIBDIR lib CACHE STRING "" FORCE)
set(INSTALL_ARCHDATADIR lib/qt6 CACHE STRING "" FORCE)
set(INSTALL_DATADIR share/qt6 CACHE STRING "" FORCE)
set(INSTALL_INCLUDEDIR include/qt6 CACHE STRING "" FORCE)
set(INSTALL_PLUGINDIR lib/qt6/plugins CACHE STRING "" FORCE)
set(INSTALL_LIBEXECDIR lib/qt6 CACHE STRING "" FORCE)
set(INSTALL_MKSPECSDIR lib/qt6/mkspecs CACHE STRING "" FORCE)
set(INSTALL_DOCDIR share/doc/qt6 CACHE STRING "" FORCE)
set(INSTALL_EXAMPLESDIR share/doc/qt6/examples CACHE STRING "" FORCE)
set(BUILD_SHARED_LIBS ON CACHE BOOL "" FORCE)
set(QT_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(QT_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(QT_BUILD_DOCS OFF CACHE BOOL "" FORCE)
set(QT_GENERATE_SBOM OFF CACHE BOOL "" FORCE)
set(CMAKE_FIND_USE_PACKAGE_REGISTRY OFF CACHE BOOL "" FORCE)
set(CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY OFF CACHE BOOL "" FORCE)
set(CMAKE_SHARED_LINKER_FLAGS_INIT -Wl,-z,max-page-size=16384 CACHE STRING "" FORCE)
set(CMAKE_MODULE_LINKER_FLAGS_INIT -Wl,-z,max-page-size=16384 CACHE STRING "" FORCE)
