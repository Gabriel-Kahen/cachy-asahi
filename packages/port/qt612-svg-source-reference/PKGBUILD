# Independent source candidate; no native build, official-recipe or M2 acceptance.
pkgname=cachy-asahi-qt612-svg-source-reference
pkgver=6.12.0
pkgrel=1
pkgdesc='Qt6.12 SVG and SVGWidgets source provider with both plugins; TEST-only'
arch=('aarch64')
url='https://code.qt.io/cgit/qt/qtsvg.git/'
license=('LGPL-3.0-only' 'GPL-2.0-only' 'GPL-3.0-only' 'HPND-sell-variant' 'LicenseRef-Qt-ThirdParty')
depends=('glibc' 'libgcc' 'libstdc++' 'qt6-base=6.12.0' 'zlib')
makedepends=('gcc' 'cmake>=3.25' 'ninja' 'pkgconf' 'python' 'perl')
provides=("qt6-svg=$pkgver" 'libQt6Svg.so.6' 'libQt6SvgWidgets.so.6')
conflicts=('qt6-svg')
options=('!lto' '!debug' '!staticlibs')
PKGEXT='.pkg.tar.xz'
source=("https://download.qt.io/archive/qt/6.12/$pkgver/submodules/qtsvg-everywhere-src-$pkgver.tar.xz"
        'configure.cmake' 'dependency_guard.cmake' 'source.py' 'check_stage.py'
        'source-notices.json' 'SmokeCMakeLists.txt' 'smoke.cpp'
        'LICENSE.packaging' 'LICENSE.third-party')
sha256sums=('e4ab39534ec97987b1b9b60ef7f4d3253d5912a69f8c713a01753174a4029331'
            'ee1b9c1f6093d0e1900fd26e16201f451c008622c57acd3d9882d248e7f267f0'
            '8ff94bcf6ece8851dbfaac5098de6b7f999563dd647089278f449ce35ed70610'
            '91373cd08bc00181604fe602a4319c0e838bd03e3113004fc6a6ae303a122132'
            'ac18d1a95b566a4d6d74a036b480cf12d648b83c50267b22e71c54b217269e42'
            '1452679ddb40231057ffe49771df2a48b241a36e5e29ed8cb36e4a6cf68d726c'
            '6576e985825d50ad7bc371193cca28fa2524e22d90638b2de29b224daff7df17'
            '850385b09c953f24a17bf95f5ae32b4aa066a7318c55a1713505c8418c170285'
            '67fe503b5c407bca1c340e14fb7ceb6849b1af4d531a783b30d09cb76e65a3aa'
            '12c0559d5673b2e983a0c757abeed72c51cfe27dab1a851b7cd1b38f93d71ddd')

prepare() {
  python "$srcdir/source.py" verify --root "$srcdir/qtsvg-everywhere-src-$pkgver" \
    --policy "$srcdir/source-notices.json" || return
}

_qt_single_job() {
  if [[ "${MAX_JOBS-1}" != 1 || "${CMAKE_BUILD_PARALLEL_LEVEL-1}" != 1 ]]; then
    printf '%s\n' 'QtSVG612 serial build requires MAX_JOBS=1 and CMAKE_BUILD_PARALLEL_LEVEL=1' >&2
    return 1
  fi
  export MAX_JOBS=1 CMAKE_BUILD_PARALLEL_LEVEL=1
}

build() {
  _qt_single_job || return
  python "$srcdir/source.py" dependencies --prefix /usr || return
  cmake -C "$srcdir/configure.cmake" -S "$srcdir/qtsvg-everywhere-src-$pkgver" \
    -B "$srcdir/build" -G Ninja -DQT612_DEPENDENCY_PREFIX=/usr \
    -DCMAKE_PROJECT_QtSvg_INCLUDE="$srcdir/dependency_guard.cmake" || return
  python "$srcdir/source.py" configuration --build "$srcdir/build" --profile "$srcdir/configure.cmake" || return
  python "$srcdir/source.py" targets --build "$srcdir/build" || return
  cmake --build "$srcdir/build" --parallel "$MAX_JOBS" || return
}

check() {
  _qt_single_job || return
  python "$srcdir/source.py" dependencies --prefix /usr || return
  install -d "$srcdir/smoke-source" "$srcdir/smoke-home" || return
  install -m644 "$srcdir/SmokeCMakeLists.txt" "$srcdir/smoke-source/CMakeLists.txt" || return
  install -m644 "$srcdir/smoke.cpp" "$srcdir/smoke-source/smoke.cpp" || return
  cmake -S "$srcdir/smoke-source" -B "$srcdir/smoke-build" -G Ninja \
    -DQT612_BUILD_TREE="$srcdir/build" -DQT612_DEPENDENCY_PREFIX=/usr || return
  cmake --build "$srcdir/smoke-build" --parallel "$MAX_JOBS" || return
  HOME="$srcdir/smoke-home" QT_QPA_PLATFORM=offscreen \
    QT612_OWN_PLUGIN_ROOT="$srcdir/build/lib/qt6/plugins" \
    QT_PLUGIN_PATH="$srcdir/build/lib/qt6/plugins" \
    QT_QPA_PLATFORM_PLUGIN_PATH=/usr/lib/qt6/plugins/platforms \
    LD_LIBRARY_PATH="$srcdir/build/lib" timeout 60 "$srcdir/smoke-build/qt612-smoke" || return
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build" || return
  python "$srcdir/source.py" install-notices --root "$srcdir/qtsvg-everywhere-src-$pkgver" \
    --policy "$srcdir/source-notices.json" --stage "$pkgdir" || return
  install -Dm644 "$srcdir/LICENSE.packaging" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.packaging" || return
  install -Dm644 "$srcdir/LICENSE.third-party" "$pkgdir/usr/share/licenses/$pkgname/LicenseRef-Qt-ThirdParty.txt" || return
  install -Dm644 "$srcdir/source-notices.json" "$pkgdir/usr/share/licenses/$pkgname/source-notices.json" || return
  python "$srcdir/check_stage.py" --root "$pkgdir" --license-manifest "$srcdir/source-notices.json" \
    > "$srcdir/stage-contract.json" || return
}
