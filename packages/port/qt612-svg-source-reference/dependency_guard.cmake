# Runs after project(); the Python preflight must pass before this configure call.
if(QT_NO_PACKAGE_VERSION_CHECK)
    message(FATAL_ERROR "Qt ABI/version checks cannot be disabled")
endif()
if(NOT IS_ABSOLUTE "${QT612_DEPENDENCY_PREFIX}" OR
   NOT IS_DIRECTORY "${QT612_DEPENDENCY_PREFIX}/lib/cmake")
    message(FATAL_ERROR "An explicit installed Qtbase dependency prefix is required")
endif()
file(REAL_PATH "${QT612_DEPENDENCY_PREFIX}" _canonical)
if(NOT QT612_DEPENDENCY_PREFIX STREQUAL _canonical)
    message(FATAL_ERROR "Refusing an aliased dependency prefix")
endif()
set(CMAKE_FIND_USE_PACKAGE_REGISTRY OFF)
set(CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY OFF)
set(Qt6_DIR "${QT612_DEPENDENCY_PREFIX}/lib/cmake/Qt6" CACHE PATH "" FORCE)
foreach(_module BuildInternals Core Gui Widgets CorePrivate GuiPrivate WidgetsPrivate CoreTools WidgetsTools)
    set(Qt6${_module}_DIR "${QT612_DEPENDENCY_PREFIX}/lib/cmake/Qt6${_module}" CACHE PATH "" FORCE)
endforeach()
find_package(Qt6 6.12.0 EXACT REQUIRED CONFIG COMPONENTS BuildInternals Core Gui Widgets
             PATHS "${QT612_DEPENDENCY_PREFIX}/lib/cmake/Qt6" NO_DEFAULT_PATH)
foreach(_module CorePrivate GuiPrivate WidgetsPrivate CoreTools WidgetsTools)
    find_package(Qt6${_module} 6.12.0 EXACT REQUIRED CONFIG
                 PATHS "${QT612_DEPENDENCY_PREFIX}/lib/cmake/Qt6${_module}" NO_DEFAULT_PATH)
endforeach()
foreach(_module Core Gui Widgets)
    if(NOT Qt6${_module}_DIR STREQUAL "${QT612_DEPENDENCY_PREFIX}/lib/cmake/Qt6${_module}" OR
       NOT TARGET Qt6::${_module} OR NOT TARGET Qt6::${_module}Private)
        message(FATAL_ERROR "Matching public/private Qt6.12 ${_module} targets are required")
    endif()
    get_target_property(_version Qt6::${_module} _qt_package_version)
    get_target_property(_imported Qt6::${_module} IMPORTED)
    get_target_property(_configs Qt6::${_module} IMPORTED_CONFIGURATIONS)
    if(NOT _imported OR NOT _version STREQUAL "6.12.0" OR NOT _configs)
        message(FATAL_ERROR "Refusing a different Qtbase ABI")
    endif()
    foreach(_config IN LISTS _configs)
        string(TOUPPER "${_config}" _config)
        get_target_property(_location Qt6::${_module} IMPORTED_LOCATION_${_config})
        set(_expected "${QT612_DEPENDENCY_PREFIX}/lib/libQt6${_module}.so.6.12.0")
        if(NOT _location STREQUAL _expected OR NOT EXISTS "${_expected}")
            message(FATAL_ERROR "Refusing foreign or missing Qtbase libraries")
        endif()
        file(REAL_PATH "${_location}" _real)
        if(NOT _real STREQUAL _expected)
            message(FATAL_ERROR "Refusing aliased Qtbase libraries")
        endif()
    endforeach()
endforeach()
foreach(_feature xmlstreamreader xmlstreamwriter cssparser widgets graphicsview system_zlib)
    if(NOT "${QT_FEATURE_${_feature}}" STREQUAL "ON" AND NOT "${QT_FEATURE_${_feature}}" STREQUAL "1")
        message(FATAL_ERROR "Required Qtbase feature is unavailable: ${_feature}")
    endif()
endforeach()
foreach(_tool moc rcc uic)
    if(NOT TARGET Qt6::${_tool})
        message(FATAL_ERROR "Matching native Qtbase build tools are required")
    endif()
endforeach()
