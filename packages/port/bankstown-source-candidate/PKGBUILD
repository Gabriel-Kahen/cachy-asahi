# SPDX-License-Identifier: MIT
# Opt-in source candidate; native tool/source catalog and qualification pending.
pkgname=bankstown
pkgver=1.1.0
pkgrel=5
pkgdesc='Asahi Bankstown LV2 source candidate; explicit compiler and offline build'
arch=('aarch64')
url='https://github.com/AsahiLinux/bankstown'
license=('MIT')
depends=('glibc' 'lv2')
makedepends=('rust' 'gcc' 'binutils' 'python')
options=('!lto' '!debug')
source=('bankstown-1.1.0.tar.gz' 'cargo-vendor-117.tar.xz' 'audio-rust-notices-v1.tar.xz' 'build_guard.py' 'COMPONENTS.json' 'native-rust-inputs.json' 'native-toolchain-requirements.json' 'SOURCE-CANDIDATE.md' 'PACKAGING.LICENSE')
sha256sums=('e877508b73fe90774d74526d838f75e8ea278bdbcee0a1f92e3eca67ed734675' '64cd55473b19f104f3a90570409d58c5ab69f63c61396541c4ad1e56e8d6293f' '7cd393018f279ff2a1e71fe85fb5767e3f58398edcd395da4ab6f4eb357ce522' '778c22cb52a4ffe4103a0e7a2c907def00bd9cd2411d0fdbca339a4cc010e21a' 'c1e3c54b93e0889976cfd2fda75c320e6d2fc1d254674024a2ddeee1ebc541f2' '65c0857c6278d82cc30afaff91a424dd753ba4435b6ac60ea377b3a0d6c9c1bc' '29ce46145c8945cd2a224e4ad717f934eb1821e7c09bef8921f261f80a55a28d' '13a80861493ed9ca18d66c6e6d71001be6150eb17b7a19c84e5e110da99a65f5' '51a352b3e94757560538ca5866bef929de5ec4864e5893fc635f291f7a5926c7')

prepare() {
  python3 -I "${srcdir}/build_guard.py" sources --root "${srcdir}" || return
  printf '%s  %s\n' '66887346513dafbdbe171f77890b4e414bd49abfdde7e0d9e35eeb9ebd677f94' \
    "${srcdir}/bankstown-1.1.0/Cargo.lock" | sha256sum -c - || return
  install -dm700 "${srcdir}/cargo-home" "${srcdir}/neutral-work"
  cat > "${srcdir}/cargo-home/config.toml" <<EOF
[source.crates-io]
replace-with = "vendored-sources"
[source.vendored-sources]
directory = "${srcdir}/vendor"
[net]
offline = true
[registry]
global-credential-providers = []
EOF
}

build() {
  : "${BANKSTOWN_NATIVE_TOOLS_PROFILE:?provide a separately audited native tool/support catalog}"
  : "${BANKSTOWN_NATIVE_TOOLS_SHA256:?provide its trusted SHA256}"
  python3 -I "${srcdir}/build_guard.py" native-tools \
    --profile "${BANKSTOWN_NATIVE_TOOLS_PROFILE}" --sha256 "${BANKSTOWN_NATIVE_TOOLS_SHA256}" || return
  python3 -I "${srcdir}/build_guard.py" neutral-tree --cwd "${srcdir}/neutral-work" || return
  [[ $(env -i PATH=/usr/bin LC_ALL=C /usr/bin/rustc --version) == 'rustc 1.99.0 ('* ]] || return 1
  [[ $(env -i PATH=/usr/bin LC_ALL=C /usr/bin/cargo --version) == 'cargo 1.99.0 ('* ]] || return 1
  cd "${srcdir}/neutral-work"
  env -i PATH=/usr/bin HOME="${srcdir}/cargo-home" CARGO_HOME="${srcdir}/cargo-home" \
    RUSTC=/usr/bin/rustc CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=/usr/bin/cc \
    CARGO_TARGET_DIR="${srcdir}/target" CARGO_NET_OFFLINE=true CARGO_BUILD_JOBS=1 \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1 SOURCE_DATE_EPOCH=1791748800 LC_ALL=C \
    RUSTFLAGS='-C target-cpu=generic -C link-arg=-Wl,-z,max-page-size=16384' \
    /usr/bin/cargo build --manifest-path "${srcdir}/bankstown-1.1.0/Cargo.toml" \
      --target aarch64-unknown-linux-gnu --release --locked --offline --jobs 1 || return
  printf '%s  %s\n' '66887346513dafbdbe171f77890b4e414bd49abfdde7e0d9e35eeb9ebd677f94' \
    "${srcdir}/bankstown-1.1.0/Cargo.lock" | sha256sum -c - || return
  python3 -I "${srcdir}/build_guard.py" receipt \
    --file "${srcdir}/target/aarch64-unknown-linux-gnu/release/libbankstown.so" \
    --target aarch64-unknown-linux-gnu --tools-sha256 "${BANKSTOWN_NATIVE_TOOLS_SHA256}" \
    --output "${srcdir}/build-inputs.json"
}

check() {
  python3 -I "${srcdir}/build_guard.py" artifact \
    --file "${srcdir}/target/aarch64-unknown-linux-gnu/release/libbankstown.so" \
    --target aarch64-unknown-linux-gnu --receipt "${srcdir}/build-inputs.json"
}

package() {
  local target=aarch64-unknown-linux-gnu
  if [[ ${BANKSTOWN_HOST_DIAGNOSTIC:-0} == 1 ]]; then
    [[ ${CARCH:-} == x86_64 ]] || return 1
    target=x86_64-unknown-linux-gnu
  fi
  python3 -I "${srcdir}/build_guard.py" artifact \
    --file "${srcdir}/target/${target}/release/libbankstown.so" \
    --target "${target}" --receipt "${srcdir}/build-inputs.json" || return
  install -Dm755 "${srcdir}/target/${target}/release/libbankstown.so" \
    "${pkgdir}/usr/lib/lv2/bankstown.lv2/bankstown.so"
  for ttl in bankstown.ttl manifest.ttl; do
    install -Dm644 "${srcdir}/bankstown-1.1.0/${ttl}" \
      "${pkgdir}/usr/lib/lv2/bankstown.lv2/${ttl}"
  done
  install -Dm644 "${srcdir}/bankstown-1.1.0/LICENSE" "${pkgdir}/usr/share/licenses/bankstown/LICENSE"
  for notice in THIRD-PARTY.md THIRD-PARTY-LICENSES.txt SOURCE.md; do
    install -Dm644 "${srcdir}/audio-rust-notices/bankstown/${notice}" \
      "${pkgdir}/usr/share/licenses/bankstown/${notice}"
  done
  install -Dm644 "${srcdir}/PACKAGING.LICENSE" "${pkgdir}/usr/share/licenses/bankstown/PACKAGING.LICENSE"
  install -Dm644 "${srcdir}/SOURCE-CANDIDATE.md" "${pkgdir}/usr/share/doc/bankstown/SOURCE-CANDIDATE.md"
  install -Dm644 "${srcdir}/build-inputs.json" "${pkgdir}/usr/share/doc/bankstown/BUILD-INPUTS.json"
}
