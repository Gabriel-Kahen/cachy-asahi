pkgname=cachy-asahi-fdk-aac
pkgver=3.0.0
pkgrel=1
pkgdesc='Source-built classic and xHE FDK AAC libraries with complete notices'
arch=('aarch64')
url='https://github.com/mstorsjo/fdk-aac'
license=('LicenseRef-Fraunhofer' 'LicenseRef-Fraunhofer-xHE-AAC' 'MIT')
depends=('glibc')
makedepends=('gcc' 'python' 'binutils')
provides=('libfdk-aac=3.0.0' 'libfdk-aac.so=2-64' 'libfdk-xhe-aac.so=0-64')
conflicts=('libfdk-aac')
options=('!staticlibs' '!debug')
source=('fdk-aac-3.0.0-selected-source.tar' 'NOTICE.classic' 'NOTICE.xhe-aac' 'COPYRIGHTS-and-LICENSES' 'LICENSE.MIT' 'README.md' 'PUBLICATION.md' 'source-provenance.json' 'selected-source-manifest.json' 'source_check.py' 'materialize.py' 'select-source.py' 'publication.py' 'check-built.py' 'codec-smoke.c' 'test_source.py' 'build-codec.py' 'build-layout.json' 'stage.py' 'test_build.py' 'test_publication.py' 'inner_observation.py' 'test_inner_observation.py')
sha256sums=(1065c4b30e0c2deee7965faa0257e10ac482a2516d51b5b8f17b1406b3ecb2f4 95ec80da40b4af12ad4c4f3158c9cfb80f2479f3246e4260cb600827cc8c7836 bf3e762249027586195def2b2e904901b42c8b7fab455fc66bf365f70d08de6d a0a52a99bef6dea5c370711f17ed1c02e8b0989a4c167f4e54a36368987428c0 4d263ff2b095160e3b9244a132d248234241b83eed71b849decef6a3ba3fa795 724fffb8b56e40db668959fd5911d87c96529813499f6f63c5fdb37f69c76d09 0db09f321999befabe795066a388c271db786377d312a3f60c84424cb7685efa 2f5d3c3124bdc564e9183aac8a534e51ac03c078f8312395370b8454b435cae3 3eb66e2e1632cf65044f9250c7460b1effe0de3217f83b573b4e23885772fc29 3825fb36450ab96bc761bdb7c86075cfbe2d80cf28b95ebda18aafbbf6b6895b 2c040e37b8f0b47213484c7834b70e030528dc5fe3277fecda989455862e0d75 b7d9d047ffa87d6ec5e1fd26efb2d52dbf533d7f0359eee8874905e57c1511c7 257a1fe6e567209e318fd29691501076de4566c9a536157e7d91a1002eef48d4 f6d1e1ca8cb85da4d2555de82a08624960dfd70b00eea09dfa35e61645d694f9 70735f85644927e0427d12fbda21d6515fdab1bb9c19b5105abe654218b9af96 d1de6ee9687b7fa71e2023cb3bdb53b7a69094541a1ac986dcda9a15b8cedddc 3cf179f60283138e4afffb4abfe1dce1e9113366fc322bcc73386fa489941c3a 1ca4cdc6d8070216cc7797f91d254ce6abd2eefbe3c1457beeeb47862b6599dc ef987ac2cdf9abacd52dc44cc57d62d033a4adce7c4ec09b411d91ff5470448b 4e3b98524bb4635f657cc67013122fa45727dacd943ee74765c19717e53b04c2 64130b1723b73d0269112283c2441d3db0c661c603f239bdc9b86c20794cca04 a5074240e9072c6fff15efd86d80d521d775ef0e1c2475ebe1710a3165df6c2a d62929e72e38b864fd430fdd71b7b8479f97f6180ef629627cc6b76210b103af)

# Failure arms keep the original status even if diagnostic printf fails.
# They retain the existing fail-fast makepkg recipe contract; no shell trap.
# STATUS is Bash command status, not a proved process termination kind.
prepare() {
    [[ ${CACHY_ASAHI_CONTAINER:-} == 1 && $CARCH == aarch64 ]] || return 2
    python -B "$startdir/source_check.py" "$startdir/fdk-aac-3.0.0-selected-source.tar" || { local _cachy_asahi_fdk_failure_status=$?; printf '__CACHY_ASAHI_FDK_FAILURE_V1__ STAGE=SOURCE_CHECK STATUS=%s\n' "$_cachy_asahi_fdk_failure_status" >&2 || :; return "$_cachy_asahi_fdk_failure_status"; }
}

build() {
    [[ ${CACHY_ASAHI_CONTAINER:-} == 1 && $CARCH == aarch64 ]] || return 2
    python -B "$startdir/build-codec.py" --source "$srcdir/fdk-aac-3.0.0" --output "$srcdir/codec-build" || { local _cachy_asahi_fdk_failure_status=$?; printf '__CACHY_ASAHI_FDK_FAILURE_V1__ STAGE=CODEC_BUILD STATUS=%s\n' "$_cachy_asahi_fdk_failure_status" >&2 || :; return "$_cachy_asahi_fdk_failure_status"; }
    cp "$srcdir/codec-build/build-commands.json" /out/fdk-build-commands.json || { local _cachy_asahi_fdk_failure_status=$?; printf '__CACHY_ASAHI_FDK_FAILURE_V1__ STAGE=BUILD_METADATA_COPY STATUS=%s\n' "$_cachy_asahi_fdk_failure_status" >&2 || :; return "$_cachy_asahi_fdk_failure_status"; }
}

check() {
    [[ ${CACHY_ASAHI_CONTAINER:-} == 1 && $CARCH == aarch64 ]] || return 2
    # The builder's immutable input snapshot excludes makepkg logs/src/pkg.
    python -B /inputs/test_source.py || { local _cachy_asahi_fdk_failure_status=$?; printf '__CACHY_ASAHI_FDK_FAILURE_V1__ STAGE=CHECK_SOURCE STATUS=%s\n' "$_cachy_asahi_fdk_failure_status" >&2 || :; return "$_cachy_asahi_fdk_failure_status"; }
    python -B /inputs/test_build.py || { local _cachy_asahi_fdk_failure_status=$?; printf '__CACHY_ASAHI_FDK_FAILURE_V1__ STAGE=CHECK_BUILD STATUS=%s\n' "$_cachy_asahi_fdk_failure_status" >&2 || :; return "$_cachy_asahi_fdk_failure_status"; }
    python -B /inputs/test_publication.py || { local _cachy_asahi_fdk_failure_status=$?; printf '__CACHY_ASAHI_FDK_FAILURE_V1__ STAGE=CHECK_PUBLICATION STATUS=%s\n' "$_cachy_asahi_fdk_failure_status" >&2 || :; return "$_cachy_asahi_fdk_failure_status"; }
    python -B /inputs/test_inner_observation.py || { local _cachy_asahi_fdk_failure_status=$?; printf '__CACHY_ASAHI_FDK_FAILURE_V1__ STAGE=CHECK_INNER_OBSERVATION STATUS=%s\n' "$_cachy_asahi_fdk_failure_status" >&2 || :; return "$_cachy_asahi_fdk_failure_status"; }
    cd "$srcdir/codec-build" || { local _cachy_asahi_fdk_failure_status=$?; printf '__CACHY_ASAHI_FDK_FAILURE_V1__ STAGE=CHECK_DIRECTORY STATUS=%s\n' "$_cachy_asahi_fdk_failure_status" >&2 || :; return "$_cachy_asahi_fdk_failure_status"; }
    python -B "$startdir/check-built.py" || { local _cachy_asahi_fdk_failure_status=$?; printf '__CACHY_ASAHI_FDK_FAILURE_V1__ STAGE=CHECK_BUILT STATUS=%s\n' "$_cachy_asahi_fdk_failure_status" >&2 || :; return "$_cachy_asahi_fdk_failure_status"; }
    printf '__CACHY_ASAHI_FDK_SMOKE_V1__ BEGIN\n' >&2 || :
    cc -std=c11 -Wall -Wextra -Werror \
        -isystem "$srcdir/fdk-aac-3.0.0/cpp/libAACenc/include" \
        -isystem "$srcdir/fdk-aac-3.0.0/cpp/libAACdec/include" \
        -isystem "$srcdir/fdk-aac-3.0.0/cpp/libSYS/include" \
        -isystem "$srcdir/fdk-aac-3.0.0/xhe-aac/xHEAACEnc/include" \
        "$startdir/codec-smoke.c" -L. -lfdk-aac -lfdk-xhe-aac -o "$srcdir/codec-smoke" || { local _cachy_asahi_fdk_failure_status=$?; printf '__CACHY_ASAHI_FDK_FAILURE_V1__ STAGE=SMOKE_COMPILE STATUS=%s\n' "$_cachy_asahi_fdk_failure_status" >&2 || :; return "$_cachy_asahi_fdk_failure_status"; }
    LD_LIBRARY_PATH="$srcdir/codec-build" timeout 60 "$srcdir/codec-smoke" || { local _cachy_asahi_fdk_failure_status=$?; printf '__CACHY_ASAHI_FDK_FAILURE_V1__ STAGE=SMOKE_RUN STATUS=%s\n' "$_cachy_asahi_fdk_failure_status" >&2 || :; return "$_cachy_asahi_fdk_failure_status"; }
}

package() {
    [[ ${CACHY_ASAHI_CONTAINER:-} == 1 && $CARCH == aarch64 ]] || return 2
    python -B "$startdir/stage.py" --source "$srcdir/fdk-aac-3.0.0" --build "$srcdir/codec-build" --package "$pkgdir" || { local _cachy_asahi_fdk_failure_status=$?; printf '__CACHY_ASAHI_FDK_FAILURE_V1__ STAGE=PACKAGE_STAGE STATUS=%s\n' "$_cachy_asahi_fdk_failure_status" >&2 || :; return "$_cachy_asahi_fdk_failure_status"; }
    install -Dm644 "$startdir/NOTICE.classic" "$pkgdir/usr/share/licenses/$pkgname/NOTICE.classic" || { local _cachy_asahi_fdk_failure_status=$?; printf '__CACHY_ASAHI_FDK_FAILURE_V1__ STAGE=PACKAGE_NOTICE STATUS=%s\n' "$_cachy_asahi_fdk_failure_status" >&2 || :; return "$_cachy_asahi_fdk_failure_status"; }
    install -Dm644 "$startdir/NOTICE.xhe-aac" "$pkgdir/usr/share/licenses/$pkgname/NOTICE.xhe-aac" || { local _cachy_asahi_fdk_failure_status=$?; printf '__CACHY_ASAHI_FDK_FAILURE_V1__ STAGE=PACKAGE_NOTICE STATUS=%s\n' "$_cachy_asahi_fdk_failure_status" >&2 || :; return "$_cachy_asahi_fdk_failure_status"; }
    install -Dm644 "$startdir/COPYRIGHTS-and-LICENSES" "$pkgdir/usr/share/licenses/$pkgname/COPYRIGHTS-and-LICENSES" || { local _cachy_asahi_fdk_failure_status=$?; printf '__CACHY_ASAHI_FDK_FAILURE_V1__ STAGE=PACKAGE_NOTICE STATUS=%s\n' "$_cachy_asahi_fdk_failure_status" >&2 || :; return "$_cachy_asahi_fdk_failure_status"; }
    install -Dm644 "$startdir/LICENSE.MIT" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.MIT" || { local _cachy_asahi_fdk_failure_status=$?; printf '__CACHY_ASAHI_FDK_FAILURE_V1__ STAGE=PACKAGE_NOTICE STATUS=%s\n' "$_cachy_asahi_fdk_failure_status" >&2 || :; return "$_cachy_asahi_fdk_failure_status"; }
    install -Dm644 "$startdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md" || { local _cachy_asahi_fdk_failure_status=$?; printf '__CACHY_ASAHI_FDK_FAILURE_V1__ STAGE=PACKAGE_DOCUMENT STATUS=%s\n' "$_cachy_asahi_fdk_failure_status" >&2 || :; return "$_cachy_asahi_fdk_failure_status"; }
    install -Dm644 "$startdir/PUBLICATION.md" "$pkgdir/usr/share/doc/$pkgname/PUBLICATION.md" || { local _cachy_asahi_fdk_failure_status=$?; printf '__CACHY_ASAHI_FDK_FAILURE_V1__ STAGE=PACKAGE_DOCUMENT STATUS=%s\n' "$_cachy_asahi_fdk_failure_status" >&2 || :; return "$_cachy_asahi_fdk_failure_status"; }
    install -Dm644 "$startdir/source-provenance.json" "$pkgdir/usr/share/doc/$pkgname/source-provenance.json" || { local _cachy_asahi_fdk_failure_status=$?; printf '__CACHY_ASAHI_FDK_FAILURE_V1__ STAGE=PACKAGE_DOCUMENT STATUS=%s\n' "$_cachy_asahi_fdk_failure_status" >&2 || :; return "$_cachy_asahi_fdk_failure_status"; }
}
