check() {
    python -I -B -Werror::ResourceWarning "$srcdir/check_sources.py" --srcdir "$srcdir"
    python -I -B -Werror::ResourceWarning "$srcdir/test_package.py" --recipe-root "$startdir" --srcdir "$srcdir" --hide-checkout "${INSTALL_HANDOFF_HIDE_CHECKOUT:-$startdir}"
}

package() {
    [[ -n ${srcdir:-} && ${pkgdir:-} = /* && $pkgdir != / && $pkgdir != "$srcdir" ]] || return 1
    install -Dm755 "$srcdir/cachy-asahi-install-handoff" "$pkgdir/usr/bin/cachy-asahi-install-handoff" || return
    local path leaf
    local -a runtime=(
        'LICENSE'
        'manifests/packages.toml'
        'packages/desktop/cachy-asahi-hyprland-settings011/hyprland.lua'
        'packages/shells/cachy-asahi-fish-config/config.fish'
        'packages/shells/cachy-asahi-zsh-config/config.zsh'
        'packages/tools/cachy-asahi-first-login/PKGBUILD'
        'packages/tools/cachy-asahi-repository-enrollment-v3/PKGBUILD'
        'packages/tools/cachy-asahi-setup8/PKGBUILD'
        'packages/tools/cachy-asahi-setup8/cachy-asahi-setup'
        'runtime.json'
        'scripts/checks/package_checks.py'
        'scripts/ci/native_arm.py'
        'scripts/client/client.py'
        'scripts/install/first_login.py'
        'scripts/install/fresh_handoff/handoff.py'
        'scripts/install/fresh_handoff/runtime.py'
        'scripts/install/local_transaction.py'
        'scripts/install/native_preflight.py'
        'scripts/integration/lifecycle.py'
        'scripts/platform/archive_coverage.py'
        'scripts/platform/authenticate_missing.py'
        'scripts/platform/capture.py'
        'scripts/platform/recovery_inputs.py'
        'scripts/platform/recovery_preflight.py'
        'scripts/platform/transaction.py'
        'scripts/platform/tuple_audit.py'
        'scripts/port/authenticate.py'
        'scripts/port/preview.py'
        'scripts/release/offline_kit.py'
        'scripts/release/recovery_bundle.py'
        'scripts/release/source_delivery.py'
        'scripts/repository/enroll.py'
        'source-lock.json'
    )
    for path in "${runtime[@]}"; do
        install -Dm644 "$srcdir/private/$path" "$pkgdir/usr/lib/cachy-asahi/install-handoff/$path" || return
    done
    for leaf in README.md source-provenance.json payload-map.json; do
        install -Dm644 "$srcdir/$leaf" "$pkgdir/usr/share/doc/$pkgname/$leaf" || return
    done
    for leaf in LICENSE NOTICE; do
        install -Dm644 "$srcdir/$leaf" "$pkgdir/usr/share/licenses/$pkgname/$leaf" || return
    done
}
