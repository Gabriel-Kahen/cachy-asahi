pkgname=cachy-asahi-install-handoff
pkgver=0.1.0
pkgrel=1
pkgdesc='Opt-in offline fresh-install and recovery handoff preparation and verification'
arch=('any')
url='https://github.com/Gabriel-Kahen/cachy-asahi'
license=('MIT')
depends=('python>=3.11' 'gnupg' 'pacman' 'coreutils' 'libarchive' 'bash')
checkdepends=('bubblewrap' 'util-linux')
options=('!strip' '!debug')
source=(
    'private-source.tar.gz'
    'check-source.tar.gz'
    'cachy-asahi-install-handoff'
    'test_package.py'
    'check_sources.py'
    'README.md'
    'source-provenance.json'
    'payload-map.json'
    'NOTICE'
    'LICENSE'
)
sha256sums=(
    '5439cd9fa42932d95d08c1053bb344de76beaeaf3f48a1a59b91fe689916410a'
    '774cdd8053b135569ce857e23dcd1f28123a1edbf702c78a39791532103154f6'
    '01068262b802f14444c77bfa9bf4df277995ab3cf4c9d1644e8beb9ee1e48830'
    '2fc398bc3310fa4e466d6418dd784e5a933c50d000efd22edb810f1aec203c68'
    '4166116037baf34556cc30aa66fa68770263c118c1479fa0d06cc12afbdb0e1c'
    '14da5efe7ecee4d4a555086f1172817f72a1b6437ad769cce3630954aebc1161'
    'ffe555254b39cda5efafbde03a55d80edc3bcc8f31df17ab1e6c0ce34d2526f6'
    'a613095c72db239d9ea9b66a3d749279393cf64116e388f58e0775ad78c12633'
