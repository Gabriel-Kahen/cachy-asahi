pkgname=cachy-asahi-zsh-history-substring-search
pkgver=0.1.0
pkgrel=1
pkgdesc='Explicit opt-in pinned Zsh history substring search for cachy-asahi'
arch=('any')
url='https://github.com/zsh-users/zsh-history-substring-search'
license=('BSD-3-Clause' 'MIT')
depends=('zsh>=5.9')
makedepends=('python')
source=(
  'zsh-history-substring-search.zsh'
  'opt-in.zsh'
  'usage.md'
  'NOTICE'
  'LICENSE.upstream'
  'LICENSE.project'
  'check-module.py'
  'source-provenance.json'
)
sha256sums=(
  '0b864862a3b48992d7316cc7e585a1315fa389d730c17bf16e2f2bd5918089f3'
  '2eedaa32f3504b5301afc7e8c302ef91d3c60fa1c1a532ab59c4d11915fedea5'
  '5ff7ca69e03cd53ddb51dc53a21e1737f9aae96ea12fa7e2a5a509fc9c19b7e3'
  '36bc69d4b18cbef88cf8770cb01a8a91db018fef85170a458a9a5315511d9c08'
  '95f239dd39d079d2546aaefee371d09f3f423d6902e85e64787ae0bc5f441a33'
  '51a352b3e94757560538ca5866bef929de5ec4864e5893fc635f291f7a5926c7'
