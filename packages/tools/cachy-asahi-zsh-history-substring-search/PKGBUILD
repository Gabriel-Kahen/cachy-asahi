check() {
  zsh -n "$srcdir/zsh-history-substring-search.zsh" || return
  zsh -n "$srcdir/opt-in.zsh" || return
  local work code
  work=$(mktemp -d "$srcdir/.substring-check.XXXXXX") || return
  if python3 -B "$srcdir/check-module.py" --module-dir "$srcdir" --work "$work"; then
    code=0
  else
    code=$?
  fi
  rm -rf -- "$work"
  return "$code"
}

package() {
  local file
  for file in zsh-history-substring-search.zsh opt-in.zsh; do
    install -Dm644 "$srcdir/$file" "$pkgdir/usr/share/cachy-asahi/zsh-history-substring-search/$file"
  done
  for file in usage.md source-provenance.json; do
    install -Dm644 "$srcdir/$file" "$pkgdir/usr/share/doc/$pkgname/$file"
  done
  for file in LICENSE.upstream LICENSE.project NOTICE; do
    install -Dm644 "$srcdir/$file" "$pkgdir/usr/share/licenses/$pkgname/$file"
  done
}
