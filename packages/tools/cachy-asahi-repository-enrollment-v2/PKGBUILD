check() {
    python -I -B -Werror::ResourceWarning "$srcdir/test_package.py" --recipe-root "$startdir" --srcdir "$srcdir" --hide-checkout "${REPOSITORY_ENROLLMENT_HIDE_ROOT:-$startdir}"
}

package() {
    [[ -n ${srcdir:-} && ${pkgdir:-} = /* && $pkgdir != / && $pkgdir != "$srcdir" ]] || return 1
    install -Dm755 "$srcdir/cachy-asahi-repository-enrollment" "$pkgdir/usr/bin/cachy-asahi-repository-enrollment" || return
    local path leaf
    for path in scripts/repository/enroll.py scripts/repository/rotate.py scripts/repository/transition.py scripts/release/signing_transition.py scripts/release/compare_releases.py scripts/release/release.py scripts/release/source_delivery.py scripts/maintenance/signing_expiry.py; do
        install -Dm644 "$srcdir/private/$path" "$pkgdir/usr/lib/cachy-asahi/repository-enrollment/$path" || return
    done
    for leaf in README.md source-provenance.json payload-map.json; do
        install -Dm644 "$srcdir/$leaf" "$pkgdir/usr/share/doc/$pkgname/$leaf" || return
    done
    for leaf in LICENSE NOTICE; do
        install -Dm644 "$srcdir/$leaf" "$pkgdir/usr/share/licenses/$pkgname/$leaf" || return
    done
}
