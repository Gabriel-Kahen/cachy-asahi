#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu
PATH=/usr/bin:/bin
export PATH
launcher=$(/usr/bin/readlink -f -- "$0")
prefix=$(/usr/bin/dirname -- "$(/usr/bin/dirname -- "$launcher")")
runtime="$prefix/lib/cachy-asahi/repository-enrollment/scripts/repository"
case "${1:-}" in
    --version) printf '%s\n' 'cachy-asahi-repository-enrollment 0.2.0'; exit 0 ;;
    ''|--help|-h)
        printf '%s\n' 'Usage: cachy-asahi-repository-enrollment configure [OPTIONS] enroll|disable [OPTIONS]' \
            '       cachy-asahi-repository-enrollment rotate [OPTIONS]' \
            '       cachy-asahi-repository-enrollment transition [OPTIONS]' \
            'Preview is the default. Pass --apply to the selected command to change local trust/configuration.' \
            'A transition preserves the snapshot URL; it does not accept or install the successor release.' \
            'Use configure --help, rotate --help or transition --help for exact command options.'
        exit 0 ;;
    configure) shift; exec /usr/bin/python3 -I -B "$runtime/enroll.py" "$@" ;;
    rotate) shift; exec /usr/bin/python3 -I -B "$runtime/rotate.py" "$@" ;;
    transition) shift; exec /usr/bin/python3 -I -B "$runtime/transition.py" "$@" ;;
    *) printf '%s\n' 'Unknown command; use --help.' >&2; exit 2 ;;
esac
