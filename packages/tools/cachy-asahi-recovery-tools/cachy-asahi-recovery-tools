def checked_runtime():
    for path in (RUNTIME, *RUNTIME.parents):
        if path.is_symlink():
            raise ValueError('private runtime symlink refused')
    files = set()
    for parent, dirs, names in os.walk(RUNTIME, followlinks=False):
        for name in dirs:
            path = Path(parent) / name
            if path.is_symlink():
                raise ValueError('private runtime symlink refused')
        for name in names:
            path = Path(parent) / name
            rel = path.relative_to(RUNTIME).as_posix()
            info = path.lstat()
            if (rel not in PINS or not stat.S_ISREG(info.st_mode) or info.st_nlink != 1
                    or info.st_mode & 0o022 or info.st_size > 8 * 1024**2):
                raise ValueError('private runtime member refused: ' + rel)
            fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
            with os.fdopen(fd, 'rb') as stream:
                before = os.fstat(stream.fileno())
                raw = stream.read(8 * 1024**2 + 1)
                after = os.fstat(stream.fileno())
            identity = lambda value: (value.st_dev, value.st_ino, value.st_size, value.st_mtime_ns, value.st_ctime_ns)
            if (identity(info) != identity(before) or identity(before) != identity(after)
                    or hashlib.sha256(raw).hexdigest() != PINS[rel]):
                raise ValueError('private runtime checksum differs: ' + rel)
            files.add(rel)
    if files != set(PINS):
        raise ValueError('private runtime file set differs')
    def audit(event, args):
        if event == 'open' and isinstance(args[0], (str, bytes, os.PathLike)):
            path = Path(os.fsdecode(args[0]))
            if path.suffix == '.pyc' and path.is_relative_to(RUNTIME):
                raise PermissionError('private runtime bytecode refused')
    sys.addaudithook(audit)


def main():
    if sys.argv[1:] == ['--version']:
        print('cachy-asahi-recovery-tools ' + VERSION)
        return 0
    try:
        checked_runtime()
        path = RUNTIME / 'scripts/release/recovery_bundle.py'
        spec = importlib.util.spec_from_file_location('installed_recovery_bundle', path)
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        return module.main()
    except (OSError, ValueError, ImportError) as error:
        print('offline recovery tools refused: ' + str(error), file=sys.stderr)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
