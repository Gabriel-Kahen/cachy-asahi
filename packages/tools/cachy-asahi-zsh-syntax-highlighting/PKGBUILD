check() {
  local file
  for file in "$srcdir"/*.zsh; do zsh -n "$file" || return; done
}

package() {
  local file
  for file in zsh-syntax-highlighting.zsh .version .revision-hash opt-in.zsh; do
    install -Dm644 "$srcdir/$file" "$pkgdir/usr/share/cachy-asahi/zsh-syntax-highlighting/$file"
  done
  install -Dm644 "$srcdir/brackets-highlighter.zsh" "$pkgdir/usr/share/cachy-asahi/zsh-syntax-highlighting/highlighters/brackets/brackets-highlighter.zsh"
  install -Dm644 "$srcdir/cursor-highlighter.zsh" "$pkgdir/usr/share/cachy-asahi/zsh-syntax-highlighting/highlighters/cursor/cursor-highlighter.zsh"
  install -Dm644 "$srcdir/line-highlighter.zsh" "$pkgdir/usr/share/cachy-asahi/zsh-syntax-highlighting/highlighters/line/line-highlighter.zsh"
  install -Dm644 "$srcdir/main-highlighter.zsh" "$pkgdir/usr/share/cachy-asahi/zsh-syntax-highlighting/highlighters/main/main-highlighter.zsh"
  install -Dm644 "$srcdir/pattern-highlighter.zsh" "$pkgdir/usr/share/cachy-asahi/zsh-syntax-highlighting/highlighters/pattern/pattern-highlighter.zsh"
  install -Dm644 "$srcdir/regexp-highlighter.zsh" "$pkgdir/usr/share/cachy-asahi/zsh-syntax-highlighting/highlighters/regexp/regexp-highlighter.zsh"
  install -Dm644 "$srcdir/root-highlighter.zsh" "$pkgdir/usr/share/cachy-asahi/zsh-syntax-highlighting/highlighters/root/root-highlighter.zsh"
  for file in usage.md README.md INSTALL.md; do
    install -Dm644 "$srcdir/$file" "$pkgdir/usr/share/doc/$pkgname/$file"
  done
  for file in LICENSE.upstream LICENSE.project NOTICE; do
    install -Dm644 "$srcdir/$file" "$pkgdir/usr/share/licenses/$pkgname/$file"
  done
}
