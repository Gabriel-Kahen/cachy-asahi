# makepkg links local sources into srcdir; the strict preparer accepts regular files.
_stage_check_sources() {
    local staged i name
    staged=$(mktemp -d "$srcdir/check-source.XXXXXXXX") || return
    for i in "${!source[@]}"; do
        name=${source[$i]}
        [[ $name != */* && $name != . && $name != .. && ${sha256sums[$i]} =~ ^[0-9a-f]{64}$ ]] || return 1
        install -m600 -- "$srcdir/$name" "$staged/$name" || return
        printf '%s  %s\n' "${sha256sums[$i]}" "$staged/$name" | sha256sum --check >&2 || return
    done
    printf '%s\n' "$staged"
}

check() {
    local staged
    staged=$(_stage_check_sources) || return
    python -I -B "$staged/prepare-check-inputs.py" \
        --archive "$staged/check-inputs.tar.gz" --index "$staged/check-inputs.json" --output "$staged/check-inputs" || return
    local source="${CACHY_ASAHI_REPOSITORY_SOURCE:-$staged/check-inputs/repository}"
    local runtime="${CACHY_ASAHI_RUNTIME_RECIPE:-$staged/check-inputs/runtime-recipe}"
    python -I -B "$staged/check_source.py" --recipe-root "$startdir" --repository-source "$source" || return
    python -I -B "$staged/test_apps.py" --repository-source "$source" --runtime-recipe-root "$runtime" --app-recipe-root "$startdir" || return
    python -I -B "$staged/test_inventory_paths.py" --repository-source "$source"
}
package() {
    [[ -n $pkgdir && $pkgdir != / ]] || return 1
    install -Dm755 "$srcdir/cachy-asahi-apps" "$pkgdir/usr/bin/cachy-asahi-apps" || return
    install -Dm644 "$srcdir/inventory.py" "$pkgdir/usr/lib/cachy-asahi-apps/inventory.py" || return
    install -Dm644 "$srcdir/apps.py" "$pkgdir/usr/lib/cachy-asahi-apps/apps.py" || return
    install -Dm644 "$srcdir/helper-pins.json" "$pkgdir/usr/lib/cachy-asahi-apps/helper-pins.json" || return
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md" || return
    install -Dm644 "$srcdir/source-provenance.json" "$pkgdir/usr/share/doc/$pkgname/source-provenance.json" || return
    install -Dm644 "$srcdir/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE" || return
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
