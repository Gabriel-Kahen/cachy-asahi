pkgname=cachy-asahi-build-tools
pkgver=0.2.0
pkgrel=1
pkgdesc='Opt-in offline source-cache, preflight and literal recipe metadata checks'
arch=('any')
url='https://github.com/Gabriel-Kahen/cachy-asahi'
license=('MIT')
depends=('python>=3.12')
options=('!strip' '!debug')
source=('source_cache.py' 'source_delivery.py' 'package_checks.py' 'source_materials.py' 'import_source.py' 'preflight.py' 'recipe_metadata_consistency.py' 'cachy-asahi-build-tools' 'check-inputs.tar.gz' 'source-provenance.json' 'test_package.py' 'README.md' 'NOTICE' 'LICENSE')
noextract=('check-inputs.tar.gz')
sha256sums=(
