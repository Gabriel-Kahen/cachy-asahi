prepare() {
    local tree="$srcdir/setup8-v3"
    install -Dm644 "$srcdir/setup.py" "$srcdir/config_migrate.py" \
        "$srcdir/test_config_migrate.py" -t "$tree" || return
    patch --batch --forward --fuzz=0 -d "$tree" -p1 < "$srcdir/fish-quoting.patch" || return
    patch --batch --forward --fuzz=0 -d "$tree" -p1 < "$srcdir/journal-guard.patch" || return
    (
        cd "$tree" &&
            sha256sum --check --strict <<'DIGESTS'
adfb419090e990705a2d04e2f6ffa167a279b393a65d26a222edced984b640d3  setup.py
ea1dec790d06927679e006cf1a5dd254da1fda36e18f9f0f8f0b5ab444e960ce  config_migrate.py
DIGESTS
    )
}

check() (
    local staged
    staged=$(mktemp -d "$srcdir/setup8-stage.XXXXXX") || return
    trap 'rm -rf -- "$staged"' EXIT
    pkgdir="$staged" package || return
    python -I -B -Werror::ResourceWarning "$srcdir/setup8-v3/test_config_migrate.py" -v || return
    python -I -B -Werror::ResourceWarning "$srcdir/test_fish_quoting.py" \
        --stage "$staged/usr" --legacy-root "$srcdir" -v
)

package() {
    local tree="$srcdir/setup8-v3"
    [[ -n $pkgdir && $pkgdir != / ]] || return 1
    install -Dm755 "$tree/setup.py" "$pkgdir/usr/bin/cachy-asahi-setup" || return
    install -Dm755 "$srcdir/cachy-asahi-repository" "$pkgdir/usr/bin/cachy-asahi-repository" || return
    install -Dm755 "$srcdir/cachy-asahi-config-migrate" "$pkgdir/usr/bin/cachy-asahi-config-migrate" || return
    install -Dm644 "$tree/setup.py" "$tree/config_migrate.py" -t "$pkgdir/usr/lib/cachy-asahi/setup8" || return
    install -Dm644 "$srcdir/README.md" "$srcdir/repository-enrollment.md" "$srcdir/configuration-migrations.md" \
        -t "$pkgdir/usr/share/doc/$pkgname" || return
    install -Dm644 "$srcdir/NOTICE" "$srcdir/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"
}
