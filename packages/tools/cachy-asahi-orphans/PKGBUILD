pkgname=cachy-asahi-orphans
pkgver=0.2.0
pkgrel=1
pkgdesc='Read-only orphan plans and explicitly selected finite offline removal'
arch=('any')
url='https://github.com/Gabriel-Kahen/cachy-asahi'
license=('MIT')
depends=('python>=3.11' 'pacman')
source=('orphans3' 'remove.py' 'cachy-asahi-orphans' 'test_orphans.py' 'test_remove.py' 'test_retirement.py' 'protection-floor.json' 'README.md' 'READONLY.md' 'source-provenance.json' 'check_source.py' 'NOTICE' 'LICENSE')
sha256sums=(
