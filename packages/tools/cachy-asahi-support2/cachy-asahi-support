"""Run the exact private offline support closure from this installed prefix."""
import hashlib
import os
from pathlib import Path
import runpy
import stat
import sys

RUNTIME = {
    'scripts/support/collect_support.py': '2116e931e91ceed87627eeeb1acec2da1158a523c7c2f71fc2f4b4b41936159e',
    'scripts/support/support_bundle.py': '2fff76ad4df036f383927381b0b56c89904c3087f7ca151902ba80fb8c82bdc8',
    'scripts/hardware/session_probe.py': '9c5c41899cd991b0de4bf8d30bad6f5452b4592ea9440df0f0b4a7b54bc66984',
    'packages/tools/cachy-asahi-doctor2/cachy-asahi-doctor': 'ddd8c3cedc5ba1291dcdd2d1d7a188e5b4d4a4ac7323ffe6f7ee554f6687d41e',
}


def checked(path, expected):
    fd = os.open('/', os.O_RDONLY | os.O_DIRECTORY)
    try:
        for part in path.parts[1:-1]:
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = child
        source = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)
        try:
            info = os.fstat(source)
            if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or not 0 < info.st_size <= 65536:
                raise ValueError()
            with os.fdopen(source, 'rb', closefd=False) as stream:
                raw = stream.read(65537)
            if len(raw) != info.st_size or hashlib.sha256(raw).hexdigest() != expected:
                raise ValueError()
        finally:
            os.close(source)
    finally:
        os.close(fd)


def main():
    root = Path(__file__).resolve().parents[1] / 'lib/cachy-asahi/support'
    try:
        for name, checksum in RUNTIME.items():
            checked(root / name, checksum)
    except (OSError, ValueError):
        print('Support runtime missing or changed; restore the reviewed package.', file=sys.stderr)
        return 2
    if sys.argv[1:] == ['--version']:
        print('cachy-asahi-support 0.2.0-1')
        return 0
    command = 'scripts/support/support_bundle.py'
    if sys.argv[1:2] == ['collect']:
        del sys.argv[1]
        command = 'scripts/support/collect_support.py'
    elif sys.argv[1:] == ['--help']:
        print('Commands: collect (current read-only observations), create (selected reports), verify (offline archive).')
    runpy.run_path(str(root / command), run_name='__main__')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
