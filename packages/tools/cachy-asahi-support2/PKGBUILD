# Original support collection CLI; no installation hooks or system mutation.
pkgname=cachy-asahi-support
pkgver=0.2.0
pkgrel=1
pkgdesc='Private read-only support collection and offline sanitized bundles'
arch=(any)
url=https://github.com/Gabriel-Kahen/cachy-asahi
license=(MIT)
depends=('python>=3.11')
checkdepends=(bubblewrap)
options=('!strip' '!debug')
source=(cachy-asahi-support support_bundle.py doctor.py session_probe.py check_package.py test_package.py collect_support.py collect-support.md fixtures.json README.md support-bundle.md source-provenance.json payload-map.json NOTICE LICENSE)
sha256sums=(77e7274fb6caf4e72ee1d5379f471a209559a04c11fbb5b4b44badec027ac39c 2fff76ad4df036f383927381b0b56c89904c3087f7ca151902ba80fb8c82bdc8 ddd8c3cedc5ba1291dcdd2d1d7a188e5b4d4a4ac7323ffe6f7ee554f6687d41e 9c5c41899cd991b0de4bf8d30bad6f5452b4592ea9440df0f0b4a7b54bc66984 a235ce5e604888fa56809c5b4f3ca865e193928a2891e906ca6712fcb8edfb2d 57b8af4c89495de29294eb563e5a9d76d940ed9b2a89883cd375edaf1ce6da13 2116e931e91ceed87627eeeb1acec2da1158a523c7c2f71fc2f4b4b41936159e 40ef80020a2ad5648c0161c14e6488bd5bcc8cb2b55bce157cd9998fadd40492 ead5a42fa26d2e2f9e559e0160ed348e65fcc9754c3cf62c736f4f3b36627cc8 2cc7b0f3bcf1486f24635965fbf679e660d541421bc6bf22f1cf01fa84bfb0db 575f0796883ed810d4480029a58a95e23cf9ee8fda7b67dd03719972d494c491 4b9d283c1f30c6a671ba153ff92b63ad7b1d22e7a59a8cfd7c5944675673ce5c 02504600fedc0deb6d4ce1cf4fcb6f7ff150097535241b39dcfb98a400bf3252 9285e58100c77e1c6c8599e28b33bbf69e333fe432d0740bf7a772cb51a2e680 51a352b3e94757560538ca5866bef929de5ec4864e5893fc635f291f7a5926c7)

check() {
    python -I -B "$srcdir/check_package.py" --recipe-root "$startdir" || return
    python -I -B -Werror::ResourceWarning "$srcdir/test_package.py" --recipe-root "$startdir"
}

package() {
    [[ -n ${pkgdir:-} && $pkgdir != / ]] || return 1
    install -Dm755 "$srcdir/cachy-asahi-support" "$pkgdir/usr/bin/cachy-asahi-support" || return
    install -Dm644 "$srcdir/doctor.py" "$pkgdir/usr/lib/cachy-asahi/support/packages/tools/cachy-asahi-doctor2/cachy-asahi-doctor" || return
    install -Dm644 "$srcdir/session_probe.py" "$pkgdir/usr/lib/cachy-asahi/support/scripts/hardware/session_probe.py" || return
    install -Dm644 "$srcdir/collect_support.py" "$pkgdir/usr/lib/cachy-asahi/support/scripts/support/collect_support.py" || return
    install -Dm644 "$srcdir/support_bundle.py" "$pkgdir/usr/lib/cachy-asahi/support/scripts/support/support_bundle.py" || return
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/cachy-asahi-support/README.md" || return
    install -Dm644 "$srcdir/collect-support.md" "$pkgdir/usr/share/doc/cachy-asahi-support/collect-support.md" || return
    install -Dm644 "$srcdir/payload-map.json" "$pkgdir/usr/share/doc/cachy-asahi-support/payload-map.json" || return
    install -Dm644 "$srcdir/source-provenance.json" "$pkgdir/usr/share/doc/cachy-asahi-support/source-provenance.json" || return
    install -Dm644 "$srcdir/support-bundle.md" "$pkgdir/usr/share/doc/cachy-asahi-support/support-bundle.md" || return
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/cachy-asahi-support/LICENSE" || return
    install -Dm644 "$srcdir/NOTICE" "$pkgdir/usr/share/licenses/cachy-asahi-support/NOTICE" || return
}
