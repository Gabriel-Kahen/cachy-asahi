# Original planner with exact three-helper installed runtime dependency.
pkgname=cachy-asahi-apps
pkgver=0.1.0
pkgrel=6
pkgdesc='Offline signed ARM development application catalog and explicit readonly package plans'
arch=('any')
url='https://github.com/Gabriel-Kahen/cachy-asahi'
license=('MIT')
depends=('python>=3.11' 'gnupg' 'libarchive' 'pacman' 'cachy-asahi-repository-runtime=0.1.0-1')
source=('apps.py' 'cachy-asahi-apps' 'helper-pins.json' 'test_apps.py' 'check_source.py' 'README.md' 'source-provenance.json' 'NOTICE' 'LICENSE' 'prepare-check-inputs.py' 'check-inputs.json' 'check-inputs.tar.gz' 'inventory.py')
noextract=('check-inputs.tar.gz')
