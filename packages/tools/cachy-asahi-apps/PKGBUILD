# Original planner with exact three-helper installed runtime dependency.
pkgname=cachy-asahi-apps
pkgver=0.1.0
pkgrel=2
pkgdesc='Offline signed ARM development application catalog and explicit readonly package plans'
arch=('any')
url='https://github.com/Gabriel-Kahen/cachy-asahi'
license=('MIT')
depends=('python>=3.11' 'gnupg' 'libarchive' 'pacman' 'cachy-asahi-repository-runtime=0.1.0-1')
source=('apps.py' 'cachy-asahi-apps' 'helper-pins.json' 'test_apps.py' 'check_source.py' 'README.md' 'source-provenance.json' 'NOTICE' 'LICENSE' 'prepare-check-inputs.py' 'check-inputs.json' 'check-inputs.tar.gz')
noextract=('check-inputs.tar.gz')
sha256sums=(
    'e9e59528007dc315e2ee4a0f742a324e0c23d1932e008ac03d579cda8554535b'
    '4e9c078c2e05cc00cb6479d5fff23b92cbcabd8d6b3ff970f6181e6467921630'
    '33a5e11e6d12df984e07c437c68ee581527cc4c95f3327bc44cbc09e0e29948a'
    '6b6eebd31a552f7b9b987eec858012866bcafb5dd09a64655c051c4c11dd0ea1'
    '860c61c337dcb2738c5c80604a630690ba5b36880282d5076c3a7d7325623229'
    'bc0f120503f73ed69ebd2b53d77317735628a599a03d16567a4a5e3067da429e'
    'f244dd02f411c028bc9ad9d4196f655851f6b92697dab054da02316e2dbefe7e'
    '412e8a466d1f53fd69026960453d536c234be46655713746de2c3ca9f4d59439'
    '51a352b3e94757560538ca5866bef929de5ec4864e5893fc635f291f7a5926c7'
    '76bc1977cf402872816a430156541c0ccd41273e9080730d2ace7838ffa74214'
