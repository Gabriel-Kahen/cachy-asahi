check() {
    python -I -B "$srcdir/prepare-check-inputs.py" \
        --archive "$srcdir/check-inputs.tar.gz" --index "$srcdir/check-inputs.json" --output "$srcdir/check-inputs" || return
    local source="${CACHY_ASAHI_REPOSITORY_SOURCE:-$srcdir/check-inputs/repository}"
    local runtime="${CACHY_ASAHI_RUNTIME_RECIPE:-$srcdir/check-inputs/runtime-recipe}"
    python -I -B "$srcdir/check_source.py" --recipe-root "$startdir" --repository-source "$source" || return
    python -I -B "$srcdir/test_apps.py" --repository-source "$source" --runtime-recipe-root "$runtime" --app-recipe-root "$startdir"
}
package() {
    [[ -n $pkgdir && $pkgdir != / ]] || return 1
    install -Dm755 "$srcdir/cachy-asahi-apps" "$pkgdir/usr/bin/cachy-asahi-apps" || return
    install -Dm644 "$srcdir/inventory.py" "$pkgdir/usr/lib/cachy-asahi-apps/inventory.py" || return
    install -Dm644 "$srcdir/apps.py" "$pkgdir/usr/lib/cachy-asahi-apps/apps.py" || return
    install -Dm644 "$srcdir/helper-pins.json" "$pkgdir/usr/lib/cachy-asahi-apps/helper-pins.json" || return
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md" || return
    install -Dm644 "$srcdir/source-provenance.json" "$pkgdir/usr/share/doc/$pkgname/source-provenance.json" || return
    install -Dm644 "$srcdir/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE" || return
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
