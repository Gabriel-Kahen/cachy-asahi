+def run_state(root_fd):
+    value = number(root_fd, 'run', required=True)
+    if value not in STATES:
+        raise Error('unknown KSM run state')
+    return value
+
+
+def status(root):
+    fd = directory(root)
+    try:
+        return run_state(fd)
+    finally:
+        os.close(fd)
+
+
+def mib(value, scale):
+    with localcontext() as context:
+        context.prec = 80
+        text = format(Decimal(value) * scale / 1048576, 'f')
+    return text.rstrip('0').rstrip('.') if '.' in text else text
+
+
+def report(root, page_size=None):
+    if page_size is None:
+        try:
+            page_size = os.sysconf('SC_PAGE_SIZE')
+        except (OSError, ValueError):
+            raise Error('runtime page size unavailable') from None
+    if type(page_size) is not int or not 0 < page_size <= 1048576:
+        raise Error('invalid runtime page size')
+    fd = directory(root)
+    try:
+        state = run_state(fd)
+        counters = {}
+        for name, unit in UNITS.items():
+            value = number(fd, name)
+            counters[name] = {'value': value, 'unit': unit,
+                'mib': mib(value, page_size if unit == 'pages' else 1)
+                if value is not None and unit != 'scans' else None}
+    finally:
+        os.close(fd)
+    return {'tool': 'cachy-asahi-ksmctl', 'version': VERSION, 'mode': 'read-only',
+            'page_size_bytes': page_size, 'state': {'run': state, 'description': STATES[state]},
+            'counters': counters, 'management_available': False,
+            'sample_note': 'Counters are sampled independently, not an atomic kernel snapshot.'}
+
+
+def main(argv=None, root=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    action = parser.add_mutually_exclusive_group()
+    action.add_argument('--status', '-s', action='store_true', help='show the observed run state (default)')
+    action.add_argument('--report', '-r', action='store_true', help='show counters and runtime page-size conversions')
+    parser.add_argument('--json', action='store_true', help='print a machine-readable result')
+    parser.add_argument('--version', action='version', version=f'cachy-asahi-ksmctl {VERSION}')
+    args = parser.parse_args(argv)
+    try:
+        if args.report:
+            data = report(DEFAULT_ROOT if root is None else root)
+        else:
+            value = status(DEFAULT_ROOT if root is None else root)
+            data = {'tool': 'cachy-asahi-ksmctl', 'version': VERSION, 'mode': 'read-only',
+                    'state': {'run': value, 'description': STATES[value]}, 'management_available': False}
+        if args.json:
+            print(json.dumps(data, sort_keys=True, allow_nan=False))
+        else:
+            print(f"KSM run={data['state']['run']}: {data['state']['description']}")
+            if args.report:
+                print(f"Runtime page size: {data['page_size_bytes']} bytes")
+                for name, counter in data['counters'].items():
+                    value = 'unavailable' if counter['value'] is None else f"{counter['value']} {counter['unit']}"
+                    converted = '' if counter['mib'] is None else f" ({counter['mib']} MiB)"
+                    print(f'{name}: {value}{converted}')
+                print(data['sample_note'])
+        return 0
+    except Error as error:
+        print(f'cachy-asahi-ksmctl: {error}', file=sys.stderr)
+        return error.code
+
+
+if __name__ == '__main__':
+    sys.exit(main())
