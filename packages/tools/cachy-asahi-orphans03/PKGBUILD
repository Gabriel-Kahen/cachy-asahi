check() {
    python -I -B "$srcdir/check_source.py" --recipe "$startdir/PKGBUILD" || return
    python -B "$srcdir/test_orphans.py" || return
    python -B "$srcdir/test_remove.py" || return
    python -B "$srcdir/test_retirement.py" || return
    python -B "$srcdir/test_live_policy.py" || return
    python -B "$srcdir/test_live.py" || return
    python -B "$srcdir/test_live_supervision.py" || return
    python -B "$srcdir/orphans3" remove --help >/dev/null
}

package() {
    [[ -n $pkgdir && $pkgdir != / ]] || return 1
    local base="$pkgdir/usr/lib/cachy-asahi-orphans3"
    install -Dm755 "$srcdir/orphans3" "$pkgdir/usr/bin/cachy-asahi-orphans" || return
    install -Dm644 "$srcdir/remove.py" "$base/remove.py" || return
    install -Dm644 "$srcdir/live.py" "$base/live.py" || return
    install -Dm644 "$srcdir/live_policy.py" "$base/live_policy.py" || return
    install -Dm644 "$srcdir/cachy-asahi-orphans" "$base/readonly.py" || return
    install -Dm644 "$srcdir/protection-floor.json" "$base/protection-floor.json" || return
    install -Dm644 "$srcdir/protection-floor.json" "$pkgdir/usr/share/$pkgname/protection-floor.json" || return
    local file
    for file in README.md READONLY.md source-provenance.json; do
        install -Dm644 "$srcdir/$file" "$pkgdir/usr/share/doc/$pkgname/$file" || return
    done
    for file in NOTICE LICENSE; do
        install -Dm644 "$srcdir/$file" "$pkgdir/usr/share/licenses/$pkgname/$file" || return
    done
}
