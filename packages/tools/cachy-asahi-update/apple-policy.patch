 # update.sh: Update packages and state files
 # https://github.com/Antiz96/arch-update
 # SPDX-License-Identifier: GPL-3.0-or-later
+# Modified 2026-10-11 by cachy-asahi contributors: require caller-pinned Apple transition preflight before repository, AUR or Flatpak updates.
+
+# Fail before pacman: projected protected package/module state must match a
+# caller-pinned transition. Coordinated platform changes need a separate path.
+if [[ -n "${packages:-}${aur_packages:-}${flatpak_packages:-}" ]]; then
+	# Read-only inputs must be collected and pinned by a trusted release caller.
+	# This helper does not establish their origin or hardware/update acceptance.
+	apple_policy_helper="${CACHY_ASAHI_POLICY_HELPER:-/usr/lib/cachy-asahi-update/asahi-policy}"
+	apple_policy_args=(--policy "${CACHY_ASAHI_POLICY_FILE:-}"
+		--policy-sha256 "${CACHY_ASAHI_POLICY_SHA256:-}"
+		--observations "${CACHY_ASAHI_PRE_OBSERVATION_FILE:-}"
+		--observations-sha256 "${CACHY_ASAHI_PRE_OBSERVATION_SHA256:-}")
+	if [[ ! -x "${apple_policy_helper}" ]]; then
+		warning_msg "$(eval_gettext "Apple platform policy is unconfigured; no operation is authorized")"
+		exit 21
+	fi
+	apple_operations=()
+	[[ -n "${packages:-}" ]] && apple_operations+=(repository-update)
+	[[ -n "${aur_packages:-}" ]] && apple_operations+=(aur-update)
+	[[ -n "${flatpak_packages:-}" ]] && apple_operations+=(flatpak-update)
+	for apple_operation in "${apple_operations[@]}"; do
+		apple_decision=$("${apple_policy_helper}" transaction "${apple_policy_args[@]}" --operation "${apple_operation}" --token)
+		apple_status=$?
+		if [[ "${apple_status}" != 0 ]]; then
+			warning_msg "$(eval_gettext "Apple platform policy is unconfigured, invalid, or requires coordinated handling")"
+			exit "${apple_status}"
+		fi
+		if ! [[ "${apple_decision}" == transaction-allowed ]]; then
+			error_msg "$(eval_gettext "Unexpected Apple platform policy decision")"
+			exit 23
+		fi
+	done
+fi
 
 if [ -n "${packages}" ]; then
 	echo
