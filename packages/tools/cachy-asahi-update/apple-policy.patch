 # full_upgrade.sh: Execute the series of relevant functions / libraries to perform a complete and proper update of the system
 # https://github.com/Antiz96/arch-update
 # SPDX-License-Identifier: GPL-3.0-or-later
+# Modified 2026-10-11 by cachy-asahi contributors: require all-stage Apple preflight and always evaluate post-update module policy.
 # Modified 2026-10-11 by cachy-asahi contributors: use exclusive private runtime append locking with path validation.
+
+# Mandatory preflight precedes discovery, update, orphan and cache stages.
+# The caller must authenticate actual/prospective data and the repository origin;
+# JSON digests alone do not bind a later pacman/AUR rolling-repository transaction.
+apple_policy_helper="${CACHY_ASAHI_POLICY_HELPER:-/usr/lib/cachy-asahi-update/asahi-policy}"
+apple_policy_args=(--policy "${CACHY_ASAHI_POLICY_FILE:-}"
+	--policy-sha256 "${CACHY_ASAHI_POLICY_SHA256:-}"
+	--observations "${CACHY_ASAHI_PRE_OBSERVATION_FILE:-}"
+	--observations-sha256 "${CACHY_ASAHI_PRE_OBSERVATION_SHA256:-}")
+if [[ ! -x "${apple_policy_helper}" ]]; then
+	warning_msg "$(eval_gettext "Apple platform policy is unconfigured; full upgrade is blocked")"
+	exit 21
+fi
+apple_operations=(repository-update orphan-removal package-cache-removal)
+[[ -n "${aur_helper:-}" ]] && apple_operations+=(aur-update)
+[[ -n "${flatpak_support:-}" ]] && apple_operations+=(flatpak-update flatpak-unused-removal)
+for apple_operation in "${apple_operations[@]}"; do
+	apple_decision=$("${apple_policy_helper}" transaction "${apple_policy_args[@]}" --operation "${apple_operation}" --token)
+	apple_status=$?
+	if [[ "${apple_status}" != 0 ]]; then
+		warning_msg "$(eval_gettext "Apple platform policy is unconfigured, invalid, or requires coordinated handling")"
+		exit "${apple_status}"
+	fi
+	if ! [[ "${apple_decision}" == transaction-allowed ]]; then
+		error_msg "$(eval_gettext "Unexpected Apple platform policy decision")"
+		exit 23
+	fi
+done
 
