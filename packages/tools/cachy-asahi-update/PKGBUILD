# Closed observations only; reporting never replaces the recipe's status.
_makepkg_phase() {
    if [[ ${CACHY_ASAHI_MAKEPKG_DIAGNOSTIC:-} == 1 ]]; then
        /usr/bin/python /inputs/recipe/worker-diagnostic.py --makepkg-phase "$@" >/dev/null 2>&1 || :
    fi
    return 0
}

_makepkg_exit() {
    local phase=$1 code=$2
    _makepkg_phase "$phase" return "$code"
    return "$code"
}

_makepkg_phase recipe-load enter null

prepare() {
    _makepkg_phase prepare enter null
    local tree="$srcdir/cachy-update-e2b1b7144be71cf392809f48d1440f8da1d9c81a"
    cp -a "$tree" "$srcdir/unpatched-source" || { _makepkg_exit prepare "$?"; return; }
    patch --batch --forward --fuzz=0 -d "$tree" -p1 < "$srcdir/behavior.patch" || { _makepkg_exit prepare "$?"; return; }
    patch --batch --forward --fuzz=0 -d "$tree" -p1 < "$srcdir/apple-policy.patch" || { _makepkg_exit prepare "$?"; return; }
    export CARGO_HOME="$srcdir/cargo-home"
    install -dm700 "$CARGO_HOME" || { _makepkg_exit prepare "$?"; return; }
    printf '[source.crates-io]\nreplace-with = "vendored-sources"\n[source.vendored-sources]\ndirectory = "%s/vendor"\n' "$srcdir" > "$CARGO_HOME/config.toml" || { _makepkg_exit prepare "$?"; return; }
    _makepkg_exit prepare 0
}

# Observe real worker identity while the package shell retains fakeroot.
_review_python() (
    unset "${!LD_@}" FAKEROOTKEY || return
    exec /usr/bin/python -I -B "$@"
)

_review_gate() {
    local tree="$srcdir/cachy-update-e2b1b7144be71cf392809f48d1440f8da1d9c81a"
    _review_python /inputs/recipe/build-gate.py \
        --metadata /out/target-metadata/cargo-metadata.stdout \
        --worker /out/target-metadata/worker.json \
        --cfg /out/target-metadata/target-cfg.stdout \
        --manifest "$tree/src/tray/Cargo.toml" --lock "$tree/src/tray/Cargo.lock" \
        --cargo-audit /inputs/recipe/cargo-audit.json --vendor "$srcdir/vendor" \
        --build-script-review /inputs/recipe/build-script-review.json \
        --additional-licenses /inputs/recipe/additional-cargo-licenses.json \
        --controller-input /inputs/controller-input.json \
        --controller-input-sha256 "${CACHY_ASAHI_CONTROLLER_SHA256:?trusted controller digest required}" || return
    python /inputs/recipe/verify-updater.py --source "$tree"
}

build() {
    _makepkg_phase build enter null
    local tree="$srcdir/cachy-update-e2b1b7144be71cf392809f48d1440f8da1d9c81a"
    python /inputs/recipe/worker-build.py --manifest "$tree/src/tray/Cargo.toml" \
        --vendor "$srcdir/vendor" --cargo-audit /inputs/recipe/cargo-audit.json || { _makepkg_exit build "$?"; return; }
    python /inputs/recipe/verify-updater.py --source "$tree" || { _makepkg_exit build "$?"; return; }
    cd "$tree" || { _makepkg_exit build "$?"; return; }
    # The worker retains the actual compiled tray in the Makefile's expected path.
    # Generate manuals/translations without invoking Cargo a second time.
    make WITH_TRAY=false || { _makepkg_exit build "$?"; return; }
    _makepkg_exit build 0
}

check() {
    _makepkg_phase check enter null
    _review_gate || { _makepkg_exit check "$?"; return; }
    python /inputs/recipe/test-patches.py --source "$srcdir/unpatched-source" -v || { _makepkg_exit check "$?"; return; }
    python /inputs/recipe/test-asahi-policy.py --source "$srcdir/unpatched-source" -v || { _makepkg_exit check "$?"; return; }
    export HOME="$srcdir/check-home" XDG_RUNTIME_DIR="$srcdir/check-runtime"
    export XDG_CONFIG_HOME="$srcdir/check-config" XDG_DATA_HOME="$srcdir/check-data"
    export XDG_STATE_HOME="$srcdir/check-state" XDG_DATA_DIRS="$srcdir/check-data"
    install -dm700 "$HOME" "$XDG_RUNTIME_DIR" "$XDG_CONFIG_HOME/arch-update" "$XDG_DATA_HOME" "$XDG_STATE_HOME" || { _makepkg_exit check "$?"; return; }
    printf 'NoAUR\nNoFlatpak\nNoALHPCheck\nNoNotification\n' > "$XDG_CONFIG_HOME/arch-update/arch-update.conf" || { _makepkg_exit check "$?"; return; }
    cd "$srcdir/cachy-update-e2b1b7144be71cf392809f48d1440f8da1d9c81a" || { _makepkg_exit check "$?"; return; }
    make test || { _makepkg_exit check "$?"; return; }
    python /inputs/recipe/build-gate.py --elf src/tray/target/release/arch-update-tray || { _makepkg_exit check "$?"; return; }
    _makepkg_exit check 0
}

package() {
    _makepkg_phase package enter null
    _review_gate || { _makepkg_exit package "$?"; return; }
    cd "$srcdir/cachy-update-e2b1b7144be71cf392809f48d1440f8da1d9c81a" || { _makepkg_exit package "$?"; return; }
    python /inputs/recipe/build-gate.py --elf src/tray/target/release/arch-update-tray || { _makepkg_exit package "$?"; return; }
    make PREFIX=/usr DESTDIR="$pkgdir" WITH_TRAY=true install || { _makepkg_exit package "$?"; return; }
    ln -s arch-update "$pkgdir/usr/bin/cachy-asahi-update" || { _makepkg_exit package "$?"; return; }
    install -Dm755 /inputs/recipe/asahi-policy.py "$pkgdir/usr/lib/cachy-asahi-update/asahi-policy" || { _makepkg_exit package "$?"; return; }
    # Upstream icon installation uses 0664; normalize to ordinary root-owned data.
    chmod 644 "$pkgdir"/usr/share/icons/hicolor/scalable/apps/cachy-update*.svg || { _makepkg_exit package "$?"; return; }
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE" || { _makepkg_exit package "$?"; return; }
    install -Dm644 /inputs/recipe/ICON-LICENSE "$pkgdir/usr/share/licenses/$pkgname/ICON-LICENSE" || { _makepkg_exit package "$?"; return; }
    install -Dm644 /inputs/recipe/ICON-LICENSE "$pkgdir/usr/share/licenses/$pkgname/PROJECT-MIT" || { _makepkg_exit package "$?"; return; }
    install -Dm644 /inputs/recipe/NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE" || { _makepkg_exit package "$?"; return; }
    python /inputs/recipe/verify-updater.py --materialize-notices "$srcdir/verified-LICENSES" || { _makepkg_exit package "$?"; return; }
    cp -r "$srcdir/verified-LICENSES" "$pkgdir/usr/share/licenses/$pkgname/cargo" || { _makepkg_exit package "$?"; return; }
    install -Dm644 /inputs/recipe/README.md "$pkgdir/usr/share/doc/$pkgname/README.md" || { _makepkg_exit package "$?"; return; }
    local evidence
    for evidence in source-audit.json cargo-audit.json additional-cargo-licenses.json build-policy.json; do
        install -Dm644 "/inputs/recipe/$evidence" "$pkgdir/usr/share/doc/$pkgname/$evidence" || { _makepkg_exit package "$?"; return; }
    done
    # No /etc/xdg/autostart, install hooks, timer/service enablement or host updates.
    _makepkg_exit package 0
}

_makepkg_phase recipe-load return 0
