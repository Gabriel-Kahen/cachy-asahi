prepare() {
    local tree="$srcdir/cachy-update-e2b1b7144be71cf392809f48d1440f8da1d9c81a"
    cp -a "$tree" "$srcdir/unpatched-source" || return
    patch --batch --forward --fuzz=0 -d "$tree" -p1 < "$srcdir/behavior.patch" || return
    patch --batch --forward --fuzz=0 -d "$tree" -p1 < "$srcdir/apple-policy.patch" || return
    export CARGO_HOME="$srcdir/cargo-home"
    install -dm700 "$CARGO_HOME" || return
    printf '[source.crates-io]\nreplace-with = "vendored-sources"\n[source.vendored-sources]\ndirectory = "%s/vendor"\n' "$srcdir" > "$CARGO_HOME/config.toml" || return
}

_review_gate() {
    local tree="$srcdir/cachy-update-e2b1b7144be71cf392809f48d1440f8da1d9c81a"
    python /inputs/recipe/build-gate.py \
        --metadata /out/target-metadata/cargo-metadata.stdout \
        --worker /out/target-metadata/worker.json \
        --cfg /out/target-metadata/target-cfg.stdout \
        --manifest "$tree/src/tray/Cargo.toml" --lock "$tree/src/tray/Cargo.lock" \
        --cargo-audit /inputs/recipe/cargo-audit.json --vendor "$srcdir/vendor" \
        --build-script-review /inputs/recipe/build-script-review.json \
        --additional-licenses /inputs/recipe/additional-cargo-licenses.json \
        --controller-input /inputs/controller-input.json \
        --controller-input-sha256 "${CACHY_ASAHI_CONTROLLER_SHA256:?trusted controller digest required}" || return
    python /inputs/recipe/verify-updater.py --source "$tree"
}

build() {
    local tree="$srcdir/cachy-update-e2b1b7144be71cf392809f48d1440f8da1d9c81a"
    python /inputs/recipe/worker-build.py --manifest "$tree/src/tray/Cargo.toml" \
        --vendor "$srcdir/vendor" --cargo-audit /inputs/recipe/cargo-audit.json || return
    python /inputs/recipe/verify-updater.py --source "$tree" || return
    cd "$tree" || return
    # The worker retains the actual compiled tray in the Makefile's expected path.
    # Generate manuals/translations without invoking Cargo a second time.
    make WITH_TRAY=false
}

check() {
    _review_gate || return
    python /inputs/recipe/test-patches.py --source "$srcdir/unpatched-source" -v || return
    python /inputs/recipe/test-asahi-policy.py --source "$srcdir/unpatched-source" -v || return
    export HOME="$srcdir/check-home" XDG_RUNTIME_DIR="$srcdir/check-runtime"
    export XDG_CONFIG_HOME="$srcdir/check-config" XDG_DATA_HOME="$srcdir/check-data"
    export XDG_STATE_HOME="$srcdir/check-state" XDG_DATA_DIRS="$srcdir/check-data"
    install -dm700 "$HOME" "$XDG_RUNTIME_DIR" "$XDG_CONFIG_HOME/arch-update" "$XDG_DATA_HOME" "$XDG_STATE_HOME" || return
    printf 'NoAUR\nNoFlatpak\nNoALHPCheck\nNoNotification\n' > "$XDG_CONFIG_HOME/arch-update/arch-update.conf" || return
    cd "$srcdir/cachy-update-e2b1b7144be71cf392809f48d1440f8da1d9c81a" || return
    make test || return
    python /inputs/recipe/build-gate.py --elf src/tray/target/release/arch-update-tray
}

package() {
    _review_gate || return
    cd "$srcdir/cachy-update-e2b1b7144be71cf392809f48d1440f8da1d9c81a" || return
    python /inputs/recipe/build-gate.py --elf src/tray/target/release/arch-update-tray || return
    make PREFIX=/usr DESTDIR="$pkgdir" WITH_TRAY=true install || return
    ln -s arch-update "$pkgdir/usr/bin/cachy-asahi-update" || return
    install -Dm755 /inputs/recipe/asahi-policy.py "$pkgdir/usr/lib/cachy-asahi-update/asahi-policy" || return
    # Upstream icon installation uses 0664; normalize to ordinary root-owned data.
    chmod 644 "$pkgdir"/usr/share/icons/hicolor/scalable/apps/cachy-update*.svg || return
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE" || return
    install -Dm644 /inputs/recipe/ICON-LICENSE "$pkgdir/usr/share/licenses/$pkgname/ICON-LICENSE" || return
    install -Dm644 /inputs/recipe/ICON-LICENSE "$pkgdir/usr/share/licenses/$pkgname/PROJECT-MIT" || return
    install -Dm644 /inputs/recipe/NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE" || return
    python /inputs/recipe/verify-updater.py --materialize-notices "$srcdir/verified-LICENSES" || return
    cp -r "$srcdir/verified-LICENSES" "$pkgdir/usr/share/licenses/$pkgname/cargo" || return
    install -Dm644 /inputs/recipe/README.md "$pkgdir/usr/share/doc/$pkgname/README.md" || return
    local evidence
    for evidence in source-audit.json cargo-audit.json additional-cargo-licenses.json build-policy.json; do
        install -Dm644 "/inputs/recipe/$evidence" "$pkgdir/usr/share/doc/$pkgname/$evidence" || return
    done
    # No /etc/xdg/autostart, install hooks, timer/service enablement or host updates.
}
