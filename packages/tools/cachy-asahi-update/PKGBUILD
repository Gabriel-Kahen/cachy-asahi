# DEVELOPMENT: builds require fresh, bounded native worker metadata and review.
pkgname=cachy-asahi-update
pkgver=4.4.2
pkgrel=1
pkgdesc='Development Cachy-update fork with compiled tray; Apple updates unaccepted'
url='https://github.com/Gabriel-Kahen/cachy-asahi'
arch=('aarch64')
license=('GPL-3.0-or-later' 'MIT')
depends=('coreutils' 'bash' 'systemd' 'pacman' 'pacman-contrib' 'archlinux-contrib' 'curl'
         'fakeroot' 'util-linux' 'htmlq' 'diffutils' 'hicolor-icon-theme'
         'glibc' 'libgcc' 'glib2' 'gettext' 'xdg-utils' 'python')
makedepends=('rust' 'scdoc' 'git' 'pkgconf' 'python')
checkdepends=('bats')
conflicts=('arch-update' 'cachy-update')
optdepends=('libnotify: optional explicit desktop notifications'
            'sudo: optional explicit privilege elevation'
            'vim: optional pacdiff editor')
source=(
    'cachy-update-e2b1b7144be71cf392809f48d1440f8da1d9c81a-sanitized.tar.gz'
    'cachy-update-vendor.tar.gz'
    'README.md'
    'NOTICE'
    'ICON-LICENSE'
    'source-audit.json'
    'cargo-audit.json'
    'additional-cargo-licenses.json'
    'build-policy.json'
    'build-gate.py'
    'behavior.patch'
    'test-upstream.py'
    'test-patches.py'
    'apple-policy.patch'
    'asahi-policy.py'
    'test-asahi-policy.py'
    'worker-build.py'
    'worker-metadata.py'
    'worker-diagnostic.py'
    'linux-closure.py'
    'build-script-review.json'
    'verify-updater.py'
    'patched-source-ledger.json'
)
