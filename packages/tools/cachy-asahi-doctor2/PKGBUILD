check() {
    python -B -Werror::ResourceWarning "$srcdir/test_doctor.py"
    python -B -Werror::ResourceWarning "$srcdir/test_audio.py"
    python -B -Werror::ResourceWarning "$srcdir/test_comparison.py"
}

package() {
    install -Dm755 "$srcdir/cachy-asahi-doctor" "$pkgdir/usr/bin/cachy-asahi-doctor"
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$srcdir/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
