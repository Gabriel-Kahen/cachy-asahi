pkgname=cachy-asahi-repository-client-v3
pkgver=0.1.0
pkgrel=1
pkgdesc='Maintained offline development client with bound private checkpoint state'
arch=('any')
url='https://github.com/Gabriel-Kahen/cachy-asahi'
license=('MIT')
depends=('python>=3.11' 'cachy-asahi-repository-runtime=0.1.0-1')
source=('client_v3.py' 'cachy-asahi-repository-client' 'helper-pins.json' 'source-provenance.json' 'check_source.py' 'test_state_binding_v3.py' 'state-binding-before-v2.py.txt' 'test_package.py' 'README.md' 'NOTICE' 'LICENSE')
sha256sums=(
    '4cf428452d08ea212d8bb92d899329f3445d15877c5b79e5ff5f138b0a696e76'
    '859540def486ab1b3182f90b727056bd83004a0dc94a6d3a22a1498e500bd05f'
    '1ab94b176f798ef9d95f079e02dad803265995081e575070b1c53612fc9292b7'
    'a38d0035f2adc03bf8d5556c2eb5132f29cddcfac3e56d3a79d5f086231c47d3'
    '6dadc5ee2f014725bf584b074bee7fa155d0f41d18133ba7829ad9ddead9b808'
