check() {
    python -I -B "$srcdir/check_source.py" --recipe-root "$startdir" || return
    python -I -B "$srcdir/test_state_binding_v3.py" --client "$srcdir/client_v3.py" --before "$srcdir/state-binding-before-v2.py.txt" || return
    python -I -B "$srcdir/test_package.py" --recipe-root "$startdir" || return
}

package() {
    [[ -n $pkgdir && $pkgdir != / ]] || return 1
    install -Dm644 "$srcdir/client_v3.py" "$pkgdir/usr/share/cachy-asahi/repository-runtime/scripts/client/client_v3.py" || return
    install -Dm755 "$srcdir/cachy-asahi-repository-client" "$pkgdir/usr/bin/cachy-asahi-repository-client" || return
    local file
    for file in README.md source-provenance.json helper-pins.json; do
        install -Dm644 "$srcdir/$file" "$pkgdir/usr/share/doc/$pkgname/$file" || return
    done
    for file in NOTICE LICENSE; do
        install -Dm644 "$srcdir/$file" "$pkgdir/usr/share/licenses/$pkgname/$file" || return
    done
}
