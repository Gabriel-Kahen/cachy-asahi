pkgbase = cachy-asahi-welcome
	pkgdesc = Independent GTK3 welcome, offline guidance and read-only management checks
	pkgver = 0.1.0
	pkgrel = 8
	url = https://github.com/Gabriel-Kahen/cachy-asahi
	arch = aarch64
	license = MIT
	checkdepends = python
	makedepends = gcc
	makedepends = make
	makedepends = pkgconf
	depends = gtk3>=3.24
	depends = glib2>=2.74
	depends = at-spi2-core
	optdepends = alacritty: Terminal launch action
	optdepends = thunar: Files launch action
	optdepends = cachy-asahi-setup: optional configuration preview and recovery guidance
	optdepends = cachy-asahi-update: optional separately configured updater guidance
	optdepends = cachy-asahi-doctor: optional local observation report
	optdepends = cachy-asahi-orphans: optional installed metadata assessment
	optdepends = cachy-asahi-dns>=0.1.0-2: optional read-only stored profile discovery
	optdepends = cachy-asahi-boot-report>=0.1.0-1: optional read-only visible boot history
