prepare() {
    # makepkg stages plain local sources as symlinks. Materialize them before
    # the exact ordinary-file installer; preserve original bytes, not links.
    local _measurement_source
    install -d "$srcdir/materialized" || return
    for _measurement_source in "${source[@]}"; do
        install -m644 "$srcdir/$_measurement_source" "$srcdir/materialized/$_measurement_source" || return
    done
}

check() {
    python -I -B -Werror::ResourceWarning "$srcdir/materialized/test_package.py" --recipe-root "$startdir"
}

package() {
    [[ -n ${srcdir:-} && -n ${pkgdir:-} && $pkgdir != / && $pkgdir != "$srcdir" ]] || return 1
    python -I -B "$srcdir/materialized/assemble.py" --source "$srcdir/materialized" --prefix "$pkgdir/usr"
}
