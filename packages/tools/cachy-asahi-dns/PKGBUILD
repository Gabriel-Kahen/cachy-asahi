pkgname=cachy-asahi-dns
pkgver=0.1.0
pkgrel=1
pkgdesc='Explicit per-connection NetworkManager DNS preview and prior-setting undo'
arch=('any')
url='https://github.com/Gabriel-Kahen/cachy-asahi'
license=('MIT')
depends=('python>=3.11' 'networkmanager>=1.44')
source=('cachy-asahi-dns' 'test_dns.py' 'check_source.py' 'README.md' 'source-provenance.json' 'NOTICE' 'LICENSE')
sha256sums=(
    '86e91bee103876974c8296874c58ef9e1ea7b7e4b06c99928cda1d9f8cabca99'
    'f11a175e757e65959c2ed7902f041efb6be0becb772b34207cdd7b626ab50543'
    '74fc9aa8dbba61cfaaca9cadba5f78ea080969bb2d9a58dc38f36dde35ddd7a1'
    'c1e0c9d4ca17e48587ad0070388c0f2c05191ee2537d079a2cca84c199d0d3d0'
    '80fc23caeb1d6b87a6ca8407106359a951cc7f880442954fde7d86647dd706ad'
    '1ff77dc69e120adfacea23ac77a756ff5931b888c7535f0e2f2b928114a5873e'
    '51a352b3e94757560538ca5866bef929de5ec4864e5893fc635f291f7a5926c7'
)

check() {
    python -I -B "$srcdir/check_source.py" --recipe-root "$startdir" || return
    python -I -B -Werror::ResourceWarning "$srcdir/test_dns.py"
}

package() {
    [[ -n $pkgdir && $pkgdir != / ]] || return 1
    install -Dm755 "$srcdir/cachy-asahi-dns" "$pkgdir/usr/bin/cachy-asahi-dns" || return
    local file
    for file in README.md source-provenance.json; do
        install -Dm644 "$srcdir/$file" "$pkgdir/usr/share/doc/$pkgname/$file" || return
    done
    for file in NOTICE LICENSE; do
        install -Dm644 "$srcdir/$file" "$pkgdir/usr/share/licenses/$pkgname/$file" || return
    done
}
