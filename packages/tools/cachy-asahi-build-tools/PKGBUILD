check() {
    python -I -B -Werror::ResourceWarning "$srcdir/test_package.py" --recipe-root "$startdir"
}

package() {
    [[ -n ${srcdir:-} && ${pkgdir:-} = /* && $pkgdir != / && $pkgdir != "$srcdir" ]] || return 1
    install -Dm755 "$srcdir/cachy-asahi-build-tools" "$pkgdir/usr/bin/cachy-asahi-build-tools" || return
    install -Dm644 "$srcdir/source_cache.py" "$pkgdir/usr/lib/cachy-asahi-build-tools/trusted/scripts/maintenance/source_cache.py" || return
    install -Dm644 "$srcdir/source_delivery.py" "$pkgdir/usr/lib/cachy-asahi-build-tools/trusted/scripts/release/source_delivery.py" || return
    install -Dm644 "$srcdir/package_checks.py" "$pkgdir/usr/lib/cachy-asahi-build-tools/trusted/scripts/checks/package_checks.py" || return
    install -Dm644 "$srcdir/source_materials.py" "$pkgdir/usr/lib/cachy-asahi-build-tools/trusted/scripts/build/source_materials.py" || return
    install -Dm644 "$srcdir/import_source.py" "$pkgdir/usr/lib/cachy-asahi-build-tools/trusted/scripts/build/source-cache-local-v1/import_source.py" || return
    install -Dm644 "$srcdir/preflight.py" "$pkgdir/usr/lib/cachy-asahi-build-tools/trusted/scripts/build/offline-source-preflight-v1/preflight.py" || return
    local leaf
    for leaf in README.md source-provenance.json; do
        install -Dm644 "$srcdir/$leaf" "$pkgdir/usr/share/doc/$pkgname/$leaf" || return
    done
    for leaf in LICENSE NOTICE; do
        install -Dm644 "$srcdir/$leaf" "$pkgdir/usr/share/licenses/$pkgname/$leaf" || return
    done
}
