pkgname=cachy-asahi-repository-enrollment
pkgver=0.3.0
pkgrel=1
pkgdesc='Explicit repository enrollment, authenticated transitions and primary revocation quarantine'
arch=('any')
url='https://github.com/Gabriel-Kahen/cachy-asahi'
license=('MIT')
depends=('python>=3.11' 'gnupg' 'pacman' 'coreutils' 'libarchive')
checkdepends=('bubblewrap' 'util-linux')
options=('!strip' '!debug')
source=('private-source.tar.gz' 'test_release.py' 'cachy-asahi-repository-enrollment' 'test_package.py' 'README.md' 'source-provenance.json' 'payload-map.json' 'NOTICE' 'LICENSE')
sha256sums=(
    'f9513c8162656944784f3196bafee20b8c726dde0880fafc38235211e0ac83c0'
    '7ee9e693d4574c6bb11dcc927937475742b9fa7a6f8e988608532c1e1bab5f2e'
    '71add9020f77fe33964f954eae6d98ba44a2bdd14d1c7b5fede16a34cbd986bc'
    '882b6940626dcb094c94352486203b9286c5fc0fd3a9ce163054f8d9f4a79e51'
    '3668b4533762295b7a53d02a06af06477fe11e3c5f012c4a4047d2665ea38e3b'
    'f0ededffa86d79706aeebf92d33c7963c1f9a9136d267430ea1e9c097c234bdc'
    'd7c887a6d35e5560922a80b0030cac8ed74743ba3bdb3359ec1c82face9fb353'
    '19304be6bf83cfc2cccd3cfbd86d77ba802e1d10d979aa66b42d78181d7ff60e'
