check() {
    python -I -B "$srcdir/check_source.py" --recipe-root "$startdir"
}

package() {
    [[ -n $pkgdir && $pkgdir != / ]] || return 1
    local base="$pkgdir/usr/share/cachy-asahi/repository-runtime"
    install -Dm644 "$srcdir/client.py" "$base/scripts/client/client.py" || return
    install -Dm644 "$srcdir/release.py" "$base/scripts/release/release.py" || return
    install -Dm644 "$srcdir/source_delivery.py" "$base/scripts/release/source_delivery.py" || return
    local file
    for file in README.md source-provenance.json helper-pins.json; do
        install -Dm644 "$srcdir/$file" "$pkgdir/usr/share/doc/$pkgname/$file" || return
    done
    for file in NOTICE LICENSE; do
        install -Dm644 "$srcdir/$file" "$pkgdir/usr/share/licenses/$pkgname/$file" || return
    done
}
