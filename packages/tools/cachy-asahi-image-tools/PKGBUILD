check() {
    python -I -B "$srcdir/check_package.py" --recipe-root "$startdir" || return
    python -I -B -Werror::ResourceWarning "$srcdir/private/scripts/platform/test_release_image.py" || return
    python -I -B -Werror::ResourceWarning "$srcdir/private/scripts/platform/test_release_image_signed.py" || return
    python -I -B -Werror::ResourceWarning "$srcdir/private/scripts/platform/test_signed_archive_intake.py" || return
    python -I -B -Werror::ResourceWarning "$srcdir/test_package.py" --recipe-root "$startdir"
}

