MAX_SOURCE = 2 * 1024**2
FIELDS = ('st_dev', 'st_ino', 'st_mode', 'st_nlink', 'st_uid', 'st_gid',
          'st_size', 'st_mtime_ns', 'st_ctime_ns')
sys.dont_write_bytecode = True


def checked_runtime():
    """Validate the finite installed source/data set before interpreting any code."""
    if RUNTIME != RUNTIME.resolve():
        raise ValueError('private-runtime-path-symlink')
    expected_dirs = {str(parent) for name in PINS for parent in Path(name).parents if str(parent) != '.'}
    files, dirs, bodies = set(), set(), {}
    for parent, names, leaves in os.walk(RUNTIME, followlinks=False):
        directory = Path(parent)
        info = directory.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_mode & 0o022:
            raise ValueError('private-runtime-directory-mode')
        for name in names:
            node = directory / name
            rel = node.relative_to(RUNTIME).as_posix()
            if node.is_symlink() or rel not in expected_dirs:
                raise ValueError('private-runtime-directory-set')
            dirs.add(rel)
        for name in leaves:
            node = directory / name
            rel = node.relative_to(RUNTIME).as_posix()
            if rel not in PINS:
                raise ValueError('private-runtime-unexpected-member:' + rel)
            fd = os.open(node, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
            try:
                before = os.fstat(fd)
                if (not stat.S_ISREG(before.st_mode) or before.st_nlink != 1
                        or before.st_mode & 0o022 or not 0 < before.st_size <= MAX_SOURCE):
                    raise ValueError('private-runtime-member-state:' + rel)
                with os.fdopen(os.dup(fd), 'rb') as stream:
                    raw = stream.read(MAX_SOURCE + 1)
                if (len(raw) != before.st_size or any(
                        getattr(before, key) != getattr(os.fstat(fd), key)
                        or getattr(before, key) != getattr(node.lstat(), key) for key in FIELDS)
                        or hashlib.sha256(raw).hexdigest() != PINS[rel]):
                    raise ValueError('private-runtime-member-pin:' + rel)
                bodies[rel] = raw
                files.add(rel)
            finally:
                os.close(fd)
    if files != set(PINS) or dirs != expected_dirs:
        raise ValueError('private-runtime-incomplete-closure')
    return bodies


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--version', action='version', version='cachy-asahi-image-tools ' + VERSION)
    modes = parser.add_subparsers(dest='mode', required=True)
    for mode in ('plan', 'assemble', 'verify', 'resume'):
        branch = modes.add_parser(mode)
        branch.add_argument('--recipe', required=True)
        branch.add_argument('--recipe-sha256', required=True)
        if mode != 'plan':
            branch.add_argument('--output', required=True)
        if mode in ('verify', 'resume'):
            branch.add_argument('--receipt-sha256', required=True)
    args = parser.parse_args()
    resource.setrlimit(resource.RLIMIT_AS, (2*1024**3, 2*1024**3))
    resource.setrlimit(resource.RLIMIT_CPU, (300, 300))
    resource.setrlimit(resource.RLIMIT_FSIZE, (256*1024**2, 256*1024**2))
    resource.setrlimit(resource.RLIMIT_NOFILE, (256, 256))
    def expired(*_):
        raise TimeoutError('image-tools-wall600')
    signal.signal(signal.SIGALRM, expired)
    signal.alarm(600)
    try:
        raws = checked_runtime()
        path = RUNTIME / 'scripts/platform/release_image.py'
        release = types.ModuleType('_installed_image_tools')
        release.__file__ = str(path)
        exec(compile(raws['scripts/platform/release_image.py'], str(path), 'exec'), release.__dict__)
        recipe = release.decode(release.pinned(args.recipe, args.recipe_sha256))
        release.need(type(recipe) is dict and recipe.get('kind') == release.SIGNED_KIND,
                     'installed-image-tools-require-policy-signed-recipe')
        if args.mode == 'plan':
            result = release.plan(args.recipe, args.recipe_sha256)
        elif args.mode == 'assemble':
            result = release.run(args.recipe, args.recipe_sha256, args.output)
        elif args.mode == 'verify':
            result = release.verify(args.recipe, args.recipe_sha256, args.output, args.receipt_sha256)
        else:
            result = release.run(args.recipe, args.recipe_sha256, args.output, args.receipt_sha256)
        checked_runtime()
        print(json.dumps(result, sort_keys=True))
        return 0
    except (OSError, ValueError, ImportError, TimeoutError) as error:
        print('image tools refused: ' + str(error), file=sys.stderr)
        return 1
    finally:
        signal.alarm(0)


if __name__ == '__main__':
    raise SystemExit(main())
