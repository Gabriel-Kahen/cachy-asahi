# Original offline support CLI; no installation hooks or system mutation.
pkgname=cachy-asahi-support
pkgver=0.1.0
pkgrel=1
pkgdesc='Offline private support bundles from explicitly reviewed reports'
arch=(any)
url=https://github.com/Gabriel-Kahen/cachy-asahi
license=(MIT)
depends=('python>=3.11')
options=('!strip' '!debug')
source=(cachy-asahi-support support_bundle.py doctor.py session_probe.py check_package.py test_package.py fixtures.json README.md support-bundle.md source-provenance.json payload-map.json NOTICE LICENSE)
sha256sums=(d2766b1b79ddd7385cb5d8985165de5c8cf29bf2c72812f7fb120939e0d84b94 2fff76ad4df036f383927381b0b56c89904c3087f7ca151902ba80fb8c82bdc8 ddd8c3cedc5ba1291dcdd2d1d7a188e5b4d4a4ac7323ffe6f7ee554f6687d41e 9c5c41899cd991b0de4bf8d30bad6f5452b4592ea9440df0f0b4a7b54bc66984 98ac963914ef9a287546cedc0f27b2a62fce1d1c87a649efabe46d24a0a0382d 864903df403aa24ba035495b99bf12ecb2bc32c8f643564e88b653be5570740a ead5a42fa26d2e2f9e559e0160ed348e65fcc9754c3cf62c736f4f3b36627cc8 8242dddf2a52168b6ff923f399fc01066da83db75c26a857d5bef7bccc3268ff 575f0796883ed810d4480029a58a95e23cf9ee8fda7b67dd03719972d494c491 b88b6957ad4e10f56add1d246bdc578d707539600c34661b6593105d6540a73e 06c7313afcd8d63121e47941fdcef48e564df799379c4086aa12714bd57054c4 386736e756936d10fd8b71b4cf3e0e319f53b03da68df2908bf212b062e8c030 51a352b3e94757560538ca5866bef929de5ec4864e5893fc635f291f7a5926c7)

check() {
    python -I -B "$srcdir/check_package.py" --recipe-root "$startdir" || return
    python -I -B -Werror::ResourceWarning "$srcdir/test_package.py" --recipe-root "$startdir"
}

package() {
    [[ -n ${pkgdir:-} && $pkgdir != / ]] || return 1
    install -Dm755 "$srcdir/cachy-asahi-support" "$pkgdir/usr/bin/cachy-asahi-support" || return
    install -Dm644 "$srcdir/doctor.py" "$pkgdir/usr/lib/cachy-asahi/support/packages/tools/cachy-asahi-doctor2/cachy-asahi-doctor" || return
    install -Dm644 "$srcdir/session_probe.py" "$pkgdir/usr/lib/cachy-asahi/support/scripts/hardware/session_probe.py" || return
    install -Dm644 "$srcdir/support_bundle.py" "$pkgdir/usr/lib/cachy-asahi/support/scripts/support/support_bundle.py" || return
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/cachy-asahi-support/README.md" || return
    install -Dm644 "$srcdir/payload-map.json" "$pkgdir/usr/share/doc/cachy-asahi-support/payload-map.json" || return
    install -Dm644 "$srcdir/source-provenance.json" "$pkgdir/usr/share/doc/cachy-asahi-support/source-provenance.json" || return
    install -Dm644 "$srcdir/support-bundle.md" "$pkgdir/usr/share/doc/cachy-asahi-support/support-bundle.md" || return
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/cachy-asahi-support/LICENSE" || return
    install -Dm644 "$srcdir/NOTICE" "$pkgdir/usr/share/licenses/cachy-asahi-support/NOTICE" || return
}
