pkgname=cachy-asahi-source-tools
pkgver=0.5.0
pkgrel=1
pkgdesc='Offline exact release source mirrors and inert rebuild contexts'
arch=(any)
url=https://github.com/Gabriel-Kahen/cachy-asahi
license=(MIT)
depends=('python>=3.14' xz zstd)
checkdepends=(bubblewrap)
options=('!strip' '!debug')
source=(private-source.tar.gz fixtures.tar.gz cachy-asahi-source-tools check_package.py test_package.py multi_package_roundtrip.py README.md source-provenance.json payload-map.json NOTICE LICENSE test_cli_input_refusal.py source_mirror_catalog.py test_source_mirror_catalog.py source_mirror_diff.py test_source_mirror_diff.py source_context_info.py test_source_context_info.py source_release_context.py test_source_release_context.py)
sha256sums=(fa9db2ee4a6f16fee53b79494d437901570c80798de9219d2cc637b9f430575a 6e307625ad97381ec6a4efb9a0ae651ad4c38c1c88a81fc19d4e931584d468c0 64dffad2ba00de6a799f50c3845942cccf7c4083fba4ae34bbe4cfe5dd442478 436b1cbffb58d712c499584d75da2651311c7f40da675b6e7f5f19566f5a0207 43f26bb2def8a17d6df4aad13aad5e9a50c0a4316e01d789d8148d8f9c28cb7e e7a8020e5f8832c83bd0b562ea77fc087a9662b683eb420735bdc03ca25146f4 0f3a02fc9fc1d41770d30985fea99c92e7560630dc5bda83929b438da89683cf 28b2b8a2708bc3fece91d5560b17da358b59937d4afcebf5a42be28a1802b042 6d139db16280cef5e02ff818f596a59fd9abdc649ad03e10c596ce7352be6872 650d77ba3fddc940807b827b88a4f8f274a2cce5048c0e3e2a785337ca6b6bfb 51a352b3e94757560538ca5866bef929de5ec4864e5893fc635f291f7a5926c7 65b2e4b0862f1140b1044e295f8003c1de3d81ceaf3d2f6a93002ccf700b269b a5c2a7833af484ba3f29a732cdcdf8933bc271d94d65eebff5e430648e670716 0aec6e155ee156b912f5af55487df4515e54186358bcc51abac784a0c36385d7 ed2b6f81fc6c287fd0d16e24a493aa53c7a7d23da18dc9062f19dab2133c1446 3f01d06a9a55dca64d0827a9c2b4c4869c33123e654595d15d2279f32713573e 820020c28d497a73cb2cd278b19a6d77c08fee0415b2817ea8d2d4290065de7b df833d8aa62ec306508bf026cb72f254956150f7bdd50299e308a2d94f0953f5 51f01b789c55fc9d0cd026e8addaad4e891c951a92653825c4c2646b9c54438d ff98cf0870fde82423baa46b61ca5f405df9bbad8be8a68f011dddb26cfea471)

check() {
    python -I -B -Werror::ResourceWarning "$srcdir/test_cli_input_refusal.py" --recipe-root "$startdir" || return
    python -I -B -Werror::ResourceWarning "$srcdir/test_source_mirror_catalog.py" --runtime-root "$srcdir/private/scripts" --fixture-root "$srcdir/fixtures" || return
    python -I -B -Werror::ResourceWarning "$srcdir/test_source_mirror_diff.py" --runtime-root "$srcdir/private/scripts" --fixture-root "$srcdir/fixtures" || return
    python -I -B -Werror::ResourceWarning "$srcdir/test_source_context_info.py" --runtime-root "$srcdir/private/scripts" --fixture-root "$srcdir/fixtures" || return
    python -I -B -Werror::ResourceWarning "$srcdir/test_source_release_context.py" --runtime-root "$srcdir/private/scripts" --fixture-root "$srcdir/fixtures" || return
    python -I -B "$srcdir/check_package.py" --recipe-root "$startdir" || return
    python -I -B -Werror::ResourceWarning "$srcdir/test_package.py" --recipe-root "$startdir" --srcdir "$srcdir" --hide-checkout "${SOURCE_TOOLS_HIDE_ROOT:-$startdir}"
}

package() {
    [[ -n ${srcdir:-} && -n ${pkgdir:-} && $pkgdir != / && $pkgdir != "$srcdir" ]] || return 1
    install -Dm755 "$srcdir/cachy-asahi-source-tools" "$pkgdir/usr/bin/cachy-asahi-source-tools" || return
    for path in build/build_v2.py build/container-entry-v2.sh build/mirror_consumer.py build/source_materials.py checks/package_checks.py maintenance/source_cache.py release/recipe_source_delivery.py release/release_sbom.py release/release_source_mirror.py release/source_delivery.py update/archive_stream.py; do
        install -Dm644 "$srcdir/private/scripts/$path" "$pkgdir/usr/lib/cachy-asahi/source-tools/scripts/$path" || return
    done
    install -Dm644 "$srcdir/source_mirror_catalog.py" "$pkgdir/usr/lib/cachy-asahi/source-tools/scripts/release/source_mirror_catalog.py" || return
    install -Dm644 "$srcdir/source_mirror_diff.py" "$pkgdir/usr/lib/cachy-asahi/source-tools/scripts/release/source_mirror_diff.py" || return
    install -Dm644 "$srcdir/source_context_info.py" "$pkgdir/usr/lib/cachy-asahi/source-tools/scripts/release/source_context_info.py" || return
    install -Dm644 "$srcdir/source_release_context.py" "$pkgdir/usr/lib/cachy-asahi/source-tools/scripts/release/source_release_context.py" || return
    for leaf in README.md source-provenance.json payload-map.json; do
        install -Dm644 "$srcdir/$leaf" "$pkgdir/usr/share/doc/cachy-asahi-source-tools/$leaf" || return
    done
    for leaf in LICENSE NOTICE; do
        install -Dm644 "$srcdir/$leaf" "$pkgdir/usr/share/licenses/cachy-asahi-source-tools/$leaf" || return
    done
}
