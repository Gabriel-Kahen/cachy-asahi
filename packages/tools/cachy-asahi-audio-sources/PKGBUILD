pkgname=cachy-asahi-audio-sources
pkgver=0.1.0
pkgrel=1
pkgdesc='Opt-in offline finite audio source delivery and verification'
arch=(any)
url=https://github.com/Gabriel-Kahen/cachy-asahi
license=(MIT)
depends=('python>=3.12' xz)
checkdepends=(bubblewrap)
options=('!strip' '!debug')
source=(runtime-source.tar.gz cachy-asahi-audio-sources runtime-map.json check_package.py test_package.py test_archive.py README.md source-provenance.json payload-map.json LICENSE NOTICE)
sha256sums=(0b2484c47601c061d547d4281206f200ba55be0886d13f367f833b8d3a7df847 82d8f4235317533ad5c8b5650595bee7e34b661fd16af88a7dcdebdd688db7e8 cea0f3d2ef40936e679a3dedda37b44e5264732e0a6a7e0149da1ce6a75c5577 fd24d2ed268dbb764140b8762a29aa955c85d886deb4342c0fcdbfcafa8d4ebd 4e7d64dbcead7ca090b24611dd6854df778d053bd1773637badf6bb66d554a42 c647b7277879feac09298e89d9e0926a9a67f6ce27b0b9f79572968e867bf486 b4588834c8913f0e2b6fd28f645068e05d11a9e5bab589135d080685092dd5f3 c8fec799f0de92559f942c98c253e8c78e7665b2ebc98b68814248c258cf9924 567ba9cd35f2846faf7bb62ac4f6c2e74b4431d0a69ce6c998c788c002d79196 51a352b3e94757560538ca5866bef929de5ec4864e5893fc635f291f7a5926c7 8d4c7f9c2a68e8e4b2480fa8adeb890ff8d2bfd3a64d40a4f8880022cdca7f25)

check() {
    python -I -B "$srcdir/check_package.py" --recipe-root "$startdir" || return
    python -I -B -Werror::ResourceWarning "$srcdir/test_package.py" --recipe-root "$startdir" --srcdir "$srcdir" --hide-checkout "${AUDIO_SOURCES_HIDE_CHECKOUT:-$startdir}"
}

package() {
    [[ -n ${srcdir:-} && -n ${pkgdir:-} && $pkgdir != / && $pkgdir != "$srcdir" ]] || return 1
    install -Dm755 "$srcdir/cachy-asahi-audio-sources" "$pkgdir/usr/bin/cachy-asahi-audio-sources" || return
    for path in scripts/checks/package_checks.py scripts/port/platform-audio-registry-sources/join.py scripts/port/platform-audio-registry-sources/registry-inputs.json scripts/port/platform-audio-source-delivery/delivery-profile.json scripts/port/platform-audio-source-delivery/delivery.py scripts/port/platform-audio-sources/intake.py scripts/port/platform-audio-vendor-audit/audit.py scripts/release/platform_audio_source_delivery.py scripts/release/platform_audio_source_profiles.json scripts/release/source_delivery.py; do
        install -Dm644 "$srcdir/runtime/$path" "$pkgdir/usr/lib/cachy-asahi/audio-sources/$path" || return
    done
    install -Dm644 "$srcdir/runtime-map.json" "$pkgdir/usr/lib/cachy-asahi/audio-sources/runtime-map.json" || return
    for leaf in README.md source-provenance.json payload-map.json; do
        install -Dm644 "$srcdir/$leaf" "$pkgdir/usr/share/doc/cachy-asahi-audio-sources/$leaf" || return
    done
    for leaf in LICENSE NOTICE; do
        install -Dm644 "$srcdir/$leaf" "$pkgdir/usr/share/licenses/cachy-asahi-audio-sources/$leaf" || return
    done
}
