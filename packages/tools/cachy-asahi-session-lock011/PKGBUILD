pkgname=cachy-asahi-session-lock
pkgver=0.1.1
pkgrel=1
pkgdesc='Explicit and idle Wayland locking with readiness-ordered suspend requests'
arch=('any')
url='https://github.com/Gabriel-Kahen/cachy-asahi'
license=('MIT')
depends=('python>=3.11' 'swaylock>=1.8.6' 'systemd>=248' 'coreutils')
optdepends=('swayidle>=1.8.0: explicit idle-timeout locking')
options=('!strip' '!debug')
source=('cachy-asahi-session-lock' 'test_session_lock.py' 'test_idle.py' 'test_package.py' 'README.md' 'source-provenance.json' 'NOTICE' 'LICENSE')
sha256sums=(
    'd8c293ad29960dc000f825f204d53e31bae7c7fa6834a351569ac936497abdfd'
    '7f235c42e12336f3bf61e3ecead4477afe67bf3af6270d6913e0f4b123ca60d2'
    '8b918431618bd678a313f97312b324a06e396fb36d8dd4f19c79320e84995fb7'
    '5d6d83626353048e5b9bcbb6a7b99cb7dacd86633adfb26d31800c4b1b4622c1'
    '7264d90f047e75f9f7be1ed0471f3f50362acbd75da607d77d05c10cc082d712'
    '8a51acede63208b1d856479b5edae4388ba3deba246869ac59aefab6284a1e23'
    '5ae1678fe537fff2a5a0dd2f8e0b40523b55e7c9ac5acd7c3c2eab6f75b4e94e'
    '51a352b3e94757560538ca5866bef929de5ec4864e5893fc635f291f7a5926c7'
)

check() {
    python -I -B -Werror::ResourceWarning "$srcdir/test_session_lock.py" || return
    python -I -B -Werror::ResourceWarning "$srcdir/test_idle.py" || return
    python -I -B -Werror::ResourceWarning "$srcdir/test_package.py" --recipe-root "$startdir"
}

package() {
    [[ -n ${pkgdir:-} && $pkgdir != / ]] || return 1
    install -Dm755 "$srcdir/cachy-asahi-session-lock" "$pkgdir/usr/bin/$pkgname" || return
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md" || return
    install -Dm644 "$srcdir/source-provenance.json" "$pkgdir/usr/share/doc/$pkgname/source-provenance.json" || return
    local file
    for file in NOTICE LICENSE; do
        install -Dm644 "$srcdir/$file" "$pkgdir/usr/share/licenses/$pkgname/$file" || return
    done
}
