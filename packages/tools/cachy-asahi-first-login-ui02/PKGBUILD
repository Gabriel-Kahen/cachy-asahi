check() {
    FIRST_LOGIN_UI_RECIPE="$startdir/PKGBUILD" python -I -B -Werror::ResourceWarning "$srcdir/test_bridge.py"
    FIRST_LOGIN_UI_RECIPE="$startdir/PKGBUILD" python -I -B -Werror::ResourceWarning "$srcdir/test_delivery.py"
}

package() {
    install -Dm755 "$srcdir/cachy-asahi-first-login-ui" "$pkgdir/usr/bin/cachy-asahi-first-login-ui"
    for name in bridge.py gui.py; do
        install -Dm644 "$srcdir/$name" "$pkgdir/usr/lib/cachy-asahi/first-login-ui/$name"
    done
    install -Dm644 "$srcdir/io.github.GabrielKahen.CachyAsahiFirstLogin.desktop" "$pkgdir/usr/share/applications/io.github.GabrielKahen.CachyAsahiFirstLogin.desktop"
    for name in README.md source-provenance.json; do
        install -Dm644 "$srcdir/$name" "$pkgdir/usr/share/doc/$pkgname/$name"
    done
    for name in LICENSE NOTICE; do
        install -Dm644 "$srcdir/$name" "$pkgdir/usr/share/licenses/$pkgname/$name"
    done
}
