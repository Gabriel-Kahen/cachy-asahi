check() {
    python -I -B -Werror::ResourceWarning "$srcdir/check_package.py" --recipe-root "$startdir" || return
    python -I -B -Werror::ResourceWarning "$srcdir/test_package.py" --recipe-root "$startdir"
}

package() {
    [[ -n ${srcdir:-} && -n ${pkgdir:-} && $pkgdir != / && $pkgdir != "$srcdir" ]] || return 1
    install -Dm755 "$srcdir/cachy-asahi-release-tools" "$pkgdir/usr/bin/cachy-asahi-release-tools" || return
    install -Dm644 "$srcdir/endpoint__client.py" "$pkgdir/usr/lib/cachy-asahi/release-tools-v4/endpoint-current/scripts/client/client.py" || return
    install -Dm644 "$srcdir/endpoint__endpoint.py" "$pkgdir/usr/lib/cachy-asahi/release-tools-v4/endpoint-current/scripts/client/endpoint.py" || return
    install -Dm644 "$srcdir/endpoint__copy_endpoint.py" "$pkgdir/usr/lib/cachy-asahi/release-tools-v4/endpoint-current/scripts/release/endpoint_copy_v1/copy_endpoint.py" || return
    install -Dm644 "$srcdir/endpoint__dependencies.json" "$pkgdir/usr/lib/cachy-asahi/release-tools-v4/endpoint-current/scripts/release/endpoint_transport_v1/dependencies.json" || return
    install -Dm644 "$srcdir/endpoint__transport.py" "$pkgdir/usr/lib/cachy-asahi/release-tools-v4/endpoint-current/scripts/release/endpoint_transport_v1/transport.py" || return
    install -Dm644 "$srcdir/endpoint__export_repository.py" "$pkgdir/usr/lib/cachy-asahi/release-tools-v4/endpoint-current/scripts/release/export_repository.py" || return
    install -Dm644 "$srcdir/endpoint__offline_kit.py" "$pkgdir/usr/lib/cachy-asahi/release-tools-v4/endpoint-current/scripts/release/offline_kit.py" || return
    install -Dm644 "$srcdir/endpoint__release.py" "$pkgdir/usr/lib/cachy-asahi/release-tools-v4/endpoint-current/scripts/release/release.py" || return
    install -Dm644 "$srcdir/endpoint__source_delivery.py" "$pkgdir/usr/lib/cachy-asahi/release-tools-v4/endpoint-current/scripts/release/source_delivery.py" || return
    install -Dm755 "$srcdir/legacy__launcher" "$pkgdir/usr/lib/cachy-asahi/release-tools-v4/legacy-v2/bin/cachy-asahi-release-tools" || return
    install -Dm644 "$srcdir/legacy__package_checks.py" "$pkgdir/usr/lib/cachy-asahi/release-tools-v4/legacy-v2/lib/cachy-asahi/release-tools-v2/scripts/checks/package_checks.py" || return
    install -Dm644 "$srcdir/legacy__compare_sboms.py" "$pkgdir/usr/lib/cachy-asahi/release-tools-v4/legacy-v2/lib/cachy-asahi/release-tools-v2/scripts/release/compare_sboms.py" || return
    install -Dm644 "$srcdir/legacy__recipe_source_delivery.py" "$pkgdir/usr/lib/cachy-asahi/release-tools-v4/legacy-v2/lib/cachy-asahi/release-tools-v2/scripts/release/recipe_source_delivery.py" || return
    install -Dm644 "$srcdir/legacy__recipe_source_delivery_v2.py" "$pkgdir/usr/lib/cachy-asahi/release-tools-v4/legacy-v2/lib/cachy-asahi/release-tools-v2/scripts/release/recipe_source_delivery_v2.py" || return
    install -Dm644 "$srcdir/legacy__release_sbom.py" "$pkgdir/usr/lib/cachy-asahi/release-tools-v4/legacy-v2/lib/cachy-asahi/release-tools-v2/scripts/release/release_sbom.py" || return
    install -Dm644 "$srcdir/legacy__source_delivery.py" "$pkgdir/usr/lib/cachy-asahi/release-tools-v4/legacy-v2/lib/cachy-asahi/release-tools-v2/scripts/release/source_delivery.py" || return
    install -Dm644 "$srcdir/legacy__archive_stream.py" "$pkgdir/usr/lib/cachy-asahi/release-tools-v4/legacy-v2/lib/cachy-asahi/release-tools-v2/scripts/update/archive_stream.py" || return
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/cachy-asahi-release-tools/README.md" || return
    install -Dm644 "$srcdir/payload-map.json" "$pkgdir/usr/share/doc/cachy-asahi-release-tools/payload-map.json" || return
    install -Dm644 "$srcdir/source-provenance.json" "$pkgdir/usr/share/doc/cachy-asahi-release-tools/source-provenance.json" || return
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/cachy-asahi-release-tools/LICENSE" || return
    install -Dm644 "$srcdir/NOTICE" "$pkgdir/usr/share/licenses/cachy-asahi-release-tools/NOTICE" || return
}
