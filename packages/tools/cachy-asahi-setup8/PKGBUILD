prepare() {
    if [[ -f "$startdir/../../../AGENTS.md" ]]; then
        python -B "$startdir/check-sync.py" --root "$startdir/../../.."
    fi
}

check() {
    python -B "$srcdir/check-sync.py" --snapshot
    python -B -Werror::ResourceWarning "$srcdir/test_config_migrate.py" -v
    python -B -Werror::ResourceWarning "$srcdir/test_package.py" -v
    python -B "$srcdir/cachy-asahi-setup" --help >/dev/null
    python -B "$srcdir/cachy-asahi-repository" --help >/dev/null
}

package() {
    install -Dm755 "$srcdir/cachy-asahi-setup" "$pkgdir/usr/bin/cachy-asahi-setup"
    install -Dm755 "$srcdir/cachy-asahi-repository" "$pkgdir/usr/bin/cachy-asahi-repository"
    install -Dm755 "$srcdir/cachy-asahi-config-migrate" "$pkgdir/usr/bin/cachy-asahi-config-migrate"
    install -Dm644 "$srcdir/setup.py" "$pkgdir/usr/lib/cachy-asahi/setup8/setup.py"
    install -Dm644 "$srcdir/config_migrate.py" "$pkgdir/usr/lib/cachy-asahi/setup8/config_migrate.py"
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/cachy-asahi-setup/README.md"
    install -Dm644 "$srcdir/repository-enrollment.md" "$pkgdir/usr/share/doc/cachy-asahi-setup/repository-enrollment.md"
    install -Dm644 "$srcdir/configuration-migrations.md" "$pkgdir/usr/share/doc/cachy-asahi-setup/configuration-migrations.md"
    install -Dm644 "$srcdir/NOTICE" "$pkgdir/usr/share/licenses/cachy-asahi-setup/NOTICE"
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/cachy-asahi-setup/LICENSE"
}
