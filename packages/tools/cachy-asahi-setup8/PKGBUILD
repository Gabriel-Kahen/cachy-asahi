pkgname=cachy-asahi-setup
pkgver=0.3.0
pkgrel=1
pkgdesc='Explicit setup status and hash-pinned per-user configuration migration'
arch=('any')
url='https://github.com/Gabriel-Kahen/cachy-asahi'
license=('MIT')
depends=('python>=3.11' 'gnupg' 'pacman')
optdepends=('cachy-asahi-hyprland-settings: optional desktop template'
            'cachy-asahi-fish-config: optional Fish template'
            'cachy-asahi-zsh-config: optional Zsh template'
            'cachy-asahi-fish-bang-bang: explicit optional Fish history expansion'
            'cachy-asahi-fish-autopair: explicit optional Fish pairing'
            'cachy-asahi-fish-done: explicit optional Fish completion notifications'
            'cachy-asahi-zsh-autosuggestions: explicit optional Zsh history suggestions'
            'cachy-asahi-zsh-syntax-highlighting: explicit optional Zsh highlighting'
            'cachy-asahi-zsh-history-substring-search: explicit optional Zsh substring search')
