prepare() {
    if [[ -f "$startdir/../../../AGENTS.md" ]]; then
        python -B "$startdir/check-sync.py" --root "$startdir/../../.."
    fi
}

check() {
    python -I -B "$srcdir/check-sync.py"
    python -I -B -Werror::ResourceWarning "$srcdir/test_first_login.py" -v
    python -I -B -Werror::ResourceWarning "$srcdir/test_delivery.py" --recipe "$startdir/PKGBUILD" -v
}

package() {
    install -Dm755 "$srcdir/cachy-asahi-first-login" "$pkgdir/usr/bin/cachy-asahi-first-login"
    install -Dm644 "$srcdir/first_login.py" "$pkgdir/usr/lib/cachy-asahi/first-login/first_login.py"
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$srcdir/source-provenance.json" "$pkgdir/usr/share/doc/$pkgname/source-provenance.json"
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$srcdir/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
