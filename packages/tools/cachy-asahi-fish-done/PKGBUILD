check() {
    local file result
    for file in "$srcdir"/*.fish; do
        fish --no-config --no-execute "$file" || return
    done
    local fixture
    fixture=$(mktemp -d "$srcdir/done-check.XXXXXX") || return
    if python "$srcdir/check-module.py" --source "$srcdir" --output "$fixture/results"; then
        result=0
    else
        result=$?
    fi
    rm -rf -- "$fixture"
    return "$result"
}

package() {
    local file
    for file in done.fish done.upstream.fish opt-in.fish source-provenance.json; do
        install -Dm644 "$srcdir/$file" "$pkgdir/usr/share/cachy-asahi/fish-done/$file" || return
    done
    install -Dm644 "$srcdir/usage.md" "$pkgdir/usr/share/cachy-asahi/fish-done/README.md" || return
    for file in NOTICE LICENSE.upstream LICENSE.project; do
        install -Dm644 "$srcdir/$file" "$pkgdir/usr/share/licenses/$pkgname/$file" || return
    done
}
