pkgname=cachy-asahi-first-login
pkgver=0.1.0
pkgrel=2
pkgdesc='Opt-in first-login configuration discovery, activation and recovery'
arch=('any')
url='https://github.com/Gabriel-Kahen/cachy-asahi'
license=('MIT')
depends=('python>=3.11' 'cachy-asahi-setup>=0.3.0')
optdepends=('fish: Fish configuration activation'
            'zsh: Zsh configuration activation'
            'hyprland: Hyprland configuration activation'
            'cachy-asahi-fish-config: Fish template'
            'cachy-asahi-zsh-config: Zsh template'
            'cachy-asahi-hyprland-settings: Hyprland template')
source=('LICENSE' 'NOTICE' 'README.md' 'cachy-asahi-first-login' 'first_login.py'
        'setup8-fixture.py' 'test_first_login.py' 'test_delivery.py' 'check-sync.py'
        'source-provenance.json')
sha256sums=(
    '51a352b3e94757560538ca5866bef929de5ec4864e5893fc635f291f7a5926c7'
    '6aa0a8736adb815343fe56d530df8caa77605896e1eb8984c40e3cc669d86b35'
    '0beaccda9b43a67183241de740498e815e41ea8d48490353935a82d17b216d4a'
    'a5e2b72ff58eac2763c0ad65f36c0c883a60ce20e97c38acc4bace9d30a18144'
    '41ade792884afced7a078c6926d3f18d7a9e40fca50191c7d77d34678711921c'
