check() {
    local file result
    for file in "$srcdir"/*.fish; do
        fish --no-config --no-execute "$file" || return
    done
    local fixture
    fixture=$(mktemp -d "$srcdir/autopair-check.XXXXXX") || return
    if python "$srcdir/check-module.py" --source "$srcdir" --output "$fixture/results"; then
        result=0
    else
        result=$?
    fi
    rm -rf -- "$fixture"
    return "$result"
}

package() {
    local file
    for file in _autopair_backspace.fish _autopair_insert_left.fish _autopair_insert_right.fish _autopair_insert_same.fish _autopair_tab.fish opt-in.fish; do
        install -Dm644 "$srcdir/$file" "$pkgdir/usr/share/cachy-asahi/fish-autopair/$file" || return
    done
    install -Dm644 "$srcdir/usage.md" "$pkgdir/usr/share/cachy-asahi/fish-autopair/README.md" || return
    install -Dm644 "$srcdir/source-provenance.json" "$pkgdir/usr/share/cachy-asahi/fish-autopair/source-provenance.json" || return
    for file in NOTICE LICENSE.upstream LICENSE.project; do
        install -Dm644 "$srcdir/$file" "$pkgdir/usr/share/licenses/$pkgname/$file" || return
    done
}
