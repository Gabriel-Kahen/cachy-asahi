prepare() {
    # A normal repository build must reject stale copied canonical code.
    # Isolated snapshots retain the already-reviewed fixed source/provenance pins.
    if [[ -f "$startdir/../../../AGENTS.md" ]]; then
        python -B "$startdir/check-sync.py" --copy "$srcdir/cachy-asahi-setup" \
            --canonical "$startdir/../../../scripts/setup/setup.py" \
            --license "$startdir/../../../LICENSE"
        python -B "$startdir/check-sync.py" --source repository --copy "$srcdir/cachy-asahi-repository" \
            --canonical "$startdir/../../../scripts/repository/enroll.py" --license "$startdir/../../../LICENSE"
        python -B "$startdir/check-sync.py" --source repository-doc --copy "$srcdir/repository-enrollment.md" \
            --canonical "$startdir/../../../docs/repository-enrollment.md" --license "$startdir/../../../LICENSE"
    fi
}

check() {
    python -B - "$srcdir/cachy-asahi-setup" "$srcdir/cachy-asahi-repository" <<'PYTHON'
import ast
from pathlib import Path
import sys
for path in sys.argv[1:]:
    ast.parse(Path(path).read_bytes(), filename=path)
PYTHON
    # Snapshot pin verification; checkout synchronization runs before snapshotting.
    python -B "$srcdir/check-sync.py" --copy "$srcdir/cachy-asahi-setup" \
        --canonical "$srcdir/cachy-asahi-setup" --license "$srcdir/LICENSE"
    python -B "$srcdir/check-sync.py" --source repository --copy "$srcdir/cachy-asahi-repository" \
        --canonical "$srcdir/cachy-asahi-repository" --license "$srcdir/LICENSE"
    python -B "$srcdir/check-sync.py" --source repository-doc --copy "$srcdir/repository-enrollment.md" \
        --canonical "$srcdir/repository-enrollment.md" --license "$srcdir/LICENSE"
    python -B "$srcdir/test-sync.py"
    python -B "$srcdir/cachy-asahi-setup" --help >/dev/null
    python -B "$srcdir/cachy-asahi-repository" --help >/dev/null
    python -B "$srcdir/cachy-asahi-repository" enroll --help >/dev/null
    python -B "$srcdir/cachy-asahi-repository" disable --help >/dev/null
}

package() {
    install -Dm755 "$srcdir/cachy-asahi-setup" "$pkgdir/usr/bin/cachy-asahi-setup"
    install -Dm755 "$srcdir/cachy-asahi-repository" "$pkgdir/usr/bin/cachy-asahi-repository"
    install -Dm644 "$srcdir/repository-enrollment.md" "$pkgdir/usr/share/doc/$pkgname/repository-enrollment.md"
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$srcdir/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
