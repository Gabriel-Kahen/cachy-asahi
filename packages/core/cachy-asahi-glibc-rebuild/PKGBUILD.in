# SPDX-License-Identifier: MIT
# Project-owned successor; unrelated to the old binary's unavailable build recipe.
pkgname=cachy-asahi-glibc-rebuild
pkgver=2.43.r22.g8362e8ce10b2.caa1
pkgrel=1
pkgdesc='Unselected GNU libc rebuild candidate in a versioned private prefix'
arch=('aarch64')
url='https://www.gnu.org/software/libc/'
license=('GPL-2.0-or-later' 'LGPL-2.1-or-later' 'LicenseRef-glibc-notices')
depends=('glibc' 'filesystem' 'tzdata')
makedepends=('gcc' 'binutils' 'make' 'bison' 'gawk' 'python' 'perl' 'texinfo' 'patch' 'linux-api-headers')
options=('staticlibs' '!strip' '!debug' '!lto')
_prefix=/opt/cachy-asahi/glibc-rebuild/2.43-r22-g8362e8ce10b2-caa1
_upstream=@SOURCE_ROOT@
source=(
  'glibc-source.tar.gz'
  '0001-include-isolate-__O_CLOEXEC-flag-for-sys-mount.h-and.patch'
  '0002-Linux-Only-define-OPEN_TREE_-macros-in-sys-mount.h-i.patch'
  '0001-resolv-Check-for-inet_ntop-failure-in-ns_sprintrrf.patch'
  '0002-resolv-Remove-incorrect-parts-of-TSIG-handling-from-.patch'
  '0003-resolv-Fix-buffer-overreads-in-ns_sprintrrf-CVE-2026.patch'
  '0004-resolv-Add-test-case-tst-ns_sprintrr-bug-34033-bug-3.patch'
  'ALARM-PACKAGING-LICENSE'
  'ALARM-REUSE.toml'
  'COPYINGv2'
  'COPYING.LESSERv2'
  'COPYING.LIB.reference'
  'UPSTREAM-LICENSES'
)
sha256sums=(
  '@UPSTREAM_SHA256@'
  'b0167989dd576a55622604cee18010da6a74ee3c1ea75ebc5e2eaeaa740a523d'
  '0df317d7c7514c81942c11b916b41af69a16509e54122a8d356932c33f4c093e'
  '31681bca83b889fa425a20e9a535f453ed716accac269e1a99f77cafbb92635c'
  'ac4276a31673deedf081147523183ca976ea84ebbd6c624281d46e2d5521e343'
  'a1f56470d70693486c3f9dc30509fc6314416712571856a485c658e4a4a50460'
  '3b9ca91e4b1ef4ce72188edad7a77e6e0920162d01be87232d800761ce2b0dd2'
  '7056c04df17a4e0f0bac9f787f347c9cd892cee6323d1c89528090afd0b934a3'
  '7056aa41aa564a258a015970522545e6b5df69dd26d1088b6047e9bf08ef2802'
  'edaef632cbb643e4e7a221717a6c441a4c1a7c918e6e4d56debc3d8739b233f6'
  '20e50fe7aae3e56378ebf0417d9de904f55a0e61e4df315333e632a4d3555d95'
  '9b2def8a1f95faf55a15ade459ba61d97183ebfb269b175e0e2eaed61bf9ebe3'
  'b22a69aa3f80a5201818c66cb0df0f25f9fa13cf5861b0093a058dbd12d50dce'
)

prepare() {
  [[ $CARCH == aarch64 && $(uname -m) == aarch64 && ${CACHY_ASAHI_GLIBC_BUILD:-} == 1 ]] || return 2
  cd "$srcdir/$_upstream" || return
  patch --batch --forward --fuzz=0 -Np1 < "$srcdir/0001-include-isolate-__O_CLOEXEC-flag-for-sys-mount.h-and.patch" || return
  patch --batch --forward --fuzz=0 -Np1 < "$srcdir/0002-Linux-Only-define-OPEN_TREE_-macros-in-sys-mount.h-i.patch" || return
  patch --batch --forward --fuzz=0 -Np1 < "$srcdir/0001-resolv-Check-for-inet_ntop-failure-in-ns_sprintrrf.patch" || return
  patch --batch --forward --fuzz=0 -Np1 < "$srcdir/0002-resolv-Remove-incorrect-parts-of-TSIG-handling-from-.patch" || return
  patch --batch --forward --fuzz=0 -Np1 < "$srcdir/0003-resolv-Fix-buffer-overreads-in-ns_sprintrrf-CVE-2026.patch" || return
  patch --batch --forward --fuzz=0 -Np1 < "$srcdir/0004-resolv-Add-test-case-tst-ns_sprintrr-bug-34033-bug-3.patch" || return
}

build() {
  export CFLAGS='-O2 -g' CXXFLAGS='-O2 -g' CPPFLAGS='' LDFLAGS='' MAKEFLAGS='-j4'
  export LC_ALL=C LANG=C TZ=UTC
  mkdir -p "$srcdir/build" || return
  cd "$srcdir/build" || return
  printf '%s\n' "slibdir=$_prefix/usr/lib" "rtlddir=$_prefix/usr/lib" \
    "sbindir=$_prefix/usr/bin" "rootsbindir=$_prefix/usr/bin" > configparms || return
  "$srcdir/$_upstream/configure" --prefix="$_prefix/usr" --libdir="$_prefix/usr/lib" \
    --libexecdir="$_prefix/usr/lib" --sysconfdir="$_prefix/etc" --localstatedir="$_prefix/var" \
    --build=aarch64-unknown-linux-gnu --host=aarch64-unknown-linux-gnu \
    --with-headers=/usr/include --enable-bind-now --enable-stack-protector=strong \
    --enable-fortify-source --disable-systemtap --disable-nscd --disable-profile --disable-werror \
    --with-pkgversion='cachy-asahi-owned-rebuild-caa1 GNU8362e8ce10b2' || return
  make -s -O || return
  make -s info || return
  mkdir -p "$srcdir/locales/C.utf8" || return
  I18NPATH="$srcdir/$_upstream/localedata" ./elf/ld.so \
    --inhibit-cache --library-path "$srcdir/build:$srcdir/build/elf:$srcdir/build/math:$srcdir/build/nptl" \
    ./locale/localedef --no-archive -i C -f UTF-8 "$srcdir/locales/C.utf8" || return
}

check() {
  cd "$srcdir/build" || return
  local check_status=0 abi_status=0
  make -s -k -j4 check > /work/evidence/upstream-check.log 2>&1 || check_status=$?
  printf '%s\n' "$check_status" > /work/evidence/check-exit
  make -s -j4 check-abi > /work/evidence/upstream-abi.log 2>&1 || abi_status=$?
  printf '%s\n' "$abi_status" > /work/evidence/abi-exit
  python3 /runner/collect_tests.py --build "$srcdir/build" --output /work/evidence || return
  (( check_status == 0 && abi_status == 0 ))
}

package() {
  make -s -C "$srcdir/build" install_root="$pkgdir" install || return
  # No global library/cache paths, locale-gen, hooks or install scriptlets.
  rm -f "$pkgdir/$_prefix/etc/ld.so.cache" "$pkgdir/$_prefix/etc/ld.so.cache~" || return
  install -d "$pkgdir/$_prefix/usr/lib/locale" || return
  cp -a "$srcdir/locales/C.utf8" "$pkgdir/$_prefix/usr/lib/locale/" || return
  [[ -f "$pkgdir/$_prefix/usr/lib/gconv/ISO8859-1.so" ]] || return 2
  [[ -f "$pkgdir/$_prefix/usr/lib/libc.so.6" && -f "$pkgdir/$_prefix/usr/lib/libm.so.6" && \
     -f "$pkgdir/$_prefix/usr/lib/ld-linux-aarch64.so.1" ]] || return 2
  install -d "$pkgdir/usr/share/licenses/$pkgname" || return
  install -m644 "$srcdir/$_upstream/"{COPYINGv2,COPYING.LESSERv2,LICENSES} "$pkgdir/usr/share/licenses/$pkgname/" || return
  install -m644 "$srcdir/ALARM-PACKAGING-LICENSE" "$srcdir/ALARM-REUSE.toml" "$pkgdir/usr/share/licenses/$pkgname/" || return
}
