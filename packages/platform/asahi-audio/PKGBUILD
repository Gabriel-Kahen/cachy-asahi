# BUILD-ONLY development candidate; upstream platform data is unchanged.
pkgname=asahi-audio
pkgver=4.1
pkgrel=2
pkgdesc='Selected Asahi Linux audio configuration and FIR data (development candidate)'
arch=('aarch64')
url='https://github.com/AsahiLinux/asahi-audio'
license=('MIT')
makedepends=('make')
depends=('wireplumber>=0.5.2' 'pipewire>=1.0' 'bankstown>=1.1.0' 'lsp-plugins-lv2>=1.2.15' 'speakersafetyd' 'triforce-lv2>=0.2.0')
source=('asahi-audio-4.1.tar.gz' 'NOTICE' 'README.md' 'PACKAGING.LICENSE' 'source-provenance.json')
sha256sums=('e2c3887fe20481675698ac8174f53b66276f75a2b3c0853daf9b1a70dda690c5' '910a4f8a8426f28922e3cfe0d50f7cdb14d67b01549097ccadae639e59ec1007' 'd958e9aa11a81b2a7283d98968aa2705a79d1968b77fa1864bc0b4d3347d9df1' '51a352b3e94757560538ca5866bef929de5ec4864e5893fc635f291f7a5926c7' '3da39cbdd69b1367fdb32ff9e4087f20812ea7c2491efbd81eab9642fb487ed1')

build() {
    cd "$srcdir/asahi-audio-4.1"
    make
}

package() {
    cd "$srcdir/asahi-audio-4.1"
    make DESTDIR="$pkgdir" install
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE.asahi"
    install -Dm644 "$srcdir/PACKAGING.LICENSE" "$pkgdir/usr/share/licenses/$pkgname/PACKAGING.LICENSE"
    install -Dm644 "$srcdir/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$srcdir/source-provenance.json" "$pkgdir/usr/share/doc/$pkgname/source-provenance.json"
}
