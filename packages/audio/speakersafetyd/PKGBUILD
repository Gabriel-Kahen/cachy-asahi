# Build-only candidate from asahi-alarm/PKGBUILDs 9717359f2feac55830f8d57e50e4746e98ba6e99.
pkgname=speakersafetyd
pkgver=2.0.1
pkgrel=3
pkgdesc='Asahi audio component; protected target integration pending'
arch=('aarch64')
url='https://asahilinux.org'
license=('MIT')
depends=('alsa-lib')
makedepends=('rust' 'make' 'pkgconf')
source=('speakersafetyd-2.0.1.tar.gz' 'cargo-vendor-117.tar.xz' '0001-j504-Write-the-full-speaker-names-in-conf.patch' 'audio-rust-notices-v1.tar.xz')
sha256sums=('0e1cb05a2f5521d80f9a502daa0b75ef5c7f2b9e8913b0f88c2d19a97d4439e5' '64cd55473b19f104f3a90570409d58c5ab69f63c61396541c4ad1e56e8d6293f' '9c1060ca170f52ceb2a68fd1d3c67a31edc4171473b65c239de2115ac8c1870f' '7cd393018f279ff2a1e71fe85fb5767e3f58398edcd395da4ab6f4eb357ce522')

prepare() {
  cd "${srcdir}/speakersafetyd-2.0.1"
  printf '%s  Cargo.lock\n' '2fcdbfe63c7123bfb39e2993956e3cd431d536f166fec1a985eb3fe36ced70d6' | sha256sum -c -
  patch -Np1 --fuzz=0 --no-backup-if-mismatch -i "${srcdir}/0001-j504-Write-the-full-speaker-names-in-conf.patch"
  install -dm700 "${srcdir}/cargo-home"
  cat > "${srcdir}/cargo-home/config.toml" <<EOF
[source.crates-io]
replace-with = "vendored-sources"
[source.vendored-sources]
directory = "${srcdir}/vendor"
[net]
offline = true
EOF
}

build() {
  cd "${srcdir}/speakersafetyd-2.0.1"
  CARGO_HOME="${srcdir}/cargo-home" cargo build --release --frozen --offline
  printf '%s  Cargo.lock\n' '2fcdbfe63c7123bfb39e2993956e3cd431d536f166fec1a985eb3fe36ced70d6' | sha256sum -c -
}

check() {
  cd "${srcdir}/speakersafetyd-2.0.1"
  test -s target/release/speakersafetyd
  readelf -h target/release/speakersafetyd | grep -Eq 'Machine: +AArch64'
}

package() {
  cd "${srcdir}/speakersafetyd-2.0.1"
  make DESTDIR="${pkgdir}" UNITDIR=/usr/lib/systemd/system UDEVDIR=/usr/lib/udev/rules.d install
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/speakersafetyd/LICENSE"
  for notice in THIRD-PARTY.md THIRD-PARTY-LICENSES.txt SOURCE.md; do
    install -Dm644 "${srcdir}/audio-rust-notices/${pkgname}/${notice}" \
      "${pkgdir}/usr/share/licenses/${pkgname}/${notice}"
  done
}
