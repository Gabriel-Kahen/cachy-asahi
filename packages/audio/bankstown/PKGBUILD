# Build-only candidate from asahi-alarm/PKGBUILDs 9717359f2feac55830f8d57e50e4746e98ba6e99.
pkgname=bankstown
pkgver=1.1.0
pkgrel=3
pkgdesc='Asahi audio component; protected target integration pending'
arch=('aarch64')
url='https://asahilinux.org'
license=('MIT')
depends=('lv2')
makedepends=('rust' 'make')
source=('bankstown-1.1.0.tar.gz' 'cargo-vendor-117.tar.xz')
sha256sums=('e877508b73fe90774d74526d838f75e8ea278bdbcee0a1f92e3eca67ed734675' '64cd55473b19f104f3a90570409d58c5ab69f63c61396541c4ad1e56e8d6293f')

prepare() {
  cd "${srcdir}/bankstown-1.1.0"
  printf '%s  Cargo.lock\n' '66887346513dafbdbe171f77890b4e414bd49abfdde7e0d9e35eeb9ebd677f94' | sha256sum -c -
  install -dm700 "${srcdir}/cargo-home"
  cat > "${srcdir}/cargo-home/config.toml" <<EOF
[source.crates-io]
replace-with = "vendored-sources"
[source.vendored-sources]
directory = "${srcdir}/vendor"
[net]
offline = true
EOF
}

build() {
  cd "${srcdir}/bankstown-1.1.0"
  CARGO_HOME="${srcdir}/cargo-home" cargo build --release --frozen --offline
  printf '%s  Cargo.lock\n' '66887346513dafbdbe171f77890b4e414bd49abfdde7e0d9e35eeb9ebd677f94' | sha256sum -c -
}

check() {
  cd "${srcdir}/bankstown-1.1.0"
  test -s target/release/libbankstown.so
  readelf -h target/release/libbankstown.so | grep -Eq 'Machine: +AArch64'
}

package() {
  cd "${srcdir}/bankstown-1.1.0"
  make LIBDIR=/usr/lib DESTDIR="${pkgdir}" install
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/bankstown/LICENSE"
}
