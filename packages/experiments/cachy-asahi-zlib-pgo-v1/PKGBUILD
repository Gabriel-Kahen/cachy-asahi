# Unselected PGO candidate; makepkg runs only inside reviewed build_v2 offline OCI.
pkgname=cachy-asahi-zlib-pgo-v1
pkgver=1.3.2
pkgrel=1
pkgdesc='Unselected finite GCC PGO zlib experiment with sealed native training provenance'
arch=('aarch64')
url='https://zlib.net/'
license=('Zlib' 'MIT')
depends=('glibc')
makedepends=('gcc' 'binutils' 'make' 'python')
options=('staticlibs' '!buildflags' '!strip' '!debug' '!lto')
source=('https://zlib.net/zlib-1.3.2.tar.gz'
  'pipeline.py' 'profile_seal.py' 'corpus_controls.py' 'corpus-policy.json'
  'arm_c01.py' 'corpus.py' 'pgo.py' 'supervisor.py'
  'probe.c' 'strict-gzip.c' 'LICENSE.project' 'training.bin' 'validation.bin' 'recipe-policy.json')
# Root freezes every local checksum after all owned source files are final.
sha256sums=('bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16'
  '907717f2f0ecfd126f43ac55b8805bfa871922a4c8f5ee8a1d38f5412f30d2e4' '5e96fe7a38e66bfa09146effce76547c3c61b555a52f6b8cdf71ccabb5bfe87e' '19a0536f6d216e1d10831c4b0234d2f44b4c15edce7522b16cd399a4e8adbf42' 'b7a6c5a993766b6d1b014df31adfa6efe261a4aa1352f581ecc6feaff9ed5586'
  '4034990eac1036cd9fee3f7f4911f181e8b2ce6a2441c25e6e502c09cca1e2a8' 'dbaf951adbb91d6769f40f8fb18c13044a42a3b5db11b4ad7d1f44afbed9ad8c' '71c948e55cdea6e75f91bd46751e7d4d1a5a3a81e700fe8210e2747150df69b3' '38e10bbf57c9b83040624748967426aa829144585e5c26b7f39f56b8f58bb933'
  'b85bab88cdb9048f26d5e812cc1ad2b8c783292882cbe3ab804e54353e4dfee1' '369e4e0e3f7c79b5d892edf7476ade41d6647332fb78f95ad7de7d8449bbaca9' '51a352b3e94757560538ca5866bef929de5ec4864e5893fc635f291f7a5926c7' 'a6e84ea4cf12d2152fd408cea20bc2a395d4308f06683d13fc4909ae7ad46af6' 'e178d56b3a6d0af1900f8e3a1b668549793b48d0ae35c24e730b9a39992604bf' 'c1302c24e9c09665a618f7d035aa336bd03196ea91ba547a04497c656d725886')
_prefix=/usr/lib/cachy-asahi/experiments/zlib-pgo-v1

prepare() {
  [[ $CARCH == aarch64 && $(uname -m) == aarch64 && ${CACHY_ASAHI_CONTAINER:-} == 1 && $EUID != 0 ]] || return 2
}

build() {
  # makepkg may symlink verified sources. Give strict readers ordinary copies.
  local name inputs="$srcdir/pgo-inputs"
  mkdir -m700 "$inputs" || return
  for name in zlib-1.3.2.tar.gz pipeline.py profile_seal.py corpus_controls.py corpus-policy.json arm_c01.py corpus.py pgo.py supervisor.py probe.c strict-gzip.c LICENSE.project training.bin validation.bin recipe-policy.json; do
    install -m644 "$srcdir/$name" "$inputs/$name" || return
  done
  python3 -B "$inputs/pipeline.py" build --inputs "$inputs" --output "$srcdir/pgo-result" || return
}

check() {
  python3 -B "$srcdir/pgo-inputs/pipeline.py" check --inputs "$srcdir/pgo-inputs" --output "$srcdir/pgo-result" || return
}

package() {
  local target="$pkgdir$_prefix" result="$srcdir/pgo-result" inputs="$srcdir/pgo-inputs" name
  python3 -B "$inputs/pipeline.py" check --inputs "$inputs" --output "$result" || return
  install -d "$target/bin" "$target/lib" "$target/include" "$target/source" "$target/build" || return
  for name in minigzip probe strict-gzip; do install -m755 "$result/optimized-1/$name" "$target/bin/$name" || return; done
  install -m644 "$result/optimized-1/libz.a" "$target/lib/" || return
  install -m644 "$result/optimized-1/"{zlib.h,zconf.h} "$target/include/" || return
  install -m644 "$result/optimized-1/Makefile.txt" "$target/build/Makefile" || return
  install -m644 "$result/"{profile-seal.json,result.json,receipt.json} "$target/build/" || return
  install -m644 "$inputs/zlib-1.3.2.tar.gz" "$target/source/" || return
  for name in pipeline.py profile_seal.py corpus_controls.py corpus-policy.json arm_c01.py corpus.py pgo.py supervisor.py probe.c strict-gzip.c LICENSE.project training.bin validation.bin recipe-policy.json; do
    install -m644 "$inputs/$name" "$target/source/$name" || return
  done
  install -m644 "$startdir/PKGBUILD" "$target/source/PKGBUILD" || return
  install -Dm644 "$result/optimized-1/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.zlib" || return
  install -Dm644 "$inputs/LICENSE.project" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.project" || return
}
