check() {
    fish --no-config --no-execute "$srcdir/__history_previous_command.fish"
    fish --no-config --no-execute "$srcdir/__history_previous_command_arguments.fish"
    fish --no-config --no-execute "$srcdir/opt-in.fish"
}

package() {
    install -Dm644 "$srcdir/__history_previous_command.fish" "$pkgdir/usr/share/cachy-asahi/fish-bang-bang/__history_previous_command.fish"
    install -Dm644 "$srcdir/__history_previous_command_arguments.fish" "$pkgdir/usr/share/cachy-asahi/fish-bang-bang/__history_previous_command_arguments.fish"
    install -Dm644 "$srcdir/opt-in.fish" "$pkgdir/usr/share/cachy-asahi/fish-bang-bang/opt-in.fish"
    install -Dm644 "$srcdir/usage.md" "$pkgdir/usr/share/cachy-asahi/fish-bang-bang/README.md"
    install -Dm644 "$srcdir/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
    install -Dm644 "$srcdir/LICENSE.upstream" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.upstream"
    install -Dm644 "$srcdir/LICENSE.project" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.project"
}
