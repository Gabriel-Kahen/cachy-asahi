name: native-arm-support-package
on:
  workflow_dispatch:
    inputs:
      source_sha:
        description: Exact Root-published closed source; sealed v2 and base admission required
        type: string
        required: true
permissions:
  contents: read
concurrency:
  group: native-arm-support-package
  cancel-in-progress: false
jobs:
  native:
    if: github.repository == 'Gabriel-Kahen/cachy-asahi' && github.event.repository.private == false
    runs-on: ubuntu-24.04-arm
    timeout-minutes: 115
    env:
      SOURCE_SHA: ${{ inputs.source_sha }}
      PYTHONDONTWRITEBYTECODE: '1'
      INPUTS_SHA256: beca39e04e125a0fa72dedab2dd772e048655d80c36c216a031df0a0c3852e8f
    steps:
      - name: Checkout exact Root-published support native source
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ inputs.source_sha }}
          persist-credentials: false
      - name: Refuse NULL package selection and unresolved base acquisition before secrets
        shell: bash
        run: |
          set -euo pipefail
          printf '%s  %s\n' '@OWNER_SHA@' native/owner.py '@MAP_SHA@' native/source-map.json | sha256sum --check
          test "$(git rev-parse HEAD)" = "$SOURCE_SHA"
          test "$GITHUB_SHA" = "$SOURCE_SHA"
          test "$GITHUB_WORKFLOW_SHA" = "$SOURCE_SHA"
          cmp --silent .github/workflows/native-arm-build.yml .github/workflows/native-arm-support.yml
          mkdir -m700 "$RUNNER_TEMP/support-native-home"
          env -i PATH=/usr/local/bin:/usr/bin:/bin HOME="$RUNNER_TEMP/support-native-home" LANG=C TZ=UTC \
            RUNNER_TEMP="$RUNNER_TEMP" GITHUB_SHA="$GITHUB_SHA" GITHUB_WORKFLOW_SHA="$GITHUB_WORKFLOW_SHA" \
            GITHUB_REF="$GITHUB_REF" GITHUB_RUN_ID="$GITHUB_RUN_ID" GITHUB_RUN_ATTEMPT="$GITHUB_RUN_ATTEMPT" \
            GITHUB_WORKFLOW_REF="$GITHUB_WORKFLOW_REF" GITHUB_EVENT_NAME="$GITHUB_EVENT_NAME" \
            GITHUB_REPOSITORY="$GITHUB_REPOSITORY" GITHUB_ACTIONS="$GITHUB_ACTIONS" RUNNER_ARCH="$RUNNER_ARCH" RUNNER_OS="$RUNNER_OS" \
            python3 -I -B native/owner.py --preflight-only --execute \
            --source-sha "$SOURCE_SHA" --ref "$GITHUB_REF" --run-id "$GITHUB_RUN_ID" --map-sha256 @MAP_SHA@ \
            --work "$RUNNER_TEMP/support-native-work" --cache "$RUNNER_TEMP/alarm-cache" \
            --carrier "$RUNNER_TEMP/pgo-hosted-retained" --public "$RUNNER_TEMP/support-native-public"
      - name: Provision and preflight disposable runner-host bubblewrap before secrets
        timeout-minutes: 12
        shell: bash
        run: |
          set -euo pipefail
          env -i PATH=/usr/bin:/bin HOME="$RUNNER_TEMP/support-native-home" LANG=C TZ=UTC \
            RUNNER_TEMP="$RUNNER_TEMP" SOURCE_SHA="$SOURCE_SHA" PYTHONDONTWRITEBYTECODE=1 \
            GITHUB_ACTIONS="$GITHUB_ACTIONS" RUNNER_ENVIRONMENT="$RUNNER_ENVIRONMENT" \
            python3 -I -B - <<'PYHOST'
          """Runner-host dependency readiness only; never substitutes for private check()."""
          import hashlib
          import importlib.util
          import json
          import os
          from pathlib import Path
          import platform
          import re
          import stat
          import subprocess
          import sys
          import time
          
          M = 1024**2
          LOG_CAP, RECEIPT_CAP, TOTAL_SECONDS = M, 64*1024, 600
          APT_OPTIONS = ['-o', 'Acquire::Retries=0', '-o', 'Acquire::http::Timeout=30',
                         '-o', 'Acquire::https::Timeout=30', '-o', 'Dpkg::Use-Pty=0']
          UPDATE = ['/usr/bin/sudo', '-n', '--', '/usr/bin/apt-get', *APT_OPTIONS, 'update']
          INSTALL = ['/usr/bin/sudo', '-n', '--', '/usr/bin/apt-get', *APT_OPTIONS,
                     'install', '--yes', '--no-install-recommends', 'bubblewrap']
          PACKAGE = ['/usr/bin/dpkg-query', '-W', '-f=${Package}\t${Version}\t${Architecture}\n', 'bubblewrap']
          OWNER = ['/usr/bin/dpkg-query', '-S', '/usr/bin/bwrap']
          VERSION = ['/usr/bin/bwrap', '--version']
          PROBE = ['/usr/bin/bwrap', '--unshare-all', '--die-with-parent', '--new-session',
                   '--ro-bind', '/', '/', '--proc', '/proc', '--dev', '/dev', '--tmpfs', '/tmp',
                   '--tmpfs', '/home', '--tmpfs', '/run', '--tmpfs', '/sys', '--tmpfs', '/root',
                   '--clearenv', '--setenv', 'PATH', '/usr/bin:/bin', '--chdir', '/tmp', '--', '/usr/bin/true']
          
          def need(ok, why):
              if not ok: raise ValueError(why)
          
          def pin(raw):
              return dict(bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())
          
          def error_data(error):
              return dict(type=type(error).__name__, errno=getattr(error, 'errno', None), message=str(error)[:512])
          
          def natural(row):
              state = row.get('supervision', {})
              return (row.get('error') is None and row.get('exit') == state.get('exit') == 0
                  and state.get('retirement') == 'REAPED' and state.get('natural_exit') is True
                  and state.get('group_absent') is True and state.get('leader_held_until_group_inspection') is True
                  and state.get('exit_observed_via_waitpid') is True and state.get('ownership_lost') is False
                  and state.get('forced_cleanup') is False and row.get('complete') is True)
          
          def preflight(execute, identity, emit, now=time.monotonic):
              """Fakeable orchestration; execute returns (bounded original bytes, command row)."""
              receipt = dict(schema=1, status='FAIL_HOST_BUBBLEWRAP_PREFLIGHT', scope='DISPOSABLE_RUNNER_HOST_ONLY',
                  commands=[], executable=None, package=None, version=None, namespace=None,
                  private_check='NOT_RUN_NOT_REPLACED', actual_native='NOT_RUN', error=None)
              deadline = now() + TOTAL_SECONDS
              emit(receipt)
              def command(argv, seconds, privileged=False):
                  remaining = deadline-now()
                  need(remaining > 0 and len(receipt['commands']) < 7, 'bounded whole host preflight')
                  try:
                      raw, row = execute(argv, min(seconds, remaining), privileged)
                  except Exception as error:
                      receipt['commands'].append(dict(argv=argv, exit=None, error=error_data(error), complete=False))
                      raise
                  receipt['commands'].append(row); emit(receipt)
                  need(len(raw) <= LOG_CAP and row.get('argv') == argv and natural(row), 'actual bounded natural command success required')
                  return raw
              try:
                  command(UPDATE, 180, True)
                  command(INSTALL, 180, True)
                  before = identity(); receipt['executable'] = before; emit(receipt)
                  raw = command(PACKAGE, 30)
                  match = re.fullmatch(rb'bubblewrap\t([0-9A-Za-z.+:~_-]{1,160})\tarm64\n', raw)
                  need(match is not None, 'actual Ubuntu arm64 bubblewrap package version')
                  receipt['package'] = dict(name='bubblewrap', version=match[1].decode(), architecture='arm64')
                  need(re.fullmatch(rb'bubblewrap(?::arm64)?: /usr/bin/bwrap\n', command(OWNER, 30)) is not None,
                       'exact installed package owns fixed host executable')
                  raw = command(VERSION, 15)
                  need(re.fullmatch(rb'bubblewrap [0-9][0-9A-Za-z.+~_-]{0,79}\n', raw) is not None, 'bounded actual executable version')
                  receipt['version'] = raw.decode().strip()
                  need(command(PROBE, 30) == b'', 'harmless namespace probe must have empty original output')
                  need(identity() == before, 'host executable identity changed during readiness')
                  need(now() <= deadline, 'whole preflight deadline')
                  receipt['namespace'] = dict(status='PASS_HARMLESS_UNSHARE_ALL_TRUE', privileged=False,
                      probe=PROBE, private_ALARM_rootfs='NOT_USED', check_function='NOT_RUN')
                  receipt['status'] = 'PASS_HOST_BUBBLEWRAP_READY_ONLY'
              except Exception as error:
                  receipt['error'] = error_data(error)
                  emit(receipt)
                  return receipt
              emit(receipt)
              return receipt
          
          def executable_identity():
              path = Path('/usr/bin/bwrap')
              need(not any(p.is_symlink() for p in (path,*path.parents)), 'fixed ordinary host executable path')
              fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
              fields = lambda s: (s.st_dev,s.st_ino,s.st_mode,s.st_nlink,s.st_uid,s.st_gid,s.st_size,s.st_mtime_ns,s.st_ctime_ns)
              try:
                  before = os.fstat(fd)
                  need(stat.S_ISREG(before.st_mode) and before.st_nlink == 1 and before.st_uid == 0
                       and 0 < before.st_size <= 8*M and before.st_mode & 0o111 and not before.st_mode & 0o6000
                       and os.access(path,os.X_OK), 'root-owned executable non-setuid host bubblewrap')
                  raw = b''
                  while block := os.read(fd, min(M, before.st_size+1-len(raw))):
                      raw += block; need(len(raw) <= before.st_size, 'bounded executable bytes')
                  need(len(raw) == before.st_size and fields(os.fstat(fd)) == fields(before) == fields(path.lstat()), 'stable exact host executable')
                  return dict(path=str(path), **pin(raw), device=before.st_dev, inode=before.st_ino,
                      mode=stat.S_IMODE(before.st_mode), uid=before.st_uid, gid=before.st_gid,
                      mtime_ns=before.st_mtime_ns, ctime_ns=before.st_ctime_ns)
              finally: os.close(fd)
          
          def main():
              """Future workflow entrypoint. Tests never call this or import owned_child."""
              temp = Path(os.environ['RUNNER_TEMP']).absolute()
              need(not any(p.is_symlink() for p in (temp,*temp.parents)), 'ordinary runner temporary directory')
              out = temp/'support-host-preflight'; out.mkdir(mode=0o700)
              (out/'logs').mkdir(mode=0o700)
              private = temp/'support-host-preflight-private'; private.mkdir(mode=0o700)
              source = Path.cwd()
              binding = dict(source_sha=os.environ.get('SOURCE_SHA'), scope='GITHUB_HOSTED_UBUNTU_24_04_ARM')
              supervisor = None
              def emit(value):
                  record = dict(value, binding=binding, supervisor=supervisor)
                  raw = (json.dumps(record,sort_keys=True,indent=2)+'\n').encode()
                  need(len(raw) <= RECEIPT_CAP, 'bounded host readiness receipt')
                  pending = out/'receipt.pending'; pending.write_bytes(raw); pending.chmod(0o600)
                  os.replace(pending,out/'receipt.json')
              try:
                  need(re.fullmatch('[0-9a-f]{40}',binding['source_sha'] or '') is not None, 'actual source binding')
                  need(os.environ.get('GITHUB_ACTIONS') == 'true' and os.environ.get('RUNNER_ENVIRONMENT') == 'github-hosted',
                       'disposable GitHub-hosted runner only')
                  need(platform.system() == 'Linux' and platform.machine() in ('aarch64','arm64')
                       and os.getuid() == os.geteuid() != 0, 'ordinary native ARM runner host')
                  release = dict(line.split('=',1) for line in Path('/etc/os-release').read_text().splitlines() if '=' in line)
                  need(release.get('ID','').strip('"') == 'ubuntu' and release.get('VERSION_ID','').strip('"') == '24.04',
                       'declared disposable Ubuntu24.04 runner')
                  need(not any(k.startswith(('CACHY_','GH_','GITHUB_TOKEN','LD_','DOCKER_')) for k in os.environ), 'no secrets or loader/daemon overrides')
                  module_path = source/'bootstrap/scripts/ci/zlib-pgo-native-hosted/owned_child.py'
                  manifest = json.loads((source/'native/source-map.json').read_bytes())
                  row = manifest['files'][module_path.relative_to(source).as_posix()]
                  raw = module_path.read_bytes()
                  need(pin(raw) == {k:row[k] for k in ('bytes','sha256')}, 'held owned supervisor source pin')
                  supervisor = pin(raw)
                  spec = importlib.util.spec_from_file_location('_support_host_owned',module_path)
                  owned = importlib.util.module_from_spec(spec); sys.modules[spec.name] = owned; spec.loader.exec_module(owned)
                  child_env = dict(PATH='/usr/bin:/bin',HOME=os.environ['HOME'],LANG='C',LC_ALL='C',TZ='UTC',DEBIAN_FRONTEND='noninteractive')
                  counter = 0
                  def execute(argv,timeout,privileged):
                      nonlocal counter
                      counter += 1; need(counter <= 7, 'finite host command count')
                      path = private/('%02d.log' % counter); state = {}; failure = None; result = None
                      with path.open('xb') as stream:
                          try:
                              result = owned.run(argv,timeout=timeout,stdin=subprocess.DEVNULL,stdout=stream,
                                  stderr=subprocess.STDOUT,stdout_limit=LOG_CAP,stderr_limit=LOG_CAP,
                                  env=child_env,cwd=str(source),lifecycle=state,
                                  allowed_uids={os.getuid(),0} if privileged else {os.getuid()})
                          except Exception as error: failure = error_data(error)
                      observed = path.stat().st_size
                      with path.open('rb') as stream: raw = stream.read(LOG_CAP)
                      relative = 'logs/%02d.log' % counter
                      with (out/relative).open('xb') as stream: stream.write(raw)
                      command = dict(argv=argv,timeout_seconds=timeout,privileged=privileged,
                          exit=result.returncode if result is not None else state.get('exit'),error=failure,
                          supervision=state,log=relative,log_pin=pin(raw),original_bytes_observed=observed,
                          complete=observed <= LOG_CAP,prefix_only=observed > LOG_CAP)
                      return raw,command
                  receipt = preflight(execute,executable_identity,emit)
              except Exception as error:
                  receipt = dict(schema=1,status='FAIL_HOST_BUBBLEWRAP_PREFLIGHT',error=error_data(error),
                      commands=[],private_check='NOT_RUN_NOT_REPLACED',actual_native='NOT_RUN')
                  emit(receipt)
              print(json.dumps(dict(status=receipt['status'],source_sha=binding['source_sha'],
                  receipt='support-host-preflight/receipt.json',private_check='NOT_RUN_NOT_REPLACED'),sort_keys=True))
              return 0 if receipt['status'] == 'PASS_HOST_BUBBLEWRAP_READY_ONLY' else 2
          
          if __name__ == '__main__':
              raise SystemExit(main())
          PYHOST
      - name: Seed the six exact retained inputs using existing secrets only
        timeout-minutes: 2
        env:
          CACHY_RETAINED_BUBBLEWRAP_V1_PACKAGE_01: ${{ secrets.CACHY_RETAINED_BUBBLEWRAP_V1_PACKAGE_01 }}
          CACHY_RETAINED_BUBBLEWRAP_V1_PACKAGE_02: ${{ secrets.CACHY_RETAINED_BUBBLEWRAP_V1_PACKAGE_02 }}
          CACHY_RETAINED_BUBBLEWRAP_V1_SIGNATURE_01: ${{ secrets.CACHY_RETAINED_BUBBLEWRAP_V1_SIGNATURE_01 }}
          CACHY_OLD_FOUR_SCHEMA: '1'
          CACHY_OLD_FOUR_SOURCE_EPOCH: '1791748800'
          CACHY_OLD_FOUR_JBIGKIT_01: ${{ secrets.CACHY_OLD_FOUR_JBIGKIT_01 }}
          CACHY_OLD_FOUR_JBIGKIT_02: ${{ secrets.CACHY_OLD_FOUR_JBIGKIT_02 }}
          CACHY_OLD_FOUR_JBIGKIT_SIG_01: ${{ secrets.CACHY_OLD_FOUR_JBIGKIT_SIG_01 }}
          CACHY_OLD_FOUR_LIBTIFF_01: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_01 }}
          CACHY_OLD_FOUR_LIBTIFF_02: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_02 }}
          CACHY_OLD_FOUR_LIBTIFF_03: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_03 }}
          CACHY_OLD_FOUR_LIBTIFF_04: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_04 }}
          CACHY_OLD_FOUR_LIBTIFF_05: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_05 }}
          CACHY_OLD_FOUR_LIBTIFF_06: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_06 }}
          CACHY_OLD_FOUR_LIBTIFF_07: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_07 }}
          CACHY_OLD_FOUR_LIBTIFF_08: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_08 }}
          CACHY_OLD_FOUR_LIBTIFF_09: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_09 }}
          CACHY_OLD_FOUR_LIBTIFF_10: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_10 }}
          CACHY_OLD_FOUR_LIBTIFF_11: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_11 }}
          CACHY_OLD_FOUR_LIBTIFF_12: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_12 }}
          CACHY_OLD_FOUR_LIBTIFF_13: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_13 }}
          CACHY_OLD_FOUR_LIBTIFF_14: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_14 }}
          CACHY_OLD_FOUR_LIBTIFF_15: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_15 }}
          CACHY_OLD_FOUR_LIBTIFF_SIG_01: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_SIG_01 }}
        run: |
          set -euo pipefail
          test "$INPUTS_SHA256" = beca39e04e125a0fa72dedab2dd772e048655d80c36c216a031df0a0c3852e8f
          printf '%s  %s\n' "$INPUTS_SHA256" bootstrap/scripts/ci/inputs.lock.json | sha256sum --check
          timeout --signal=TERM --kill-after=5s 75s python3 -B - <<'PYSEED'
          import hashlib
          import os
          from pathlib import Path
          import sys
          sys.path.insert(0, 'bootstrap/scripts/ci')
          from old_four_seed import (OLD_FOUR_PRIVATE_ROWS, RETAINED_BUBBLEWRAP_PRIVATE_ROWS,
                                     seed_current_build_cache)
          pin = 'beca39e04e125a0fa72dedab2dd772e048655d80c36c216a031df0a0c3852e8f'
          if hashlib.sha256(Path('bootstrap/scripts/ci/inputs.lock.json').read_bytes()).hexdigest() != pin:
              raise SystemExit('private-cache-input-binding-refused')
          names = {'CACHY_OLD_FOUR_' + f'{tag}_{i:02d}'
                   for _, _, _, tag, count in OLD_FOUR_PRIVATE_ROWS for i in range(1, count + 1)}
          retained = {'CACHY_RETAINED_BUBBLEWRAP_V1_' + f'{tag}_{i:02d}'
                      for _, _, _, tag, sizes in RETAINED_BUBBLEWRAP_PRIVATE_ROWS
                      for i in range(1, len(sizes) + 1)}
          names |= retained
          if len(names) != 22 or len(retained) != 3 or not all(os.environ.get(name) for name in names):
              raise SystemExit('private-cache-required-secrets-missing')
          cache = Path(os.environ['RUNNER_TEMP']) / 'alarm-cache'
          cache.mkdir(mode=0o700)
          keep = names | {'CACHY_OLD_FOUR_SCHEMA', 'CACHY_OLD_FOUR_SOURCE_EPOCH'}
          for name in tuple(os.environ):
              if name not in keep:
                  os.environ.pop(name)
          seed_current_build_cache(cache, pin)
          PYSEED
      - name: Checkout the exact fourteen public input source
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        timeout-minutes: 1
        with:
          ref: 04a4a74e16e1e1bc939ea74791bf1f1bf7b46bbd
          path: source-public14
          persist-credentials: false
      - name: Seed all fourteen exact public input files into the existing cache
        timeout-minutes: 1
        run: |
          set -euo pipefail
          printf '%s  %s\n' 'a7857658af224984065e575f6ffed8308ea85027d46eace8bda146d9033e93b3' source-public14/seed.py 'a388c8c8ba8e06cb92fd2be598b86e433c4e403b6e71a0f15b1eaec381bb7300' source-public14/index.json | sha256sum --check
          env -i PATH=/usr/local/bin:/usr/bin:/bin HOME="$RUNNER_TEMP/support-native-home" LANG=C.UTF-8 TZ=UTC TMPDIR="$RUNNER_TEMP" PYTHONDONTWRITEBYTECODE=1 \
            python3 -I -B "$GITHUB_WORKSPACE/source-public14/seed.py" --cache "$RUNNER_TEMP/alarm-cache"
      - name: Move exact public input DATA outside the closed source
        shell: bash
        run: |
          set -euo pipefail
          test ! -e "$RUNNER_TEMP/support-native-public14"
          mv source-public14 "$RUNNER_TEMP/support-native-public14"
      - name: Checkout existing complete finite retained carrier DATA
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        timeout-minutes: 10
        with:
          ref: ddc6ca5f3478f9c607f8fae52661c451ae0bf3ad
          path: support-retained-data
          persist-credentials: false
      - name: Move retained DATA to its qualified fixed path
        shell: bash
        run: |
          set -euo pipefail
          test ! -e "$RUNNER_TEMP/pgo-hosted-retained"
          mv support-retained-data "$RUNNER_TEMP/pgo-hosted-retained"
          chmod 700 "$RUNNER_TEMP/pgo-hosted-retained"
      - name: Exact signed base, independent native pair and disposable signed lifecycle
        timeout-minutes: 90
        shell: bash
        run: |
          set -euo pipefail
          env -i PATH=/usr/local/bin:/usr/bin:/bin HOME="$RUNNER_TEMP/support-native-home" LANG=C TZ=UTC \
            RUNNER_TEMP="$RUNNER_TEMP" TMPDIR="$RUNNER_TEMP" PYTHONDONTWRITEBYTECODE=1 \
            GITHUB_SHA="$GITHUB_SHA" GITHUB_WORKFLOW_SHA="$GITHUB_WORKFLOW_SHA" \
            GITHUB_REF="$GITHUB_REF" GITHUB_RUN_ID="$GITHUB_RUN_ID" GITHUB_RUN_ATTEMPT="$GITHUB_RUN_ATTEMPT" \
            GITHUB_WORKFLOW_REF="$GITHUB_WORKFLOW_REF" GITHUB_EVENT_NAME="$GITHUB_EVENT_NAME" \
            GITHUB_REPOSITORY="$GITHUB_REPOSITORY" GITHUB_ACTIONS="$GITHUB_ACTIONS" RUNNER_ARCH="$RUNNER_ARCH" RUNNER_OS="$RUNNER_OS" \
            python3 -I -B native/owner.py --execute \
            --source-sha "$SOURCE_SHA" --ref "$GITHUB_REF" --run-id "$GITHUB_RUN_ID" --map-sha256 @MAP_SHA@ \
            --work "$RUNNER_TEMP/support-native-work" --cache "$RUNNER_TEMP/alarm-cache" \
            --carrier "$RUNNER_TEMP/pgo-hosted-retained" --public "$RUNNER_TEMP/support-native-public"
      - name: Upload only bounded regular DATA capsule and receipt
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
        with:
          name: support-native-${{ github.run_id }}-${{ github.run_attempt }}
          retention-days: 3
          if-no-files-found: ignore
          path: ${{ runner.temp }}/support-native-public/
      - name: Upload bounded runner-host readiness or failure DATA
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
        with:
          name: support-host-preflight-${{ github.run_id }}-${{ github.run_attempt }}
          retention-days: 3
          if-no-files-found: ignore
          path: ${{ runner.temp }}/support-host-preflight/
