pkgname=cachy-asahi-ksmctl
pkgver=0.1.0
pkgrel=1
pkgdesc='Read-only KSM status and page-size-aware counter reporting'
arch=('any')
url='https://github.com/Gabriel-Kahen/cachy-asahi'
license=('GPL-2.0-or-later')
depends=('python>=3.11')
source=('cachy-asahi-ksmctl' 'README.md' 'NOTICE' 'LICENSE' 'upstream-ksmctl' 'adaptation.patch' 'source-provenance.json' 'check-source.py' 'test_ksmctl.py' 'policy.py' 'test_policy.py' 'management-policy.md' 'native-stage.md')
sha256sums=(f9fd76eaa6a205d56fa4bb9123b8c721ea1277249c4cab58d1b57eaf8edc7558 e7f806f7c81d5ddb2388faa4f7ddc53e04c004596a4f346bb270b47f8aad023d 939ad92c65a6c2f9da2c723a4c6e136add87ccb4a7a6e8ba0dd89692a77f3f10 edaef632cbb643e4e7a221717a6c441a4c1a7c918e6e4d56debc3d8739b233f6 cd5c8aa86df5a06a268ecc21297b4cd7d8df1053c90c8bcd4e53ef9bb16194d9 0bc6b1f4725eb510a0f890bd616ce682b98332b371c93d2144ad643181727212 d46e93a9893225d205a01fdcd3429782ba51d44c86b78e77fce458b53448b849 7cca209ee6ad36726b03c0f54100b07bd6d08d974473d00c2092bbd5be4089a6 e42602fd16579e30c8cb799f26c897c1e3e89515f20a49a346b1888ce3c94b6f 53cea58f017b06ac55f5a39c388abf050e034f67132578e384e20c00bfe68281 1ed306235087a760b8199829c35e99ecdb4ab6b6ddb2eb27562a9659d518121f ba5ca032b7e3b4757be38c18b24c295399ab1ec43c0ba3552ae5e2ff75d32437 a2f0ea5fc896f06843bdf56a6b655cc93421d36fc3b59a864814a5c248bd6259)

check() {
    python -B - "$srcdir/cachy-asahi-ksmctl" "$srcdir/check-source.py" "$srcdir/test_ksmctl.py" "$srcdir/policy.py" "$srcdir/test_policy.py" <<'PYTHON'
import ast
from pathlib import Path
import sys
for name in sys.argv[1:]:
    ast.parse(Path(name).read_bytes(), filename=name)
PYTHON
    python -B "$srcdir/check-source.py"
    python -B "$srcdir/test_ksmctl.py"
    python -B "$srcdir/test_policy.py"
    python -B "$srcdir/cachy-asahi-ksmctl" --help >/dev/null
}

package() {
    install -Dm755 "$srcdir/cachy-asahi-ksmctl" "$pkgdir/usr/bin/cachy-asahi-ksmctl"
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$srcdir/source-provenance.json" "$pkgdir/usr/share/doc/$pkgname/source-provenance.json"
    install -Dm644 "$srcdir/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
