name: native-arm-rust199-source-reference-v1
on:
  workflow_dispatch:
    inputs:
      source_sha: {type: string, required: true}
      source_map_sha256: {type: string, required: true}
      approval_sha256: {type: string, required: true}
      root_admission_sha256: {type: string, required: true}
      root_admission_json: {type: string, required: true}
      operation:
        type: choice
        required: true
        default: rust199-source-reference-native-v1
        options: [rust199-source-reference-native-v1]
permissions:
  contents: read
  actions: read
concurrency:
  group: native-arm-build
  cancel-in-progress: false
  queue: max
jobs:
  native:
    name: rust199-native-v1
    if: github.repository == 'Gabriel-Kahen/cachy-asahi' && github.event.repository.private == false
    runs-on: ubuntu-24.04-arm
    timeout-minutes: 360
    defaults:
      run:
        shell: bash
    env:
      PYTHONDONTWRITEBYTECODE: '1'
      SOURCE_SHA: ${{ inputs.source_sha }}
      SOURCE_MAP_SHA256: ${{ inputs.source_map_sha256 }}
      ROOT_APPROVAL_SHA256: ${{ inputs.approval_sha256 }}
      ROOT_ADMISSION_SHA256: ${{ inputs.root_admission_sha256 }}
      ROOT_ADMISSION_JSON: ${{ inputs.root_admission_json }}
      RUST199_OPERATION: ${{ inputs.operation }}
    steps:
      - name: Checkout exact Root-published prospective Source
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        timeout-minutes: 2
        with:
          ref: ${{ inputs.source_sha }}
          persist-credentials: false
      - name: Require actual Root-prepared materials and qualified normal image
        timeout-minutes: 345
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          printf '%s  %s\n' '__ENTRY_SHA__' hosted/entry.py | sha256sum --check
          cmp --silent .github/workflows/native-arm-build.yml .github/workflows/native-arm-rust199-source-reference-v1.yml
          python3 -I -B - <<'PYROOT'
          import os
          from pathlib import Path
          p=Path(os.environ['RUNNER_TEMP'],'rust199-root-admission.json')
          with p.open('xb') as f:
              f.write(os.environ['ROOT_ADMISSION_JSON'].encode())
          p.chmod(0o444)
          PYROOT
          # External transport and image provisioning are intentionally NULL.
          # Missing actual Root files/qualification refuse BEFORE network/daemon.
          timeout --signal=TERM --kill-after=300s 20400s python3 -I -B hosted/entry.py \
            --admission "$RUNNER_TEMP/rust199-root-admission.json" \
            --admission-sha256 "$ROOT_ADMISSION_SHA256" \
            --approval-sha256 "$ROOT_APPROVAL_SHA256" \
            --map-sha256 "$SOURCE_MAP_SHA256" --execute
      - name: Retain finite build DATA pending independent Root review
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
        timeout-minutes: 10
        with:
          name: rust199-native-v1-${{ github.run_id }}-${{ github.run_attempt }}
          if-no-files-found: ignore
          include-hidden-files: true
          retention-days: 3
          path: |
            ${{ runner.temp }}/rust199-hosted/hosted.json
            ${{ runner.temp }}/rust199-hosted/source-readback.json
            ${{ runner.temp }}/rust199-hosted/job-metadata.json
            ${{ runner.temp }}/rust199-hosted/daemon.json
            ${{ runner.temp }}/rust199-hosted/operations.json
            ${{ runner.temp }}/rust199-hosted/operations/**
            ${{ runner.temp }}/rust199-hosted/rust-build/producer.json
            ${{ runner.temp }}/rust199-hosted/rust-build/*inspect*.json
            ${{ runner.temp }}/rust199-hosted/rust-build/*finished*.json
            ${{ runner.temp }}/rust199-hosted/rust-build/export.tar
            ${{ runner.temp }}/rust199-hosted/rust-build/export-stderr.log
            ${{ runner.temp }}/rust199-hosted/rust-build/inputs/*.json
