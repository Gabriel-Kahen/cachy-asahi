# SPDX-License-Identifier: MIT
# NEW Debian84-patch source subset; independent archive authority remains a separate gate.
pkgname=cachy-asahi-glibc-gnu-provider
pkgver=2.43.caa3
pkgrel=1
pkgdesc='Unselected Debian84-patch GNU2.43 conventional /usr provider candidate'
arch=('aarch64')
url='https://www.gnu.org/software/libc/'
license=('GPL-2.0-or-later' 'LGPL-2.1-or-later' 'LicenseRef-glibc-notices')
depends=('linux-api-headers>=4.10' 'filesystem' 'tzdata')
provides=('glibc=2.43')
conflicts=('glibc')
backup=('etc/gai.conf')
makedepends=('gcc' 'binutils' 'make' 'bison' 'gawk' 'python' 'perl' 'texinfo' 'patch' 'gnupg' 'linux-api-headers')
options=('staticlibs' '!strip' '!debug' '!lto')
_upstream=prepared/source/glibc-2.43
@SOURCE_ARRAYS@
noextract=("${source[@]}")

prepare() {
  [[ $CARCH == aarch64 && $(uname -m) == aarch64 && ${CACHY_ASAHI_GLIBC_BUILD:-} == 1 ]] || return 2
  python3 "$startdir/materialize.py" --authority "$startdir/authority.json" \
    --chain-inputs "$startdir" --patch-tar "$startdir/glibc_2.43-7.debian.tar.xz" \
    --output "$srcdir/prepared" || return
}

build() {
  export CFLAGS='-O2 -g' CXXFLAGS='-O2 -g' CPPFLAGS='' LDFLAGS='' MAKEFLAGS='-j4'
  export LC_ALL=C LANG=C TZ=UTC
  mkdir -p "$srcdir/build" || return
  cd "$srcdir/build" || return
  printf '%s\n' "slibdir=/usr/lib" "rtlddir=/usr/lib" \
    "sbindir=/usr/bin" "rootsbindir=/usr/bin" \
    'tst-malloc-too-large-malloc-hugetlb2-ENV += TIMEOUTFACTOR=5' > configparms || return
  MAKEINFO=: "$srcdir/$_upstream/configure" --prefix=/usr --libdir=/usr/lib \
    --libexecdir=/usr/lib --localedir=/usr/share/locale --sysconfdir=/etc --localstatedir=/var \
    --build=aarch64-unknown-linux-gnu --host=aarch64-unknown-linux-gnu \
    --disable-multi-arch \
    --with-headers=/usr/include --enable-bind-now --enable-stack-protector=strong \
    --enable-fortify-source --disable-systemtap --disable-nscd --disable-profile --disable-werror \
    --with-pkgversion='cachy-asahi-gnu-provider-caa3 GNU2.43 Debian84-patch' || return
  make MAKEINFO=: -s -O || return
  # Debian all/local-remove-manual.diff supplies only its authenticated Makefile.
  # MAKEINFO=: on every make command; no GNU manual source is restored.
  mkdir -p "$srcdir/locales/C.utf8" || return
  I18NPATH="$srcdir/$_upstream/localedata" GCONV_PATH="$srcdir/build/iconvdata" ./elf/ld.so \
    --inhibit-cache --library-path "$srcdir/build:$srcdir/build/elf:$srcdir/build/math:$srcdir/build/nptl" \
    ./locale/localedef --no-archive -i C -f UTF-8 "$srcdir/locales/C.utf8" || return
}

check() {
  cd "$srcdir/build" || return
  local check_status=0 abi_status=0
  make MAKEINFO=: -s -k -j4 check > /work/evidence/upstream-check.log 2>&1 || check_status=$?
  printf '%s\n' "$check_status" > /work/evidence/check-exit
  make MAKEINFO=: -s -j4 check-abi > /work/evidence/upstream-abi.log 2>&1 || abi_status=$?
  printf '%s\n' "$abi_status" > /work/evidence/abi-exit
  python3 /runner/collect_tests.py --build "$srcdir/build" --output /work/evidence || return
  (( check_status == 0 && abi_status == 0 ))
}

package() {
  make MAKEINFO=: -s -C "$srcdir/build" install_root="$pkgdir" install || return
  install -Dm644 "$srcdir/$_upstream/posix/gai.conf" "$pkgdir/etc/gai.conf" || return
  install -d "$pkgdir/usr/lib/locale" || return
  cp -a "$srcdir/locales/C.utf8" "$pkgdir/usr/lib/locale/" || return
  install -d "$pkgdir/usr/share/licenses/$pkgname" || return
  install -m644 "$srcdir/$_upstream/"{COPYINGv2,COPYING.LESSERv2,LICENSES} "$pkgdir/usr/share/licenses/$pkgname/" || return
  install -m644 "$srcdir/prepared/metadata/debian/copyright" "$pkgdir/usr/share/licenses/$pkgname/debian-copyright" || return
  install -m644 "$srcdir/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE" || return
  install -m644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.cachy-asahi" || return
  python3 "$srcdir/stage.py" --pkgdir "$pkgdir" || return
}
