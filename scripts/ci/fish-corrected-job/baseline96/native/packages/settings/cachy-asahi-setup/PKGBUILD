prepare() {
    # A normal repository build must reject stale copied canonical code.
    # Isolated snapshots retain the already-reviewed fixed source/provenance pins.
    if [[ -f "$startdir/../../../AGENTS.md" ]]; then
        python -B "$startdir/check-sync.py" --copy "$srcdir/cachy-asahi-setup" \
            --canonical "$startdir/../../../scripts/setup/setup.py" \
            --license "$startdir/../../../LICENSE"
    fi
}

check() {
    python -B - "$srcdir/cachy-asahi-setup" <<'PYTHON'
import ast
from pathlib import Path
import sys
ast.parse(Path(sys.argv[1]).read_bytes(), filename=sys.argv[1])
PYTHON
    # Snapshot pin verification; checkout synchronization runs before snapshotting.
    python -B "$srcdir/check-sync.py" --copy "$srcdir/cachy-asahi-setup" \
        --canonical "$srcdir/cachy-asahi-setup" --license "$srcdir/LICENSE"
    python -B "$srcdir/test-sync.py"
    python -B "$srcdir/cachy-asahi-setup" --help >/dev/null
}

package() {
    install -Dm755 "$srcdir/cachy-asahi-setup" "$pkgdir/usr/bin/cachy-asahi-setup"
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$srcdir/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
