N/entry.py" seed --source "$GITHUB_WORKSPACE/core-source"\n          --carrier "$GITHUB_WORKSPACE/native574-complete-public-inputs" --temp "$RUNNER_TEMP"\n          --base "$PARENT/base" --receipt "$PARENT/retained-custody.json"\n      - name: Reuse unchanged owned574 native producer\n        timeout-minutes: 40\n        env:\n          JOB_TOKEN: ${{ steps.proof.outputs.job_token }}\n        run: >-\n          timeout --signal=TERM --kill-after=10s 2300s\n          python3 -I -B scripts/ci/maintained_desktop574.py build\n          --inputs scripts/ci/maintained-desktop574-inputs.json\n          --output "$PARENT/base" --job-token "$JOB_TOKEN"\n      - name: Original fresh574 current64 TEST assembly then two owned real-systemd boots\n        timeout-minutes: 241\n        run: >-\n          python3 -I -B "$CASE/entry.py" execute --source "$CASE" --core-source "$GITHUB_WORKSPACE/core-source" --vm-source "$VMCASE" --core7 "$GITHUB_WORKSPACE/core7-inputs" --core64 "$GITHUB_WORKSPACE/core64-inputs" --kernel-carrier "$GITHUB_WORKSPACE/kernel-inputs"\n          --proof "$PARENT/source-proof.json" --base "$PARENT/base" --output "$PARENT/owner"\n      - name: Ordered all consumers and owned data then unchanged producer cleanup\n        if: always() && steps.proof.outcome == \'success\'\n        timeout-minutes: 20\n        run: >-\n          python3 -I -B "$CASE/entry.py" cleanup --source "$CASE" --core-source "$GITHUB_WORKSPACE/core-source" --vm-source "$VMCASE" --core7 "$GITHUB_WORKSPACE/core7-inputs" --core64 "$GITHUB_WORKSPACE/core64-inputs" --kernel-carrier "$GITHUB_WORKSPACE/kernel-inputs"\n          --proof "$PARENT/source-proof.json" --base "$PARENT/base" --output "$PARENT/owner"\n          --receipt "$PARENT/ordered-cleanup.json"\n      - name: Closed complete Core7 evidence gate\n        if: always() && steps.proof.outcome == \'success\'\n        timeout-minutes: 4\n        run: |\n          set -euo pipefail\n          result=0\n          python3 -I -B "$CASE/entry.py" retain --source "$CASE" --core-source "$GITHUB_WORKSPACE/core-source" --vm-source "$VMCASE" --core7 "$GITHUB_WORKSPACE/core7-inputs" --core64 "$GITHUB_WORKSPACE/core64-inputs" --kernel-carrier "$GITHUB_WORKSPACE/kernel-inputs" --proof "$PARENT/source-proof.json" --base "$PARENT/base" --output "$PARENT/owner" --receipt "$PARENT/ordered-cleanup.json" --public "$PARENT/public" || result=$?\n          python3 -I -B "$CASE/entry.py" transport --source "$CASE" --core-source "$GITHUB_WORKSPACE/core-source" --vm-source "$VMCASE" --core7 "$GITHUB_WORKSPACE/core7-inputs" --core64 "$GITHUB_WORKSPACE/core64-inputs" --kernel-carrier "$GITHUB_WORKSPACE/kernel-inputs" --proof "$PARENT/source-proof.json" --public "$PARENT/public" --output "$PARENT/transport"\n          exit "$result"\n      - name: Upload only bounded closed Core7 qualification evidence\n        if: always() && steps.proof.outcome == \'success\'\n        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9\n        timeout-minutes: 5\n        with:\n          name: core7-real-systemd-${{ github.run_id }}-${{ github.run_attempt }}\n          path: ${{ github.workspace }}/core7-systemd-vm-parent/transport/\n          retention-days: 3\n          compression-level: 0\n          include-hidden-files: true\n          if-no-files-found: error\n'}
EDITS={'effects.py': [('allowed=set(ACCOUNTS)|{AUX}|', "allowed=__import__('mime_cache').closed(before,after)|set(ACCOUNTS)|{AUX}|")], 'guest.py': [("first=graph(core,'baseline-automatic',report)", "first=graph(core,'baseline-automatic',report);__import__('mime_cache').baseline(before['nodes'],first['nodes'])"), ("log_name='phase%d-%s-pacman.log'", "__import__('mime_cache').hook_log(log,label)\n log_name='phase%d-%s-pacman.log'")], 'validate.py': [("__import__('candidate_capacity').transaction(transaction,role,row);", "__import__('mime_cache').hook_log(raw,'baseline-original-reinstall'if role=='baseline_automatic'else'accepted-core7-install');__import__('candidate_capacity').transaction(transaction,role,row);"), ("C.need(row['baseline_automatic']['witness']['targets']==['systemd']", "__import__('mime_cache').baseline(graphs['phase1-before']['nodes'],graphs['baseline-automatic']['nodes']);__import__('mime_cache').log_pair(C.read(directory/'phase1-baseline-original-reinstall-pacman.log',1024**2),C.read(directory/'phase1-accepted-core7-install-pacman.log',1024**2));C.need(row['baseline_automatic']['witness']['targets']==['systemd']")], 'entry.py': [("validation=__import__('tmpfiles_hash').prove(root)", "validation=__import__('mime_cache').prove(root)")], 'test_initramfs.py': [('self.assertIn("\'/usr/bin/pacman\',\'--debug\'",raw)', 'self.assertNotIn("\'--debug\'",raw);self.assertIn("commands.call([\'/usr/bin/pacman\',\'--config\',\'/run/core-pacman.conf\',\'--noconfirm\',\'-U\',*[str(r[\'archive\'])for r in rows]],seconds)",raw);self.assertIn("seconds=__import__(\'candidate_capacity\').requested(names,label,seconds)",raw);self.assertIn("s[\'nonce\'],\'accepted-core7-install\',180)",C.read(C.HERE/\'guest.py\').decode())')]}
def need(ok,why):
 if not ok:raise ValueError(why)
def pin(raw):return dict(bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
PROFILE_SHA='4c601c715c4ee64484f49dacebfddb53da9391893c29e3c0626a92942a36a793'
MIME='usr/share/mime'
HOOK=b"running '30-update-mime-database.hook'"
def policy():
 raw=__import__('case').read(Path(__file__).with_name('mime-profile.json'),1024**2);need(len(raw)<=1024**2 and hashlib.sha256(raw).hexdigest()==PROFILE_SHA,'entire fixed six-input MIME cache policy');p=json.loads(raw);need(p['schema']==1 and p['actual']is None and p['acceptance']is False and len(p['inputs'])==6 and len(p['before'])==8 and len(p['generated'])==1084,'closed source-only MIME policy')
 need(set(p['before'])==set(p['inputs'])|{MIME,MIME+'/packages'}and set(p['generated']).isdisjoint(p['before']),'only six XML inputs and exact newly generated cache nodes')
 for name,row in {**p['before'],**p['generated'],**p['mechanisms']}.items():
  need(type(name)is str and 0<len(name.encode())<=4096 and all(c not in('','.','..')for c in name.split('/'))and not name.startswith('/')and not any(ord(c)<32 or ord(c)==127 for c in name),'literal bounded MIME policy path')
  need(type(row)is dict and row['type']in('file','directory')and set(row)==({'type','mode','uid','gid','bytes','sha256'}if row['type']=='file'else{'type','mode','uid','gid'}),'complete typed MIME node, no aliases/opaque metadata')
  need(all(type(row[k])is int for k in('mode','uid','gid'))and row['uid']==row['gid']==0 and row['mode']==(0o755 if row['type']=='directory'or name=='usr/bin/update-mime-database'else 0o644),'fixed original MIME node mode and root owner')
  if row['type']=='file':need(type(row['bytes'])is int and 0<=row['bytes']<=32*1024**2 and type(row['sha256'])is str and len(row['sha256'])==64 and all(c in'0123456789abcdef'for c in row['sha256']),'whole bounded MIME content pin')
  if name in p['generated']:need(name.startswith(MIME+'/')and not name.startswith(MIME+'/packages/'),'generated rows never authorize signed input changes')
 need(all(p['before'][n]==r['node']and r['package']in p['archives']and r['version']==p['archives'][r['package']]['version']for n,r in p['inputs'].items()),'every original XML binds its exact original574 signed archive role')
 need(set(p['mechanisms'])=={'usr/bin/update-mime-database','usr/share/libalpm/hooks/30-update-mime-database.hook'},'only exact original signed generator and hook')
 return p

def closed(before,after):
 p=policy()
 for nodes in(before,after):
  need(type(nodes)is dict,'whole persistent graph node mapping')
  for name,row in p['mechanisms'].items():need(nodes.get(name)==row,'original signed MIME generator/hook preserved '+name)
  for name,row in p['inputs'].items():need(nodes.get(name)==row['node'],'original signed XML input preserved '+name)
 def subset(nodes):return{n:r for n,r in nodes.items()if n==MIME or n.startswith(MIME+'/')}
 need(subset(before)==p['before'],'complete original eight-node MIME namespace before automatic hooks')
 need(subset(after)==dict(p['before'],**p['generated']),'whole closed generated MIME node set/hash/mode/uid/gid; no prefix exemptions')
 return set(p['generated'])

def baseline(before,automatic):
 closed(before,automatic);return dict(status='EXACT_SIX_SIGNED_XML_BASELINE_HOOK_GENERATED_MIME_CACHE',generated=1084,total=1092)

def hook_log(raw,label):
 counts={'baseline-original-reinstall':1,'accepted-core7-install':2}
 need(type(label)is str and label in counts and type(raw)is bytes and len(raw)<=1024**2 and raw.count(HOOK)==counts[label],'exact original MIME hook in baseline then cumulative candidate ALPM log')

def log_pair(before,after):
 hook_log(before,'baseline-original-reinstall');hook_log(after,'accepted-core7-install');need(after.startswith(before)and len(after)>len(before)and after[len(before):].count(HOOK)==1,'complete unchanged baseline ALPM prefix plus one actual candidate MIME hook')

def inverse(values):
 need(set(values)==set(PARENT)|{'mime_cache.py','mime-profile.json'},'whole exact49 source namespace')
 raw=values['mime_cache.py'];needle=('TEMPLATE_SHA='+repr(TEMPLATE_SHA)).encode();need(raw.count(needle)==1 and hashlib.sha256(raw.replace(needle,b"TEMPLATE_SHA='@SELF@'",1)).hexdigest()==TEMPLATE_SHA,'whole fixed MIME helper and guard self seal');need(hashlib.sha256(values['mime-profile.json']).hexdigest()==PROFILE_SHA,'entire closed MIME profile')
 restored=dict(values);restored.pop('mime_cache.py');restored.pop('mime-profile.json')
 for name,edits in EDITS.items():
  text=restored[name].decode()
  for before,after in reversed(edits):need(text.count(after)==1,'one exact MIME inverse seam '+name);text=text.replace(after,before,1)
  restored[name]=text.encode()
 for name,body in SEALS.items():restored[name]=body
 need({n:pin(b)for n,b in restored.items()}==PARENT,'whole47 before inverse; all remaining runtime/security/clocks held');return restored

def verify(values):
 import case as C
 restored=inverse(values);manifest=dict(schema=1,purpose='CORE7_REAL_HOOKS_AND_ACTUAL_PID1_SOURCE_ONLY',actual=None,files={n:pin(b)for n,b in values.items()if n!='source-manifest.json'and not n.startswith('.github/')});need(C.decode(values['source-manifest.json'])==manifest,'whole current49 closed manifest')
 workflow=values['workflow.yml.in'].replace(b'@ENTRY_SHA@',pin(values['entry.py'])['sha256'].encode()).replace(b'@MANIFEST_SHA@',pin(values['source-manifest.json'])['sha256'].encode());need(all(values[n]==workflow for n in('.github/workflows/native-arm-build.yml','.github/workflows/native-arm-core7-real-systemd.yml')),'whole current49 workflow aliases');return restored

def prove(root):
 import case as C,candidate_capacity as parent
 root=Path(root).absolute();values={}
 for path in sorted(root.rglob('*')):
  name=path.relative_to(root).as_posix()
  if name.split('/')[0]=='.git':continue
  need(not path.is_symlink()and(path.is_file()or path.is_dir()),'ordinary whole MIME source')
  if path.is_file():values[name]=C.read(path,4*1024**2)
 restored=verify(values);policy();prior=parent.run_original(restored,'tmpfiles_hash.py');need(prior['files']==47 and prior['parent_files']==46 and prior['ancestor_files']==[45,44,43,42,41,41,40,39],'whole original47/46 and all older source guards')
 return dict(prior,status='PASS_SOURCE_ONLY_EXACT_SIGNED_XML_MIME_CACHE_WHOLE47_ANCESTRY',files=49,parent_files=47,ancestor_files=[46,45,44,43,42,41,41,40,39],source=None,ref=None,run=None,actual=None,acceptance=False,mime='EXACT_SIX_SIGNED_XML_INPUTS_PINNED_GENERATOR_HOOK_AND_CLOSED1084_NODES_NO_PREFIX_GRANT')
