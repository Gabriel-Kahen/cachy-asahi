raph_api.py": {\n      "bytes": 1899,\n      "sha256": "16839d25ad6a3957b68848fb6718a393840840b433361eba1ae07ddbbdafe5d7"\n    },\n    "graph_stage_source.py": {\n      "bytes": 56225,\n      "sha256": "b0ce77149ff72ea2936c23fcbdeefe3c011a2dfc75d60d40ec650ab233e5e845"\n    },\n    "guest.py": {\n      "bytes": 18500,\n      "sha256": "8cf9a3f72a3837c9fe86ee2dd9cccb66184e1b6f467b2308e0702f18141e649a"\n    },\n    "guest_guard.py": {\n      "bytes": 4160,\n      "sha256": "8db72fbc36f59c5660f7ddc4f56f3bdbed81cdec4344c65017db522501f83de7"\n    },\n    "hook.py": {\n      "bytes": 787,\n      "sha256": "b3e2bd1c4eb715928919028be1dddce2090605d233ba8f4d6bf98d67e95f5fa3"\n    },\n    "host.py": {\n      "bytes": 4279,\n      "sha256": "d6262590d44abada166510b6775038d6c383d683d2f86247d5f58b275ecc6850"\n    },\n    "initramfs.py": {\n      "bytes": 4502,\n      "sha256": "50d3a4833f5b783704c1a07fb3c213819769a08294eb677e7066ec13595d4b98"\n    },\n    "journal_acl.py": {\n      "bytes": 94610,\n      "sha256": "e3849c1604b6520c4fb813692290a0989d08542cf3ada1fbf412948a83a26c9c"\n    },\n    "media.py": {\n      "bytes": 7850,\n      "sha256": "cc5fe0b84745ca509b79bb0d8d6f55eaf3b265fec656fb37e2d629beacec4849"\n    },\n    "pid1-baseline.json": {\n      "bytes": 528,\n      "sha256": "b508b5ff108bc90d79952c7a90efdb812ccd008421297412b9338a2c6c1c8be6"\n    },\n    "pid1-expected.json": {\n      "bytes": 548,\n      "sha256": "2891023d89c1f35b47c8e4cb8b7c88105ddce72b18796a377b161e7278f03659"\n    },\n    "prepare.py": {\n      "bytes": 1394,\n      "sha256": "554c52290776a5f4ec314ba8abad836db1d99ab81e4782964e3a0d4bbe04a8a2"\n    },\n    "profile.json": {\n      "bytes": 333629,\n      "sha256": "e248308cc7a04607f18f21a5e06a21165fb985bb43130e7db94966cb4eaa879c"\n    },\n    "test_case.py": {\n      "bytes": 19158,\n      "sha256": "d53e437600893676b5e7ec088f7d62f28c79329a39b257a917c220ecfb47f44d"\n    },\n    "test_emission.py": {\n      "bytes": 2521,\n      "sha256": "57a4a755385a5e380e303f3e3da33bafcfc71063ffce2041f22b22b5a5ffdf8f"\n    },\n    "test_host.py": {\n      "bytes": 3090,\n      "sha256": "b01d3159bd0b0c688434bac69976dd16cf173358a598957f3be58f49c1642460"\n    },\n    "test_initramfs.py": {\n      "bytes": 7541,\n      "sha256": "fffe1dadc5a21360c3e620de0a884f6fd78b5296d49f3f166e4312533bf079e5"\n    },\n    "test_protocol.py": {\n      "bytes": 4378,\n      "sha256": "ac482fa3a8fc0ab932bcf8e65b864e4ac26affc1ecf30ecea61cd42b52264d25"\n    },\n    "test_route.py": {\n      "bytes": 5792,\n      "sha256": "db775f05d87d237865c3620de1f86821ddaf5b3e06fff2707f3ee45c8e327ae5"\n    },\n    "test_sources.py": {\n      "bytes": 19838,\n      "sha256": "eef8c2a75e8f3c5e282eb48daba98ce471c58791b29e0653626fe0949a06a8e7"\n    },\n    "tmpfiles_hash.py": {\n      "bytes": 41582,\n      "sha256": "6912c9ae1a14477212921c6aed68b54e7c83a6a9308664e515c51619603eba6b"\n    },\n    "transaction_output.py": {\n      "bytes": 42998,\n      "sha256": "8ce374e17744888ad70ca0b19485ffd6f72d6cf029f47f6fdfaa07c47dce6ce9"\n    },\n    "units/caa-core-observer.service": {\n      "bytes": 474,\n      "sha256": "95b66c92d2acbbfdb5d904c2c0f6b61518fd3bb7c71eb290751a27e9d2fc8e6e"\n    },\n    "units/caa-core-probe.service": {\n      "bytes": 358,\n      "sha256": "b8a4a142045304e53893608548c293b684fbe295831e25a84d5cf3c19ef0a6b4"\n    },\n    "units/caa-core-worker.service": {\n      "bytes": 352,\n      "sha256": "70ebee606afc5fee5359d3ea05cee62445766c8a4033d6fbee7398f0be6f9353"\n    },\n    "units/caa-core.target": {\n      "bytes": 189,\n      "sha256": "1025ff9b01e2132861b26cf35fd5f4a25424638f03e49222552ef0cbbb719e37"\n    },\n    "validate.py": {\n      "bytes": 6703,\n      "sha256": "c67bf7adb0fc8facb7c1703911887cd7b7993e8ea7590475995ac9b6ddfee7b1"\n    },\n    "vm_validation.py": {\n      "bytes": 52784,\n      "sha256": "a69264ea55374b2058048ca2441c89942e65f43d06125b0d1ad71d3e021202e1"\n    },\n    "workflow.yml.in": {\n      "bytes": 13109,\n      "sha256": "923ae66040ac4cfcd7644d7a677db3ba45f902f787daf9546e698f5c8e0471d4"\n    },\n    "xattr_diagnostic.py": {\n      "bytes": 17502,\n      "sha256": "ad88aee4e41afa9f78d45785a45f274abeac1aaf335225ec0c4cc61240cbba47"\n    }\n  },\n  "purpose": "CORE7_REAL_HOOKS_AND_ACTUAL_PID1_SOURCE_ONLY",\n  "schema": 1\n}\n', '.github/workflows/native-arm-build.yml': b'name: native-arm-core7-real-systemd\non:\n  workflow_dispatch:\n    inputs:\n      source_sha:\n        description: Exact frozen source; disposable Core7 qualification only\n        type: string\n        required: true\npermissions:\n  contents: read\nconcurrency:\n  group: native-arm-core7-real-systemd\n  cancel-in-progress: false\njobs:\n  native:\n    if: github.repository == \'Gabriel-Kahen/cachy-asahi\' && github.event.repository.private == false\n    runs-on: ubuntu-24.04-arm\n    timeout-minutes: 360\n    defaults:\n      run:\n        shell: bash\n        working-directory: core-source/runtime/runtime-vm\n    env:\n      PYTHONDONTWRITEBYTECODE: \'1\'\n      SOURCE_SHA: ${{ inputs.source_sha }}\n      WORKFLOW_SHA: ${{ github.workflow_sha }}\n      OWN: ${{ github.workspace }}/core-source/scripts/ci/core-native-lifecycle\n      BUNDLE: ${{ github.workspace }}/core-source/runtime/runtime-vm\n      DEPLOY: ${{ github.workspace }}/core-source/scripts/ci/gnu-immutable-source-native\n      PARENT: ${{ github.workspace }}/core7-systemd-vm-parent\n      CASE: ${{ github.workspace }}/case-source\n      VMCASE: ${{ github.workspace }}/vm-source\n    steps:\n      - name: Checkout exact original Core800 source\n        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1\n        timeout-minutes: 3\n        with:\n          ref: 1a76a09d9cb8210cc2b76eda0c63a08bcd89d4ec\n          path: core-source\n          persist-credentials: false\n      - name: Checkout exact closed two-boot case source\n        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1\n        timeout-minutes: 3\n        with:\n          ref: ${{ inputs.source_sha }}\n          path: case-source\n          persist-credentials: false\n      - name: Checkout exact original KSM637 VM source\n        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1\n        timeout-minutes: 3\n        with:\n          ref: de21d6c25e0fbf5ac83c71965bae3ffa23390461\n          path: vm-source\n          persist-credentials: false\n      - name: Checkout exact accepted generic16K kernel inputs\n        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1\n        timeout-minutes: 3\n        with:\n          ref: 247123187cb1aceae5e61bc89f3c01dbf2986311\n          path: kernel-inputs\n          persist-credentials: false\n      - name: Checkout exact seven accepted byte-identical native archives\n        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1\n        timeout-minutes: 3\n        with:\n          ref: e410bd5d6b4318f114d7311a99a60f20bc8d2f4a\n          path: core7-inputs\n          persist-credentials: false\n      - name: Checkout all original64 retained dependency inputs\n        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1\n        timeout-minutes: 3\n        with:\n          ref: 7dfce898755583bbf8081aae04d8b8579f66be58\n          path: core64-inputs\n          persist-credentials: false\n      - name: Whole frozen source and actual first-run native proof before secrets or actors\n        id: proof\n        timeout-minutes: 4\n        run: |\n          set -euo pipefail\n          printf \'%s  %s\\n\' \'906e2f1314cd53b52c7ce99de102d3746f7dd5a8c82fcf9742d10b1b40af7254\' "$CASE/entry.py" \'80132cecbf8fea51518bbc352b2a367093da7e9d04eafc6c00fa969ec3a5448b\' "$CASE/source-manifest.json" | sha256sum --check\n          python3 -I -B "$CASE/entry.py" source --source "$CASE"\n          python3 -I -B "$OWN/entry.py" source --source "$GITHUB_WORKSPACE/core-source"\n          python3 -I -B "$OWN/test_contract.py"\n          python3 -I -B "$OWN/test_fixture.py"\n          python3 -I -B "$OWN/assemble.py" --source-only\n          python3 -I -B "$CASE/test_case.py"\n          python3 -I -B "$CASE/test_protocol.py"\n          python3 -I -B "$CASE/test_emission.py"\n          python3 -I -B "$CASE/test_host.py"\n          python3 -I -B "$CASE/test_route.py" --vm-source "$VMCASE"\n          python3 -I -B "$CASE/test_sources.py" --core-source "$GITHUB_WORKSPACE/core-source" --vm-source "$VMCASE" --kernel-carrier "$GITHUB_WORKSPACE/kernel-inputs"\n          mkdir -m 0700 "$PARENT"\n          python3 -I -B "$CASE/entry.py" proof --source "$CASE" --core-source "$GITHUB_WORKSPACE/core-source" --vm-source "$VMCASE" --core7 "$GITHUB_WORKSPACE/core7-inputs" --core64 "$GITHUB_WORKSPACE/core64-inputs" --kernel-carrier "$GITHUB_WORKSPACE/kernel-inputs" --proof "$PARENT/source-proof.json"\n      - name: Bounded disposable host QEMU prerequisite before native producer\n        timeout-minutes: 5\n        run: |\n          set -euo pipefail\n          sudo timeout --signal=TERM --kill-after=10s 120s apt-get -o Acquire::Retries=0 update\n          sudo timeout --signal=TERM --kill-after=10s 120s apt-get -o Acquire::Retries=0 install --no-install-recommends -y qemu-system-arm\n          /usr/bin/qemu-system-aarch64 --version\n          /usr/bin/dpkg-query -W qemu-system-arm\n      - name: Checkout complete exact original574 retained inputs\n        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1\n        timeout-minutes: 3\n        with:\n          ref: ddc6ca5f3478f9c607f8fae52661c451ae0bf3ad\n          path: native574-complete-public-inputs\n          persist-credentials: false\n      - name: Prefill exact original policy caches before unchanged legacy CLIs\n        timeout-minutes: 4\n        run: >-\n          python3 -I -B "$OWN/entry.py" prefill --source "$GITHUB_WORKSPACE/core-source"\n          --carrier "$GITHUB_WORKSPACE/native574-complete-public-inputs" --temp "$RUNNER_TEMP"\n          --receipt "$PARENT/legacy-prefil