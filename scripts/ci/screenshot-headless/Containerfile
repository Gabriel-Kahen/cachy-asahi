FROM docker.io/library/debian@sha256:918311b7b6c4c6f68b232ba516584925f6c78ad82b6fd534b98979df6438e483
COPY debs/ /debs/
RUN printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d \
 && chmod 755 /usr/sbin/policy-rc.d \
 && DEBIAN_FRONTEND=noninteractive apt-get --no-download --no-install-recommends -y install /debs/*.deb \
 && rm -rf /debs /var/lib/apt/lists/* /var/cache/apt/archives/*.deb
ENV PATH=/usr/bin:/bin LANG=C LC_ALL=C TZ=UTC
WORKDIR /tmp
ENTRYPOINT ["/usr/bin/python3", "-I", "-B", "/source/scripts/ci/screenshot-headless/run.py"]
