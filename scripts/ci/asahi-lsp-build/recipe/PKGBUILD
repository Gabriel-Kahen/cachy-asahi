# SPDX-License-Identifier: MIT
pkgname=lsp-plugins-lv2-headless-development
pkgver=1.2.35
pkgrel=1
pkgdesc='Private headless LV2 native build candidate; no hardware acceptance'
arch=('aarch64')
url='https://lsp-plug.in'
license=('LGPL-3.0-or-later' 'ISC')
depends=('cairo' 'glibc' 'libsndfile' 'libstdc++' 'lv2')
makedepends=('gcc' 'make' 'pkgconf')
options=('!lto' '!debug' '!strip')
source=('lsp-plugins-src-1.2.35.tar.gz' 'lsp-native-build.sh')
sha256sums=('2c95ec7bb219d561ea3db36051b6c732133bcd76426fb836b1dd850dc4b5bb6c'
            '0bb4024d0eb02f4e8ced77a68fce80a730877a2b9cb190cae2aae650ecab1e0e')

build() {
  bash "$srcdir/lsp-native-build.sh" "$srcdir/lsp-plugins" "$srcdir/native-evidence"
}

package() {
 (
  set -Eeuo pipefail
  local package_stage=package
  trap 'code=$?; if (( code != 0 )); then printf "LSP_STAGE %s FAIL\n" "$package_stage"; fi' EXIT
  printf '%s\n' 'LSP_STAGE package START'
  cd "$srcdir/lsp-plugins"
  local bundle="$pkgdir/usr/lib/lv2/lsp-plugins.lv2"
  local notices="$pkgdir/usr/share/licenses/$pkgname"
  install -Dm755 .build/target/lsp-plugin-fw/lsp-plugins-lv2.so "$bundle/lsp-plugins-lv2.so"
  package_stage=ttl
  printf '%s\n' 'LSP_STAGE ttl START'
  timeout --signal=TERM --kill-after=10s 120s \
    .build/target/lsp-plugin-fw/utils-bin/lv2ttl_gen \
    -o "$bundle" -i .build/target/lsp-plugin-fw/lsp-plugins-lv2.so
  test -s "$bundle/manifest.ttl"
  printf '%s\n' 'LSP_STAGE ttl PASS'
  package_stage=package
  install -Dm644 COPYING "$notices/COPYING"
  install -Dm644 COPYING.LESSER "$notices/COPYING.LESSER"
  install -Dm644 modules/lsp-3rd-party/include/lv2/COPYING "$notices/LV2-COPYING"
  install -Dm644 modules/lsp-3rd-party/include/ardour/inline-display.h "$notices/Ardour-inline-display-NOTICE"
  cat > "$notices/SOURCE-NOTICE" <<'EOF'
LSP Plugins 1.2.35: Linux Studio Plugins Project and contributing module authors.
Source: https://github.com/lsp-plugins/lsp-plugins/releases/download/1.2.35/lsp-plugins-src-1.2.35.tar.gz
Source SHA256: 2c95ec7bb219d561ea3db36051b6c732133bcd76426fb836b1dd850dc4b5bb6c
Unmodified upstream source; headless FEATURES=lv2 private development build.
GPLv3/LGPLv3 companion texts cover the bundled LSP modules; LV2 and Ardour
permission/copyright notices are preserved separately. No UI/fonts or other
plugin format is selected. Corresponding-source/relinking delivery and complete
binary-license review remain prerequisites to any redistribution.
EOF
  printf '%s\n' 'LSP_STAGE package PASS'
 )
}
