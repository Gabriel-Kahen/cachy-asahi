"""Complete1182→1180→1178 guard plus failure-only producer source operands."""
import base64,json,os,subprocess,sys,tempfile,zlib
from pathlib import Path
import common as C
PARENT_PIN='PARENT_PIN_PLACEHOLDER'
# SPDX-License-Identifier: MIT
"""Finite source1182 diagnostic successor with exact whole-parent inverse."""
import json
RUN='implementation/run.py';GUARD='implementation/source_guard.py';HELPER='implementation/producer_diagnostic.py';PROOF='implementation/producer_source.py';PARENT='implementation/producer-parent.json';MANIFEST='source-manifest.json';ALIASES=('.github/workflows/native-arm-build.yml','.github/workflows/native-arm-latest607-fresh-installer.yml')
FOOTER=b'\n# BEGIN_FAILURE_ONLY_PRODUCER_DIAGNOSTIC_SOURCE\ndef verify():\n import producer_source\n return producer_source.verify()\n'
EDITS=(
 ("import common as C,accepted,adapter,materialize,source_guard","import common as C,accepted,adapter,materialize,source_guard,producer_diagnostic"),
 ("EDITS=(\n","EDITS=(\n (\"        ready=producer.prepare(original)\",\"        ready=Y.producer(producer,original)\"),\n"),
 (" def candidate(self,path):return adapter.emit(path)"," def producer(self,original,args):return producer_diagnostic.prepare(original,args)\n def candidate(self,path):return adapter.emit(path)"),
)
def transformed(old,helper,proof,parent):
 need(len(old)==1182,'entire1182 parent source');out=dict(old);text=old[RUN].decode()
 for before,after in EDITS:need(text.count(before)==1,'one current producer integration seam');text=text.replace(before,after,1)
 inverse=text
 for before,after in reversed(EDITS):need(inverse.count(after)==1,'unique producer integration inverse');inverse=inverse.replace(after,before,1)
 need(inverse.encode()==old[RUN],'entire old run/Integration/owner inverse');compile(text,'<failure-only-original-producer-route>','exec');out[RUN]=text.encode();out[GUARD]=old[GUARD]+FOOTER;out[HELPER]=helper;out[PROOF]=proof;out[PARENT]=parent
 manifest=json.loads(old[MANIFEST]);manifest['files']={n:pin(b)for n,b in out.items()if n not in(*ALIASES,MANIFEST)};out[MANIFEST]=enc(manifest);template=old['implementation/workflow-template.yml']
 for name in ALIASES:out[name]=template.replace(b'@FRESH607_MANIFEST@',pin(out[MANIFEST])['sha256'].encode())
 need(set(out)==set(old)|{HELPER,PROOF,PARENT}and len(out)==1185,'whole1185 source namespace');return out
def need(ok,why):C.need(ok,why)
def pin(b):return C.pin(b)
def enc(v):return C.enc(v)
def rows(root):
 actual={}
 for p in root.rglob('*'):
  rel=p.relative_to(root)
  if rel.parts[0]=='.git':continue
  need('.git'not in rel.parts and not p.is_symlink()and(p.is_file()or p.is_dir()),'entire ordinary source namespace')
  if p.is_file():actual[rel.as_posix()]=pin(C.read(p))
 return actual

def inverse():
 raw=C.read(C.HERE/'producer-parent.json');need(pin(raw)['sha256']==PARENT_PIN,'whole fixed producer diagnostic parent');p=json.loads(raw);need(p['before']==p['parent_git']['files']==p['parent_authorization']and len(p['before'])==1182,'whole independently joined1182 source')
 need(p['parent_publication']['source']=='9a67f3e507c57f68ece48c253cdade47648f970c'and p['parent_publication']['files']==p['parent_publication']['git_joins']==1182,'exact1182 source publication');need(all(p[n]is None for n in('actual_source','actual_ref','actual_run')),'current authority NULL')
 actual=rows(C.ROOT);need(len(actual)==1185,'complete1185 current source');old={}
 for n,w in p['before'].items():
  if n in p['before_bodies_zlib']:
   d=zlib.decompressobj();b=d.decompress(base64.b64decode(p['before_bodies_zlib'][n],validate=True),16*1024**2+1);need(d.eof and not d.unused_data and not d.unconsumed_tail,'complete bounded before codec')
  else:b=C.read(C.ROOT/n)
  need(pin(b)==w,'whole1182 source body '+n);old[n]=b
 helper=C.read(C.HERE/'producer_diagnostic.py');proof=C.read(C.HERE/'producer_source.py');need(pin(proof.replace(PARENT_PIN.encode(),b'PARENT_PIN_PLACEHOLDER'))==p['proof_template'],'whole current source guard self-template');expected=transformed(old,helper,proof,raw);need(actual=={n:pin(b)for n,b in expected.items()},'entire1185 source emission')
 return p,old,actual

def verify():
 p,old,actual=inverse()
 # Exact trusted source-only child; no runtime arguments, collected code or API.
 with tempfile.TemporaryDirectory(prefix='producer-diagnostic-parent1182-')as td:
  root=Path(td)/'source';root.mkdir(mode=0o700)
  for n,b in old.items():q=root/n;q.parent.mkdir(parents=True,exist_ok=True);q.write_bytes(b)
  need(rows(root)==p['before'],'whole1182 reconstruction before original entry');env={k:v for k,v in os.environ.items()if k not in('GH_TOKEN','GITHUB_TOKEN','PYTHONPATH','PYTHONHOME')}
  result=subprocess.run([sys.executable,'-I','-B','-Werror',str(root/'implementation/run.py'),'--source-preflight'],stdin=subprocess.DEVNULL,capture_output=True,timeout=300,env=env);need(result.returncode==0 and not result.stderr and len(result.stdout)<65536,'complete1182 AND1180 AND1178 source entry');v=json.loads(result.stdout);need(v['files']==1182 and v['status']=='PASS_SOURCE_ONLY_COMPLETE574_CACHE_CURRENT_CONTROLS_CHILD','exact parent source proof')
  need(rows(root)==p['before']and rows(C.ROOT)==actual,'complete source before/after identity bytes held')
 return dict(v,status='PASS_SOURCE_ONLY_FIXED_PRODUCER_BUILD_FAILURE_DIAGNOSTICS',files=1185,parent_files=1182,held=1177,changed=5,added=3,parent_status=v['status'],parent_proof=v,diagnostic='FAILURE_ONLY_EXISTING_PRODUCER_JSON',actual_source=None,actual_ref=None,actual_run=None,root_acceptance='NOT_ISSUED',hardware='NOT_RUN')
