"""Childless rendezvous: runner owns actual slurp; forward its real stdout."""
import os
from pathlib import Path
import re
import runpy
import socket
import stat
import struct
import sys
import time

if sys.argv[1:]!=['-f','%x,%y %wx%h']:raise ValueError('exact helper slurp arguments required')
token=os.environ.get('REGION_CUSTODY_TOKEN','')
if re.fullmatch('[0-9a-f]{32}',token) is None:raise ValueError('owned rendezvous nonce required')
parent=os.environ.get('REGION_CUSTODY_PARENT_PID','')
if re.fullmatch('[1-9][0-9]{0,9}',parent) is None:raise ValueError('runner PID required')
path=Path('/tmp/screenshot-runtime/region-custody.sock');root=path.parent.lstat();node=path.lstat()
if not stat.S_ISDIR(root.st_mode) or root.st_uid!=os.getuid() or stat.S_IMODE(root.st_mode)!=0o700:
    raise ValueError('private custody runtime required')
if not stat.S_ISSOCK(node.st_mode) or node.st_uid!=os.getuid() or stat.S_IMODE(node.st_mode)!=0o600:
    raise ValueError('owned custody socket required')
protocol=runpy.run_path('/source/scripts/ci/screenshot-headless-native/region_trial.py')
with socket.socket(socket.AF_UNIX,socket.SOCK_STREAM) as conn:
    conn.settimeout(3);conn.connect(str(path))
    pid,uid,gid=struct.unpack('=iII',conn.getsockopt(socket.SOL_SOCKET,socket.SO_PEERCRED,12))
    if pid!=int(parent) or uid!=os.getuid() or gid!=os.getgid():raise ValueError('actual runner credentials required')
    protocol['packet_send'](conn,{'schema':1,'token':token,'pid':os.getpid(),'ppid':os.getppid(),'args':sys.argv[1:]})
    reply=protocol['packet_read'](conn,time.monotonic()+20)
    if type(reply) is not dict or set(reply)!={'schema','code','stdout_hex'} or type(reply['schema']) is not int or reply['schema']!=1:
        raise ValueError('exact real slurp reply required')
    if type(reply['code']) is not int or not -64<=reply['code']<=255 or type(reply['stdout_hex']) is not str or len(reply['stdout_hex'])>256:
        raise ValueError('bounded real slurp result required')
    body=bytes.fromhex(reply['stdout_hex'])
    if os.write(1,body)!=len(body):raise ValueError('complete actual slurp stdout forwarding')
    raise SystemExit(reply['code'] if reply['code']>=0 else 128-reply['code'])
