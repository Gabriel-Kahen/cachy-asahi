name: native-arm-perl5423-baseline-observation-v1
on:
  workflow_dispatch:
    inputs:
      source_sha: {type: string, required: true}
      source_map_sha256: {type: string, required: true}
      approval_sha256: {type: string, required: true}
      root_admission_json: {type: string, required: true}
      operation:
        type: choice
        required: true
        default: perl5423-baseline-observation-native-v1
        options: [perl5423-baseline-observation-native-v1]
permissions:
  contents: read
  actions: read
concurrency:
  group: native-arm-build
  cancel-in-progress: false
  queue: max
jobs:
  native:
    name: perl5423-baseline-observation-native-v1
    if: github.repository == 'Gabriel-Kahen/cachy-asahi' && github.event.repository.private == false
    runs-on: ubuntu-24.04-arm
    timeout-minutes: 120
    defaults:
      run:
        shell: bash
    env:
      PYTHONDONTWRITEBYTECODE: '1'
      SOURCE_SHA: ${{ inputs.source_sha }}
      SOURCE_MAP_SHA256: ${{ inputs.source_map_sha256 }}
      ROOT_APPROVAL_SHA256: ${{ inputs.approval_sha256 }}
      ROOT_ADMISSION_JSON: ${{ inputs.root_admission_json }}
      BASELINE_OPERATION: ${{ inputs.operation }}
      INPUTS_SHA256: beca39e04e125a0fa72dedab2dd772e048655d80c36c216a031df0a0c3852e8f
    steps:
      - name: Checkout exact Root-published closed Source
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        timeout-minutes: 2
        with:
          ref: ${{ inputs.source_sha }}
          persist-credentials: false
      - name: Verify complete Source before existing secrets
        timeout-minutes: 3
        run: |
          set -euo pipefail
          printf '%s  %s\n' '__COMMON_SHA__' hosted/common.py '__ENTRY_SHA__' hosted/entry.py | sha256sum --check
          cmp --silent .github/workflows/native-arm-build.yml .github/workflows/native-arm-perl5423-baseline-observation-v1.yml
          python3 -I -B - <<'PYROOT'
          import os
          from pathlib import Path
          Path(os.environ['RUNNER_TEMP'],'perl-baseline-root-admission.json').write_text(os.environ['ROOT_ADMISSION_JSON'])
          PYROOT
          timeout --signal=TERM --kill-after=30s 170s python3 -I -B hosted/entry.py proof --source-sha "$SOURCE_SHA" --map-sha256 "$SOURCE_MAP_SHA256" --approval-sha256 "$ROOT_APPROVAL_SHA256"
      - name: Seed the six exact retained inputs using existing secrets only
        timeout-minutes: 2
        env:
          CACHY_RETAINED_BUBBLEWRAP_V1_PACKAGE_01: ${{ secrets.CACHY_RETAINED_BUBBLEWRAP_V1_PACKAGE_01 }}
          CACHY_RETAINED_BUBBLEWRAP_V1_PACKAGE_02: ${{ secrets.CACHY_RETAINED_BUBBLEWRAP_V1_PACKAGE_02 }}
          CACHY_RETAINED_BUBBLEWRAP_V1_SIGNATURE_01: ${{ secrets.CACHY_RETAINED_BUBBLEWRAP_V1_SIGNATURE_01 }}
          CACHY_OLD_FOUR_SCHEMA: '1'
          CACHY_OLD_FOUR_SOURCE_EPOCH: '1791748800'
          CACHY_OLD_FOUR_JBIGKIT_01: ${{ secrets.CACHY_OLD_FOUR_JBIGKIT_01 }}
          CACHY_OLD_FOUR_JBIGKIT_02: ${{ secrets.CACHY_OLD_FOUR_JBIGKIT_02 }}
          CACHY_OLD_FOUR_JBIGKIT_SIG_01: ${{ secrets.CACHY_OLD_FOUR_JBIGKIT_SIG_01 }}
          CACHY_OLD_FOUR_LIBTIFF_01: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_01 }}
          CACHY_OLD_FOUR_LIBTIFF_02: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_02 }}
          CACHY_OLD_FOUR_LIBTIFF_03: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_03 }}
          CACHY_OLD_FOUR_LIBTIFF_04: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_04 }}
          CACHY_OLD_FOUR_LIBTIFF_05: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_05 }}
          CACHY_OLD_FOUR_LIBTIFF_06: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_06 }}
          CACHY_OLD_FOUR_LIBTIFF_07: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_07 }}
          CACHY_OLD_FOUR_LIBTIFF_08: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_08 }}
          CACHY_OLD_FOUR_LIBTIFF_09: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_09 }}
          CACHY_OLD_FOUR_LIBTIFF_10: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_10 }}
          CACHY_OLD_FOUR_LIBTIFF_11: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_11 }}
          CACHY_OLD_FOUR_LIBTIFF_12: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_12 }}
          CACHY_OLD_FOUR_LIBTIFF_13: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_13 }}
          CACHY_OLD_FOUR_LIBTIFF_14: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_14 }}
          CACHY_OLD_FOUR_LIBTIFF_15: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_15 }}
          CACHY_OLD_FOUR_LIBTIFF_SIG_01: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_SIG_01 }}
        run: |
          set -euo pipefail
          test "$INPUTS_SHA256" = beca39e04e125a0fa72dedab2dd772e048655d80c36c216a031df0a0c3852e8f
          printf '%s  %s\n' "$INPUTS_SHA256" original/bootstrap/scripts/ci/inputs.lock.json | sha256sum --check
          timeout --signal=TERM --kill-after=5s 75s python3 -B - <<'PYSEED'
          import hashlib
          import os
          from pathlib import Path
          import sys
          sys.path.insert(0, 'original/bootstrap/scripts/ci')
          from old_four_seed import (OLD_FOUR_PRIVATE_ROWS, RETAINED_BUBBLEWRAP_PRIVATE_ROWS,
                                     seed_current_build_cache)
          pin = 'beca39e04e125a0fa72dedab2dd772e048655d80c36c216a031df0a0c3852e8f'
          if hashlib.sha256(Path('original/bootstrap/scripts/ci/inputs.lock.json').read_bytes()).hexdigest() != pin:
              raise SystemExit('private-cache-input-binding-refused')
          names = {'CACHY_OLD_FOUR_' + f'{tag}_{i:02d}'
                   for _, _, _, tag, count in OLD_FOUR_PRIVATE_ROWS for i in range(1, count + 1)}
          retained = {'CACHY_RETAINED_BUBBLEWRAP_V1_' + f'{tag}_{i:02d}'
                      for _, _, _, tag, sizes in RETAINED_BUBBLEWRAP_PRIVATE_ROWS
                      for i in range(1, len(sizes) + 1)}
          names |= retained
          if len(names) != 22 or len(retained) != 3 or not all(os.environ.get(name) for name in names):
              raise SystemExit('private-cache-required-secrets-missing')
          cache = Path(os.environ['RUNNER_TEMP']) / 'alarm-cache'
          cache.mkdir(mode=0o700)
          keep = names | {'CACHY_OLD_FOUR_SCHEMA', 'CACHY_OLD_FOUR_SOURCE_EPOCH'}
          for name in tuple(os.environ):
              if name not in keep:
                  os.environ.pop(name)
          seed_current_build_cache(cache, pin)
          PYSEED
      - name: Checkout the exact fourteen public input source
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        timeout-minutes: 1
        with:
          ref: 04a4a74e16e1e1bc939ea74791bf1f1bf7b46bbd
          path: source-public14
          persist-credentials: false
      - name: Seed all fourteen exact public input files into the existing cache
        timeout-minutes: 1
        run: |
          set -euo pipefail
          printf '%s  %s\n' 'a7857658af224984065e575f6ffed8308ea85027d46eace8bda146d9033e93b3' source-public14/seed.py 'a388c8c8ba8e06cb92fd2be598b86e433c4e403b6e71a0f15b1eaec381bb7300' source-public14/index.json | sha256sum --check
          env -i PATH=/usr/local/bin:/usr/bin:/bin HOME="$RUNNER_TEMP/native-developer-work/home" LANG=C.UTF-8 TZ=UTC TMPDIR="$RUNNER_TEMP" PYTHONDONTWRITEBYTECODE=1 \
            python3 -I -B "$GITHUB_WORKSPACE/source-public14/seed.py" --cache "$RUNNER_TEMP/alarm-cache"
          test ! -e "$RUNNER_TEMP/native-developer-public14"
          mv -- "$GITHUB_WORKSPACE/source-public14" "$RUNNER_TEMP/native-developer-public14"
      - name: Read actual job binding with existing Actions token
        timeout-minutes: 1
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          python3 -I -B hosted/entry.py metadata --source-sha "$SOURCE_SHA" --map-sha256 "$SOURCE_MAP_SHA256" --approval-sha256 "$ROOT_APPROVAL_SHA256"
      - name: Transport exact original retained DATA once
        timeout-minutes: 9
        run: |
          set -euo pipefail
          timeout --signal=TERM --kill-after=30s 500s python3 -I -B hosted/entry.py inputs --source-sha "$SOURCE_SHA" --map-sha256 "$SOURCE_MAP_SHA256" --approval-sha256 "$ROOT_APPROVAL_SHA256"
      - name: Signed349 bootstrap and separate read-only baseline observer
        timeout-minutes: 90
        run: |
          set -euo pipefail
          timeout --signal=TERM --kill-after=240s 5100s python3 -I -B hosted/entry.py native --source-sha "$SOURCE_SHA" --map-sha256 "$SOURCE_MAP_SHA256" --approval-sha256 "$ROOT_APPROVAL_SHA256" --execute
      - name: Retain original observation evidence for separate Root review
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
        timeout-minutes: 3
        with:
          name: perl5423-baseline-observation-native-v1-${{ github.run_id }}-${{ github.run_attempt }}
          if-no-files-found: ignore
          include-hidden-files: true
          retention-days: 3
          path: |
            ${{ runner.temp }}/perl-baseline-observation/hosted.json
            ${{ runner.temp }}/perl-baseline-observation/source-readback.json
            ${{ runner.temp }}/perl-baseline-observation/daemon.json
            ${{ runner.temp }}/perl-baseline-observation/binding.json
            ${{ runner.temp }}/perl-baseline-observation/job-metadata.json
            ${{ runner.temp }}/perl-baseline-observation/input-transport.json
            ${{ runner.temp }}/perl-baseline-observation/proof/**
            ${{ runner.temp }}/perl-baseline-observation/bootstrap/inputs.lock.json
            ${{ runner.temp }}/perl-baseline-observation/bootstrap/acquisition.json
            ${{ runner.temp }}/perl-baseline-observation/bootstrap/signatures.json
            ${{ runner.temp }}/perl-baseline-observation/bootstrap/packages.lock
            ${{ runner.temp }}/perl-baseline-observation/bootstrap/bootstrap.json
            ${{ runner.temp }}/perl-baseline-observation/bootstrap/proof.json
            ${{ runner.temp }}/perl-baseline-observation/bootstrap/input-data-preparation.json
            ${{ runner.temp }}/perl-baseline-observation/bootstrap/fixed-eight-cache.json
            ${{ runner.temp }}/perl-baseline-observation/bootstrap/operations.json
            ${{ runner.temp }}/perl-baseline-observation/bootstrap/operations/**
            ${{ runner.temp }}/perl-baseline-observation/bootstrap/image-inspect.json
            ${{ runner.temp }}/perl-baseline-observation/observation-binding.json
            ${{ runner.temp }}/perl-baseline-observation/observation.json
            ${{ runner.temp }}/perl-baseline-observation/observer-domain.json
