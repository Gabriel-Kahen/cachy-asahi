[Unit]
Description=Exact signed Core7 automatic-hook case
DefaultDependencies=no
Before=caa-core-probe.service
[Service]
Slice=system.slice
Type=oneshot
ExecStart=/usr/bin/python3 -I -B /workspace/guest.py worker
TimeoutStartSec=3300
TimeoutStopSec=60
StandardInput=null
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyAMA0
