
# Whole-source custody and finite predecessor inverse.
import base64,builtins,sys,types
from pathlib import Path
TEMPLATE_SHA='@SELF@'
PARENT=@PARENT@
EDITS=@EDITS@
SEALS=@SEALS@
def run_original(values,module):
 """Execute each complete fixed original source predicate over its immutable map."""
 class MemoryPath:
  def __init__(self,value=''):self.value=str(value);self.name=self.value
  def __str__(self):return self.value
  def __lt__(self,other):return self.value<other.value
  def __truediv__(self,other):return MemoryPath(self.value+'/'+str(other)if self.value else str(other))
  def absolute(self):return self
  def rglob(self,pattern):return[MemoryPath(n)for n in sorted(values)]
  def relative_to(self,root):return MemoryPath(self.value)
  def as_posix(self):return self.value
  def is_symlink(self):return False
  def is_file(self):return True
  def is_dir(self):return False
 import case as C
 case=types.ModuleType('case');case.__dict__.update(vars(C));case.read=lambda p,*args:values[p.value]
 X=types.ModuleType('xattr_diagnostic');exec(compile(values['xattr_diagnostic.py'],'whole-fixed-xattr-source','exec'),vars(X));X.read=lambda p:values[p.value]
 def imports(name,*args,**kwargs):return case if name=='case'else builtins.__import__(name,*args,**kwargs)
 original=types.ModuleType('_whole_fixed_source');exec(compile(values[module],module,'exec'),vars(original));scope=dict(vars(original),Path=MemoryPath,__builtins__=dict(vars(builtins),__import__=imports));prior=dict(sys.modules)
 try:
  sys.modules['xattr_diagnostic']=X
  return types.FunctionType(original.prove.__code__,scope)('')
 finally:
  for name in set(sys.modules)-set(prior):sys.modules.pop(name,None)
  sys.modules.update(prior)

def inverse(values):
 need(set(values)==set(PARENT)|{'journal_acl.py'},'entire journal44 namespace')
 raw=values['journal_acl.py'];needle=('TEMPLATE_SHA='+repr(TEMPLATE_SHA)).encode();need(raw.count(needle)==1,'one journal guard self seal');need(hashlib.sha256(raw.replace(needle,b"TEMPLATE_SHA='@SELF@'",1)).hexdigest()==TEMPLATE_SHA,'whole journal policy/source guard')
 restored=dict(values);restored.pop('journal_acl.py')
 for name,edits in EDITS.items():
  text=restored[name].decode()
  for before,after in reversed(edits):need(text.count(after)==1,'one counted whole journal inverse');text=text.replace(after,before,1)
  restored[name]=text.encode()
 for name,body in SEALS.items():restored[name]=base64.b64decode(body,validate=True)
 need({n:pin(b)for n,b in restored.items()}==PARENT,'entire exact published43 inverse; all other clocks/security/runtime bodies held');return restored

def verify(values):
 restored=inverse(values);C=__import__('case');manifest=dict(schema=1,purpose='CORE7_REAL_HOOKS_AND_ACTUAL_PID1_SOURCE_ONLY',actual=None,files={n:pin(b)for n,b in values.items()if n!='source-manifest.json'and not n.startswith('.github/')});need(values['source-manifest.json']==C.encoded(manifest),'whole current journal source manifest')
 workflow=values['workflow.yml.in'].replace(b'@ENTRY_SHA@',pin(values['entry.py'])['sha256'].encode()).replace(b'@MANIFEST_SHA@',pin(values['source-manifest.json'])['sha256'].encode());need(all(values[n]==workflow for n in('.github/workflows/native-arm-build.yml','.github/workflows/native-arm-core7-real-systemd.yml')),'two exact journal workflows');return restored

def prove(root):
 import case as C
 root=Path(root).absolute();values={}
 for path in sorted(root.rglob('*')):
  name=path.relative_to(root).as_posix()
  if name.split('/')[0]=='.git':continue
  need(not path.is_symlink()and(path.is_file()or path.is_dir()),'ordinary complete journal source')
  if path.is_file():values[name]=C.read(path,4*1024**2)
 restored=verify(values);prior=run_original(restored,'vm_validation.py');need(prior['files']==43 and prior['parent_files']==42 and prior['ancestor_files']==[41,41,40,39],'all original43/42/41/41/40/39 source guards')
 return dict(status='PASS_SOURCE_ONLY_TYPED_JOURNAL_ACL_WHOLE43_42_41_41_40_39',files=44,parent_files=43,ancestor_files=[42,41,41,40,39],profile=prior['profile'],source=None,ref=None,run=None,actual=None,acceptance=False,native_hotspot='UNKNOWN')
