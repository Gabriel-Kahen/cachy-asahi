
# Finite source-only lexical successor. Reconstruct published41, then execute
# its entire source41->40->39 predicate without writes or acceptance transfer.
_published41_prove = prove
OBSERVER_TEMPLATE_SHA = '@SELF@'
SOURCE41 = @SOURCE41@
SEALS41 = @SEALS41@
LEXICAL_BODY = @LEXICAL@
CAPTURE_BEFORE = @BEFORE@
CAPTURE_AFTER = @AFTER@
ROOT_BEFORE = @ROOT_BEFORE@
ROOT_AFTER = @ROOT_AFTER@

def published41(values):
 need(set(values) == set(SOURCE41), 'whole lexical successor41 membership')
 text = values['acl_policy.py'].decode()
 needle = "OBSERVER_TEMPLATE_SHA = " + repr(OBSERVER_TEMPLATE_SHA)
 need(text.count(needle) == 1, 'one lexical self seal')
 normalized = text.replace(needle, "OBSERVER_TEMPLATE_SHA = '@SELF@'", 1)
 need(hashlib.sha256(normalized.encode()).hexdigest() == OBSERVER_TEMPLATE_SHA,
      'entire lexical implementation and inverse body')
 marker = '\n# Finite source-only lexical successor.'
 need(text.count(marker) == 1, 'one lexical whole-body boundary')
 prefix = text.split(marker)[0]
 for before, after in ((CAPTURE_BEFORE, CAPTURE_AFTER), (ROOT_BEFORE, ROOT_AFTER), ('', LEXICAL_BODY)):
  need(prefix.count(after) == 1, 'one lexical inverse seam')
  prefix = prefix.replace(after, before, 1)
 restored = dict(values, **{'acl_policy.py': prefix.encode()})
 for name, raw in SEALS41.items():
  restored[name] = base64.b64decode(raw, validate=True)
 need({n: pin(b) for n, b in restored.items()} == SOURCE41,
      'entire exact published41 inverse including all held files')
 return restored

def prove(root):
 import xattr_diagnostic as X
 root = Path(root).absolute()
 values = {}
 for path in sorted(root.rglob('*')):
  name = path.relative_to(root).as_posix()
  if name.split('/')[0] == '.git':
   continue
  need(not path.is_symlink() and (path.is_file() or path.is_dir()),
       'ordinary whole lexical successor')
  if path.is_file():
   values[name] = X.read(path)
 restored = published41(values)
 class MemoryPath:
  def __init__(self, name=''): self.name = str(name)
  def __lt__(self, other): return self.name < other.name
  def absolute(self): return self
  def as_posix(self): return self.name
  def rglob(self, pattern): return [MemoryPath(n) for n in sorted(restored)]
  def relative_to(self, root): return Path(self.name)
  def is_symlink(self): return False
  def is_file(self): return True
  def is_dir(self): return False
 # The original prove body imports X; give it an immutable, scoped read facade.
 facade = types.ModuleType('xattr_diagnostic')
 facade.__dict__.update(vars(X))
 facade.read = lambda p: restored[p.name]
 import builtins
 def imports(name, *args, **kwargs):
  return facade if name == 'xattr_diagnostic' else builtins.__import__(name, *args, **kwargs)
 scope = dict(globals(), Path=MemoryPath, __builtins__=dict(vars(builtins), __import__=imports))
 prior = types.FunctionType(_published41_prove.__code__, scope)('')
 need(prior['files'] == 41 and prior['parent_files'] == 40 and prior['ancestor_files'] == 39,
      'entire published41->40->39 bodies executed')
 return dict(status='PASS_LEXICAL_WHOLE41_AND40_AND39_INVERSE', files=41,
             parent_files=41, ancestor_files=[40, 39], actual=None)
