name: native-arm-gnu-immutable-source
on:
  workflow_dispatch:
    inputs:
      source_sha:
        description: Exact source/workflow; genuine independent boot qualification required
        type: string
        required: true
permissions:
  contents: read
  actions: read
concurrency:
  group: native-arm-gnu-immutable-source
  cancel-in-progress: false
jobs:
  native:
    if: github.repository == 'Gabriel-Kahen/cachy-asahi' && github.event.repository.private == false
    runs-on: ubuntu-24.04-arm
    timeout-minutes: 360
    defaults:
      run:
        shell: bash
        working-directory: immutable-source/runtime/runtime-vm
    env:
      PYTHONDONTWRITEBYTECODE: '1'
      SOURCE_SHA: ${{ inputs.source_sha }}
      WORKFLOW_SHA: ${{ github.workflow_sha }}
      SLICE: ${{ github.workspace }}/immutable-source/runtime/runtime-vm/scripts/ci/glibc-debian-maintained-public-provider-lifecycle-owner
      BUNDLE: ${{ github.workspace }}/immutable-source/runtime/runtime-vm
      DEPLOY: ${{ github.workspace }}/immutable-source/scripts/ci/gnu-immutable-source-native
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        timeout-minutes: 3
        with:
          ref: ${{ inputs.source_sha }}
          path: immutable-source
          persist-credentials: false
      - name: Whole source and maintained phase gates before credentials or actors
        timeout-minutes: 4
        run: |
          set -euo pipefail
          printf '%s  %s\n' '@ENTRY_SHA@' "$DEPLOY/entry.py" '@MANIFEST_SHA@' "$DEPLOY/source-manifest.json" | sha256sum --check
          python3 -I -B "$DEPLOY/entry.py" source --source "$GITHUB_WORKSPACE/immutable-source"
          python3 -I -B "$DEPLOY/test_deployment.py" --source "$GITHUB_WORKSPACE/immutable-source"
          python3 -I -B "$GITHUB_WORKSPACE/immutable-source/runtime/immutable/test_controls.py"
      - name: Genuine independent boot availability and private input selection
        timeout-minutes: 2
        run: |
          set -euo pipefail
          mkdir -m 0700 "$RUNNER_TEMP/gnu-immutable-parent"
          python3 -I -B "$DEPLOY/entry.py" bind --source "$GITHUB_WORKSPACE/immutable-source" --output "$RUNNER_TEMP/gnu-immutable-parent/selection"
      - name: Acquire exact existing kernel20 artifact with prior original transport replay
        timeout-minutes: 6
        env:
          GITHUB_TOKEN: ${{ github.token }}
        run: >-
          python3 -I -B "$DEPLOY/entry.py" kernel --source "$GITHUB_WORKSPACE/immutable-source" --output "$RUNNER_TEMP/gnu-immutable-parent/selection/kernel"
      - name: Require Root-bound source and immutable packet policy before secrets or native actors
        id: proof
        timeout-minutes: 2
        run: |
          set -euo pipefail
          printf '%s  %s\n' 'f2d024c1209d8e467c9d7a86c342ea636dc22725c7e7de69c9bd36a6f8db91dc' "$SLICE/job.py" | sha256sum --check
          python3 -I -B "$SLICE/job.py" proof --workspace "$BUNDLE" --proof "$RUNNER_TEMP/provider-lifecycle-proof.json"
      - name: Checkout only the exact Root-bound actual input packet
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        timeout-minutes: 3
        with:
          ref: ${{ steps.proof.outputs.packet_ref }}
          path: lifecycle-packet
          persist-credentials: false
      - name: Verify exact public compilepair normal clients held rollback and source authority before secrets
        id: packet
        timeout-minutes: 4
        run: |
          set -euo pipefail
          test "$(git -C "$GITHUB_WORKSPACE/lifecycle-packet" rev-parse HEAD)" = '${{ steps.proof.outputs.packet_ref }}'
          python3 -I -B "$SLICE/job.py" packet --workspace "$BUNDLE" --packet-root "$GITHUB_WORKSPACE/lifecycle-packet"
      - name: Prefetch exact32 original frozen574 archive files
        timeout-minutes: 4
        run: >-
          python3 -I -B "$DEPLOY/archive32.py" --policy "$DEPLOY/archive32-policy.json"
          --inputs "$BUNDLE/scripts/ci/maintained-desktop574-inputs.json" --cache "$RUNNER_TEMP/immutable-archive32"
      - name: Prefetch exact20 additional original frozen574 archive files
        timeout-minutes: 4
        run: >-
          python3 -I -B "$DEPLOY/archive20.py" --policy "$DEPLOY/archive20-policy.json"
          --inputs "$BUNDLE/scripts/ci/maintained-desktop574-inputs.json" --cache "$RUNNER_TEMP/immutable-archive20"
      - name: Prefetch exact8 additional original frozen574 archive files
        timeout-minutes: 4
        run: >-
          python3 -I -B "$DEPLOY/archive8.py" --policy "$DEPLOY/archive8-policy.json"
          --inputs "$BUNDLE/scripts/ci/maintained-desktop574-inputs.json" --cache "$RUNNER_TEMP/immutable-archive8"
      - name: Seed the six existing private input files using unchanged secrets
        timeout-minutes: 2
        env:
          CACHY_RETAINED_BUBBLEWRAP_V1_PACKAGE_01: ${{ secrets.CACHY_RETAINED_BUBBLEWRAP_V1_PACKAGE_01 }}
          CACHY_RETAINED_BUBBLEWRAP_V1_PACKAGE_02: ${{ secrets.CACHY_RETAINED_BUBBLEWRAP_V1_PACKAGE_02 }}
          CACHY_RETAINED_BUBBLEWRAP_V1_SIGNATURE_01: ${{ secrets.CACHY_RETAINED_BUBBLEWRAP_V1_SIGNATURE_01 }}
          CACHY_OLD_FOUR_SCHEMA: '1'
          CACHY_OLD_FOUR_SOURCE_EPOCH: '1791748800'
          CACHY_OLD_FOUR_JBIGKIT_01: ${{ secrets.CACHY_OLD_FOUR_JBIGKIT_01 }}
          CACHY_OLD_FOUR_JBIGKIT_02: ${{ secrets.CACHY_OLD_FOUR_JBIGKIT_02 }}
          CACHY_OLD_FOUR_JBIGKIT_SIG_01: ${{ secrets.CACHY_OLD_FOUR_JBIGKIT_SIG_01 }}
          CACHY_OLD_FOUR_LIBTIFF_01: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_01 }}
          CACHY_OLD_FOUR_LIBTIFF_02: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_02 }}
          CACHY_OLD_FOUR_LIBTIFF_03: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_03 }}
          CACHY_OLD_FOUR_LIBTIFF_04: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_04 }}
          CACHY_OLD_FOUR_LIBTIFF_05: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_05 }}
          CACHY_OLD_FOUR_LIBTIFF_06: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_06 }}
          CACHY_OLD_FOUR_LIBTIFF_07: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_07 }}
          CACHY_OLD_FOUR_LIBTIFF_08: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_08 }}
          CACHY_OLD_FOUR_LIBTIFF_09: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_09 }}
          CACHY_OLD_FOUR_LIBTIFF_10: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_10 }}
          CACHY_OLD_FOUR_LIBTIFF_11: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_11 }}
          CACHY_OLD_FOUR_LIBTIFF_12: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_12 }}
          CACHY_OLD_FOUR_LIBTIFF_13: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_13 }}
          CACHY_OLD_FOUR_LIBTIFF_14: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_14 }}
          CACHY_OLD_FOUR_LIBTIFF_15: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_15 }}
          CACHY_OLD_FOUR_LIBTIFF_SIG_01: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_SIG_01 }}
        run: >-
          python3 -I -B scripts/ci/maintained_desktop574.py seed
          --inputs scripts/ci/maintained-desktop574-inputs.json
          --output "$RUNNER_TEMP/desktop574"
      - name: Checkout exact fourteen public input files
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        timeout-minutes: 3
        with:
          ref: 04a4a74e16e1e1bc939ea74791bf1f1bf7b46bbd
          path: retained-public-inputs
          persist-credentials: false
      - name: Seed the exact public inputs without secrets
        timeout-minutes: 3
        run: |
          set -euo pipefail
          test "$(git -C "$GITHUB_WORKSPACE/retained-public-inputs" rev-parse HEAD)" = 04a4a74e16e1e1bc939ea74791bf1f1bf7b46bbd
          printf '%s  %s\n' 'a7857658af224984065e575f6ffed8308ea85027d46eace8bda146d9033e93b3' "$GITHUB_WORKSPACE/retained-public-inputs/seed.py" 'a388c8c8ba8e06cb92fd2be598b86e433c4e403b6e71a0f15b1eaec381bb7300' "$GITHUB_WORKSPACE/retained-public-inputs/index.json" | sha256sum --check
          env -i PATH=/usr/local/bin:/usr/bin:/bin HOME="$RUNNER_TEMP" LANG=C.UTF-8 TZ=UTC TMPDIR="$RUNNER_TEMP" python3 -I -B "$GITHUB_WORKSPACE/retained-public-inputs/seed.py" --cache "$RUNNER_TEMP/desktop574/context/deps"
      - name: Seed exact32 verified original bytes before unchanged build
        timeout-minutes: 2
        run: >-
          python3 -I -B "$DEPLOY/pipeline.py" seed-archive --source "$GITHUB_WORKSPACE/immutable-source"
          --cache "$RUNNER_TEMP/immutable-archive32" --base "$RUNNER_TEMP/desktop574"
      - name: Seed exact20 verified original bytes before unchanged build
        timeout-minutes: 2
        run: >-
          python3 -I -B "$DEPLOY/pipeline.py" seed-archive20 --source "$GITHUB_WORKSPACE/immutable-source"
          --cache "$RUNNER_TEMP/immutable-archive20" --base "$RUNNER_TEMP/desktop574"
      - name: Seed exact8 verified original bytes before unchanged build
        timeout-minutes: 2
        run: >-
          python3 -I -B "$DEPLOY/pipeline.py" seed-archive8 --source "$GITHUB_WORKSPACE/immutable-source"
          --cache "$RUNNER_TEMP/immutable-archive8" --base "$RUNNER_TEMP/desktop574"
      - name: Reuse unchanged owned574 native producer
        timeout-minutes: 40
        env:
          JOB_TOKEN: ${{ steps.proof.outputs.job_token }}
        run: >-
          timeout --signal=TERM --kill-after=10s 2300s
          python3 -I -B scripts/ci/maintained_desktop574.py build
          --inputs scripts/ci/maintained-desktop574-inputs.json
          --output "$RUNNER_TEMP/desktop574" --job-token "$JOB_TOKEN"
      - name: Snapshot original574 and establish NEW maintained native installation from public compile inputs
        timeout-minutes: 80
        run: |
          set -euo pipefail
          python3 -I -B "$SLICE/job.py" execute --workspace "$BUNDLE" \
            --packet-root "$GITHUB_WORKSPACE/lifecycle-packet" --proof "$RUNNER_TEMP/provider-lifecycle-proof.json" \
            --base "$RUNNER_TEMP/desktop574" --output "$RUNNER_TEMP/provider-lifecycle-owner"
      - name: Provision original finite QEMU tools on disposable runner
        timeout-minutes: 8
        run: |
          set -euo pipefail
          docker version >/dev/null
          timeout --kill-after=10s 180s sudo apt-get -o Acquire::Retries=0 -o Acquire::http::Timeout=30 update -qq
          timeout --kill-after=10s 240s sudo env DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=0 -o Acquire::http::Timeout=30 install -y --no-install-recommends qemu-system-arm zstd ca-certificates
      - name: Actual new-purpose immutable source current574 lifecycle
        id: immutable
        timeout-minutes: 220
        run: >-
          python3 -I -B "$DEPLOY/pipeline.py" consume --source "$GITHUB_WORKSPACE/immutable-source"
          --owner "$RUNNER_TEMP/provider-lifecycle-owner" --base "$RUNNER_TEMP/desktop574"
          --binding "$RUNNER_TEMP/gnu-immutable-parent/selection" --kernel "$RUNNER_TEMP/gnu-immutable-parent/selection/kernel"
          --output /tmp/caa-gnu-immutable-runtime
      - name: Retire all new and native consumers before original producer
        if: always() && steps.proof.outcome == 'success'
        timeout-minutes: 15
        run: >-
          python3 -I -B "$DEPLOY/pipeline.py" cleanup --source "$GITHUB_WORKSPACE/immutable-source"
          --output /tmp/caa-gnu-immutable-runtime --owner "$RUNNER_TEMP/provider-lifecycle-owner"
          --base "$RUNNER_TEMP/desktop574" --proof "$RUNNER_TEMP/provider-lifecycle-proof.json"
          --receipt "$RUNNER_TEMP/provider-lifecycle-cleanup.json"
      - name: Retain only closed bounded actual lifecycle receipts inputs and source snapshot metadata
        if: always() && steps.proof.outcome == 'success'
        timeout-minutes: 5
        run: |
          set -euo pipefail
          retain_status=0
          python3 -I -B "$SLICE/job.py" retain --workspace "$BUNDLE" \
            --proof "$RUNNER_TEMP/provider-lifecycle-proof.json" --base "$RUNNER_TEMP/desktop574" \
            --output "$RUNNER_TEMP/provider-lifecycle-owner" --receipt "$RUNNER_TEMP/provider-lifecycle-cleanup.json" \
            --packet-root "$GITHUB_WORKSPACE/lifecycle-packet" --public "$RUNNER_TEMP/provider-lifecycle-public" || retain_status=$?
          summary_status=0
          printf '%s  %s\n' '9bd52ce4453a3a03d8dc8b5edb6b6a4b8ec421e0c3037dfb64dc31da45687555' 'scripts/ci/glibc-gnu-failure-log/summary.py' | sha256sum --check || summary_status=$?
          if [ "$summary_status" -eq 0 ]; then
            python3 -I -B scripts/ci/glibc-gnu-failure-log/summary.py emit --lane lifecycle \
              --proof "$RUNNER_TEMP/provider-lifecycle-proof.json" --owner "$RUNNER_TEMP/provider-lifecycle-owner" \
              --cleanup "$RUNNER_TEMP/provider-lifecycle-cleanup.json" --public "$RUNNER_TEMP/provider-lifecycle-public" \
              --retain-exit "$retain_status" || summary_status=$?
          fi
          if [ "$retain_status" -ne 0 ]; then exit "$retain_status"; fi
          exit "$summary_status"
      - name: Upload only the closed provider lifecycle public packet
        if: always() && steps.proof.outcome == 'success'
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
        timeout-minutes: 5
        with:
          name: glibc-debian-maintained-public-provider-lifecycle-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/provider-lifecycle-public/
          retention-days: 3
          compression-level: 0
          include-hidden-files: true
          if-no-files-found: error
      - name: Complete bounded VM export gate before upload
        id: immutable_export
        if: always() && steps.immutable.outcome != 'skipped'
        timeout-minutes: 3
        run: python3 -I -B "$DEPLOY/retention.py" --public /tmp/caa-gnu-immutable-runtime/public
      - name: Retain complete bounded new-purpose evidence
        if: always() && steps.immutable_export.outcome == 'success'
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
        timeout-minutes: 5
        with:
          name: gnu-immutable-runtime-${{ github.run_id }}-${{ github.run_attempt }}
          path: /tmp/caa-gnu-immutable-runtime/public/
          retention-days: 3
          compression-level: 0
          include-hidden-files: true
          if-no-files-found: error
