name: native-arm-c01-paired-runtime
on:
  workflow_dispatch:
    inputs:
      source_sha:
        description: Exact source SHA equal to both registered workflow aliases
        type: string
        required: true
permissions:
  contents: read
concurrency:
  group: native-arm-c01-paired-runtime
  cancel-in-progress: false
jobs:
  native:
    if: github.repository == 'Gabriel-Kahen/cachy-asahi' && github.event.repository.private == false
    runs-on: ubuntu-24.04-arm
    timeout-minutes: 85
    defaults:
      run:
        shell: bash
    env:
      PYTHONDONTWRITEBYTECODE: '1'
      SOURCE_SHA: ${{ inputs.source_sha }}
      SLICE: scripts/ci/c01-native-paired-runtime
      INPUTS_SHA256: beca39e04e125a0fa72dedab2dd772e048655d80c36c216a031df0a0c3852e8f
    steps:
      - name: Checkout the exact closed native trial source
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        timeout-minutes: 2
        with:
          ref: ${{ inputs.source_sha }}
          persist-credentials: false
      - name: Prove exact paired runtime source and workflow aliases before secrets
        id: proof
        timeout-minutes: 2
        run: |
          set -euo pipefail
          printf '%s  %s\n' '@OWNER_SHA@' "$SLICE/owner.py" '@MAP_SHA@' "$SLICE/source-map.json" | sha256sum --check
          test "$INPUTS_SHA256" = beca39e04e125a0fa72dedab2dd772e048655d80c36c216a031df0a0c3852e8f
          printf '%s  %s\n' "$INPUTS_SHA256" scripts/ci/inputs.lock.json | sha256sum --check
          [[ "$SOURCE_SHA" =~ ^[0-9a-f]{40}$ ]]
          test "$(git rev-parse HEAD)" = "$SOURCE_SHA"
          test "$GITHUB_SHA" = "$SOURCE_SHA"
          test "$GITHUB_WORKFLOW_SHA" = "$SOURCE_SHA"
          cmp --silent .github/workflows/native-arm-build.yml .github/workflows/native-arm-c01-paired-runtime.yml
          env -i PATH=/usr/local/bin:/usr/bin:/bin HOME="$RUNNER_TEMP/c01-runtime-home" LANG=C.UTF-8 TZ=UTC \
            RUNNER_TEMP="$RUNNER_TEMP" TMPDIR="$RUNNER_TEMP" PYTHONDONTWRITEBYTECODE=1 \
            SOURCE_SHA="$SOURCE_SHA" GITHUB_WORKSPACE="$GITHUB_WORKSPACE" \
            GITHUB_SHA="$GITHUB_SHA" GITHUB_WORKFLOW_SHA="$GITHUB_WORKFLOW_SHA" \
            GITHUB_REPOSITORY="$GITHUB_REPOSITORY" GITHUB_RUN_ID="$GITHUB_RUN_ID" \
            GITHUB_RUN_ATTEMPT="$GITHUB_RUN_ATTEMPT" GITHUB_WORKFLOW_REF="$GITHUB_WORKFLOW_REF" \
            GITHUB_REF="$GITHUB_REF" GITHUB_EVENT_NAME="$GITHUB_EVENT_NAME" GITHUB_ACTIONS="$GITHUB_ACTIONS" RUNNER_ARCH="$RUNNER_ARCH" RUNNER_OS="$RUNNER_OS" \
            ImageVersion="${ImageVersion:-}" ImageOS="${ImageOS:-}" \
            python3 -I -B "$SLICE/owner.py" proof \
            --source-root "$GITHUB_WORKSPACE" --source-sha "$SOURCE_SHA" \
            --manifest-sha256 @MAP_SHA@ --proof "$RUNNER_TEMP/c01-runtime-proof.json" \
            --work "$RUNNER_TEMP/c01-runtime-work" --cache "$RUNNER_TEMP/alarm-cache" \
            --public "$RUNNER_TEMP/c01-runtime-public"
      - name: Run focused paired runtime source and owner controls before secrets
        timeout-minutes: 3
        run: |
          set -euo pipefail
          python3 -B -m unittest discover -s "$SLICE" -p 'test_*.py'
      - name: Seed the six exact retained inputs using existing secrets only
        timeout-minutes: 2
        env:
          CACHY_RETAINED_BUBBLEWRAP_V1_PACKAGE_01: ${{ secrets.CACHY_RETAINED_BUBBLEWRAP_V1_PACKAGE_01 }}
          CACHY_RETAINED_BUBBLEWRAP_V1_PACKAGE_02: ${{ secrets.CACHY_RETAINED_BUBBLEWRAP_V1_PACKAGE_02 }}
          CACHY_RETAINED_BUBBLEWRAP_V1_SIGNATURE_01: ${{ secrets.CACHY_RETAINED_BUBBLEWRAP_V1_SIGNATURE_01 }}
          CACHY_OLD_FOUR_SCHEMA: '1'
          CACHY_OLD_FOUR_SOURCE_EPOCH: '1791748800'
          CACHY_OLD_FOUR_JBIGKIT_01: ${{ secrets.CACHY_OLD_FOUR_JBIGKIT_01 }}
          CACHY_OLD_FOUR_JBIGKIT_02: ${{ secrets.CACHY_OLD_FOUR_JBIGKIT_02 }}
          CACHY_OLD_FOUR_JBIGKIT_SIG_01: ${{ secrets.CACHY_OLD_FOUR_JBIGKIT_SIG_01 }}
          CACHY_OLD_FOUR_LIBTIFF_01: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_01 }}
          CACHY_OLD_FOUR_LIBTIFF_02: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_02 }}
          CACHY_OLD_FOUR_LIBTIFF_03: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_03 }}
          CACHY_OLD_FOUR_LIBTIFF_04: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_04 }}
          CACHY_OLD_FOUR_LIBTIFF_05: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_05 }}
          CACHY_OLD_FOUR_LIBTIFF_06: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_06 }}
          CACHY_OLD_FOUR_LIBTIFF_07: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_07 }}
          CACHY_OLD_FOUR_LIBTIFF_08: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_08 }}
          CACHY_OLD_FOUR_LIBTIFF_09: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_09 }}
          CACHY_OLD_FOUR_LIBTIFF_10: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_10 }}
          CACHY_OLD_FOUR_LIBTIFF_11: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_11 }}
          CACHY_OLD_FOUR_LIBTIFF_12: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_12 }}
          CACHY_OLD_FOUR_LIBTIFF_13: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_13 }}
          CACHY_OLD_FOUR_LIBTIFF_14: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_14 }}
          CACHY_OLD_FOUR_LIBTIFF_15: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_15 }}
          CACHY_OLD_FOUR_LIBTIFF_SIG_01: ${{ secrets.CACHY_OLD_FOUR_LIBTIFF_SIG_01 }}
        run: |
          set -euo pipefail
          test "$INPUTS_SHA256" = beca39e04e125a0fa72dedab2dd772e048655d80c36c216a031df0a0c3852e8f
          printf '%s  %s\n' "$INPUTS_SHA256" scripts/ci/inputs.lock.json | sha256sum --check
          timeout --signal=TERM --kill-after=5s 75s python3 -B - <<'PYSEED'
          import hashlib
          import os
          from pathlib import Path
          import sys
          sys.path.insert(0, 'scripts/ci')
          from old_four_seed import (OLD_FOUR_PRIVATE_ROWS, RETAINED_BUBBLEWRAP_PRIVATE_ROWS,
                                     seed_current_build_cache)
          pin = 'beca39e04e125a0fa72dedab2dd772e048655d80c36c216a031df0a0c3852e8f'
          if hashlib.sha256(Path('scripts/ci/inputs.lock.json').read_bytes()).hexdigest() != pin:
              raise SystemExit('private-cache-input-binding-refused')
          names = {'CACHY_OLD_FOUR_' + f'{tag}_{i:02d}'
                   for _, _, _, tag, count in OLD_FOUR_PRIVATE_ROWS for i in range(1, count + 1)}
          retained = {'CACHY_RETAINED_BUBBLEWRAP_V1_' + f'{tag}_{i:02d}'
                      for _, _, _, tag, sizes in RETAINED_BUBBLEWRAP_PRIVATE_ROWS
                      for i in range(1, len(sizes) + 1)}
          names |= retained
          if len(names) != 22 or len(retained) != 3 or not all(os.environ.get(name) for name in names):
              raise SystemExit('private-cache-required-secrets-missing')
          cache = Path(os.environ['RUNNER_TEMP']) / 'alarm-cache'
          cache.mkdir(mode=0o700)
          keep = names | {'CACHY_OLD_FOUR_SCHEMA', 'CACHY_OLD_FOUR_SOURCE_EPOCH'}
          for name in tuple(os.environ):
              if name not in keep:
                  os.environ.pop(name)
          seed_current_build_cache(cache, pin)
          PYSEED
      - name: Checkout the exact fourteen public input source
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        timeout-minutes: 2
        with:
          ref: 04a4a74e16e1e1bc939ea74791bf1f1bf7b46bbd
          path: source-public14
          persist-credentials: false
      - name: Seed all fourteen exact public input files into the existing cache
        timeout-minutes: 2
        run: |
          set -euo pipefail
          printf '%s  %s\n' 'a7857658af224984065e575f6ffed8308ea85027d46eace8bda146d9033e93b3' source-public14/seed.py 'a388c8c8ba8e06cb92fd2be598b86e433c4e403b6e71a0f15b1eaec381bb7300' source-public14/index.json | sha256sum --check
          env -i PATH=/usr/local/bin:/usr/bin:/bin HOME="$RUNNER_TEMP/c01-runtime-home" LANG=C.UTF-8 TZ=UTC TMPDIR="$RUNNER_TEMP" PYTHONDONTWRITEBYTECODE=1 \
            python3 -I -B "$GITHUB_WORKSPACE/source-public14/seed.py" --cache "$RUNNER_TEMP/alarm-cache"
      - name: Checkout complete original retained package inputs
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        timeout-minutes: 2
        with:
          ref: ddc6ca5f3478f9c607f8fae52661c451ae0bf3ad
          path: source-retained
          persist-credentials: false
      - name: Move the exact retained checkout to its separate runtime input path
        timeout-minutes: 1
        run: |
          set -euo pipefail
          test -d "$GITHUB_WORKSPACE/source-retained/.git"
          test ! -e "$RUNNER_TEMP/c01-runtime-retained"
          test ! -L "$RUNNER_TEMP/c01-runtime-retained"
          mv -- "$GITHUB_WORKSPACE/source-retained" "$RUNNER_TEMP/c01-runtime-retained"
      - name: Build fresh signed original341 environment for paired runtime
        timeout-minutes: 40
        run: |
          set -euo pipefail
          timeout --signal=TERM --kill-after=30s 2300s \
          env -i PATH=/usr/local/bin:/usr/bin:/bin HOME="$RUNNER_TEMP/c01-runtime-home" LANG=C.UTF-8 TZ=UTC \
            RUNNER_TEMP="$RUNNER_TEMP" TMPDIR="$RUNNER_TEMP" PYTHONDONTWRITEBYTECODE=1 \
            SOURCE_SHA="$SOURCE_SHA" GITHUB_WORKSPACE="$GITHUB_WORKSPACE" \
            GITHUB_SHA="$GITHUB_SHA" GITHUB_WORKFLOW_SHA="$GITHUB_WORKFLOW_SHA" \
            GITHUB_REPOSITORY="$GITHUB_REPOSITORY" GITHUB_RUN_ID="$GITHUB_RUN_ID" \
            GITHUB_RUN_ATTEMPT="$GITHUB_RUN_ATTEMPT" GITHUB_WORKFLOW_REF="$GITHUB_WORKFLOW_REF" \
            GITHUB_REF="$GITHUB_REF" GITHUB_EVENT_NAME="$GITHUB_EVENT_NAME" GITHUB_ACTIONS="$GITHUB_ACTIONS" RUNNER_ARCH="$RUNNER_ARCH" RUNNER_OS="$RUNNER_OS" \
            ImageVersion="${ImageVersion:-}" ImageOS="${ImageOS:-}" \
            python3 -I -B "$SLICE/owner.py" bootstrap \
            --source-root "$GITHUB_WORKSPACE" --source-sha "$SOURCE_SHA" \
            --manifest-sha256 @MAP_SHA@ --proof "$RUNNER_TEMP/c01-runtime-proof.json" \
            --work "$RUNNER_TEMP/c01-runtime-work" --cache "$RUNNER_TEMP/alarm-cache" \
            --public "$RUNNER_TEMP/c01-runtime-public" \
            --carrier "$RUNNER_TEMP/c01-runtime-retained" --execute
      - name: Measure fixed18-slot paired baseline and LTO runtime
        timeout-minutes: 20
        run: |
          set -euo pipefail
          # Fixed source-owned profile:2 correctness,4 warmup,12 measured slots.
          # Per slot:16MiB corpus,4 iterations,45s trial;0.1s samples;900s session.
          timeout --signal=TERM --kill-after=30s 1100s \
          env -i PATH=/usr/local/bin:/usr/bin:/bin HOME="$RUNNER_TEMP/c01-runtime-home" LANG=C.UTF-8 TZ=UTC \
            RUNNER_TEMP="$RUNNER_TEMP" TMPDIR="$RUNNER_TEMP" PYTHONDONTWRITEBYTECODE=1 \
            SOURCE_SHA="$SOURCE_SHA" GITHUB_WORKSPACE="$GITHUB_WORKSPACE" \
            GITHUB_SHA="$GITHUB_SHA" GITHUB_WORKFLOW_SHA="$GITHUB_WORKFLOW_SHA" \
            GITHUB_REPOSITORY="$GITHUB_REPOSITORY" GITHUB_RUN_ID="$GITHUB_RUN_ID" \
            GITHUB_RUN_ATTEMPT="$GITHUB_RUN_ATTEMPT" GITHUB_WORKFLOW_REF="$GITHUB_WORKFLOW_REF" \
            GITHUB_REF="$GITHUB_REF" GITHUB_EVENT_NAME="$GITHUB_EVENT_NAME" GITHUB_ACTIONS="$GITHUB_ACTIONS" RUNNER_ARCH="$RUNNER_ARCH" RUNNER_OS="$RUNNER_OS" \
            ImageVersion="${ImageVersion:-}" ImageOS="${ImageOS:-}" \
            python3 -I -B "$SLICE/owner.py" measure \
            --source-root "$GITHUB_WORKSPACE" --source-sha "$SOURCE_SHA" \
            --manifest-sha256 @MAP_SHA@ --proof "$RUNNER_TEMP/c01-runtime-proof.json" \
            --work "$RUNNER_TEMP/c01-runtime-work" --cache "$RUNNER_TEMP/alarm-cache" \
            --public "$RUNNER_TEMP/c01-runtime-public" \
            --execute
      - name: Retire owned runtime consumer before original341 producer
        if: always() && steps.proof.outcome == 'success'
        timeout-minutes: 3
        run: |
          set -euo pipefail
          timeout --signal=TERM --kill-after=30s 150s \
          env -i PATH=/usr/local/bin:/usr/bin:/bin HOME="$RUNNER_TEMP/c01-runtime-home" LANG=C.UTF-8 TZ=UTC \
            RUNNER_TEMP="$RUNNER_TEMP" TMPDIR="$RUNNER_TEMP" PYTHONDONTWRITEBYTECODE=1 \
            SOURCE_SHA="$SOURCE_SHA" GITHUB_WORKSPACE="$GITHUB_WORKSPACE" \
            GITHUB_SHA="$GITHUB_SHA" GITHUB_WORKFLOW_SHA="$GITHUB_WORKFLOW_SHA" \
            GITHUB_REPOSITORY="$GITHUB_REPOSITORY" GITHUB_RUN_ID="$GITHUB_RUN_ID" \
            GITHUB_RUN_ATTEMPT="$GITHUB_RUN_ATTEMPT" GITHUB_WORKFLOW_REF="$GITHUB_WORKFLOW_REF" \
            GITHUB_REF="$GITHUB_REF" GITHUB_EVENT_NAME="$GITHUB_EVENT_NAME" GITHUB_ACTIONS="$GITHUB_ACTIONS" RUNNER_ARCH="$RUNNER_ARCH" RUNNER_OS="$RUNNER_OS" \
            ImageVersion="${ImageVersion:-}" ImageOS="${ImageOS:-}" \
            python3 -I -B "$SLICE/owner.py" cleanup \
            --source-root "$GITHUB_WORKSPACE" --source-sha "$SOURCE_SHA" \
            --manifest-sha256 @MAP_SHA@ --proof "$RUNNER_TEMP/c01-runtime-proof.json" \
            --work "$RUNNER_TEMP/c01-runtime-work" --cache "$RUNNER_TEMP/alarm-cache" \
            --public "$RUNNER_TEMP/c01-runtime-public" \
            --execute
      - name: Retain bounded public paired runtime evidence
        if: always() && steps.proof.outcome == 'success'
        timeout-minutes: 3
        run: |
          set -euo pipefail
          timeout --signal=TERM --kill-after=30s 150s \
          env -i PATH=/usr/local/bin:/usr/bin:/bin HOME="$RUNNER_TEMP/c01-runtime-home" LANG=C.UTF-8 TZ=UTC \
            RUNNER_TEMP="$RUNNER_TEMP" TMPDIR="$RUNNER_TEMP" PYTHONDONTWRITEBYTECODE=1 \
            SOURCE_SHA="$SOURCE_SHA" GITHUB_WORKSPACE="$GITHUB_WORKSPACE" \
            GITHUB_SHA="$GITHUB_SHA" GITHUB_WORKFLOW_SHA="$GITHUB_WORKFLOW_SHA" \
            GITHUB_REPOSITORY="$GITHUB_REPOSITORY" GITHUB_RUN_ID="$GITHUB_RUN_ID" \
            GITHUB_RUN_ATTEMPT="$GITHUB_RUN_ATTEMPT" GITHUB_WORKFLOW_REF="$GITHUB_WORKFLOW_REF" \
            GITHUB_REF="$GITHUB_REF" GITHUB_EVENT_NAME="$GITHUB_EVENT_NAME" GITHUB_ACTIONS="$GITHUB_ACTIONS" RUNNER_ARCH="$RUNNER_ARCH" RUNNER_OS="$RUNNER_OS" \
            ImageVersion="${ImageVersion:-}" ImageOS="${ImageOS:-}" \
            python3 -I -B "$SLICE/owner.py" retain \
            --source-root "$GITHUB_WORKSPACE" --source-sha "$SOURCE_SHA" \
            --manifest-sha256 @MAP_SHA@ --proof "$RUNNER_TEMP/c01-runtime-proof.json" \
            --work "$RUNNER_TEMP/c01-runtime-work" --cache "$RUNNER_TEMP/alarm-cache" \
            --public "$RUNNER_TEMP/c01-runtime-public"
      - name: Upload only the closed public evidence directory
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
        timeout-minutes: 2
        with:
          name: c01-native-paired-runtime-${{ github.run_id }}-${{ github.run_attempt }}
          include-hidden-files: true
          retention-days: 3
          if-no-files-found: ignore
          path: ${{ runner.temp }}/c01-runtime-public/
