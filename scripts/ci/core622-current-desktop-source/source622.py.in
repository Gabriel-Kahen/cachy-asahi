def files(root):
 result={}
 for p in Path(root).rglob('*'):
  name=p.relative_to(root).as_posix()
  if name.split('/')[0]=='.git':continue
  C.need(not p.is_symlink()and(p.is_dir()or p.is_file()),'ordinary full closed source')
  if p.is_file():result[name]=C.pin(C.read(p,32*1024**2))
 return result

def inverse(root):
 record=C.decode(C.read(root/'composition-parent.json',4*1024**2));rows=files(root);before=record['before'];C.need(record['source']=='11b3cfb59663e42b34247facb9f30f042e891444'and len(before)==51 and set(record['changed'])<=set(before),'whole published51 predecessor')
