 for n,pin in before.items():
  raw=record['changed'][n].encode()if n in record['changed']else C.read(root/n,32*1024**2);C.need(C.pin(raw)==pin,'complete exact51 inverse: '+n);out[n]=raw
 C.need({n:C.pin(raw)for n,raw in out.items()}==before,'whole before-source51 map');return out

