  need(pair[0]['clean_environment_id']!=pair[1]['clean_environment_id']and all(pair[0][k]==pair[1][k]for k in('image','image_id','mode','source_date_epoch','recipe_inputs','recipe_metadata','expected_packages_sha256','entry_script_sha256'))and pair[0]['artifacts']==pair[1]['artifacts'],'same original pair inputs and complete package-byte identity across distinct recorded environments')
