_context() {
  [[ ${CACHY_ASAHI_CONTAINER:-} == 1 && $CARCH == aarch64 ]] || return 2
  [[ -f /run/.containerenv || -f /.dockerenv ]] || return 2
  [[ $(uname -m) == aarch64 ]] || return 2
  [[ ${SOURCE_DATE_EPOCH:-1791585070} == 1791585070 ]] || return 2
  export SOURCE_DATE_EPOCH=1791585070
}

_source_pack() {
  python -I -B -S -W error "$startdir/source-check.py" \
    --srcdir "$startdir" --recipe "$startdir/PKGBUILD" "$@"
}

_checked_tree() {
  _context || return
  _source_pack --tree "$srcdir/jbigkit-2.2" --patched
}

prepare() {
  _context || return
  _source_pack --tree "$srcdir/jbigkit-2.2" || return
  cd "$srcdir/jbigkit-2.2" || return
  patch --batch --forward --fuzz=0 -p1 -i "$startdir/jbigkit-2.2-shared_lib.patch" || return
  patch --batch --forward --fuzz=0 -p1 -i "$startdir/jbigkit-project-filter-tests.patch" || return
  _source_pack --tree "$srcdir/jbigkit-2.2" --patched
}

build() {
  _checked_tree || return
  cd "$srcdir/jbigkit-2.2" || return
  make CC=gcc EXTRA_CFLAGS="$CFLAGS -fPIC" LDFLAGS="$LDFLAGS" all
}

check() {
  _checked_tree || return
  cd "$srcdir/jbigkit-2.2" || return
  local n fixture encoded decoded
  local LD_LIBRARY_PATH="$srcdir/jbigkit-2.2/libjbig"
  export LD_LIBRARY_PATH
  make -C libjbig -j1 CC=gcc EXTRA_CFLAGS="$CFLAGS -fPIC" LDFLAGS="$LDFLAGS" test || return
  for n in 0 1 2 3 4; do
    fixture="$startdir/synthetic-$n.pbm"
    encoded="$srcdir/synthetic-$n.jbg"
    decoded="$srcdir/synthetic-$n.decoded.pbm"
    pbmtools/pbmtojbg "$fixture" "$encoded" || return
    pbmtools/jbgtopbm "$encoded" "$decoded" || return
    python -I -B -S -W error "$startdir/synthetic-pbm.py" --compare "$fixture" "$decoded" || return
    pbmtools/pbmtojbg85 "$fixture" "$encoded" || return
    pbmtools/jbgtopbm85 "$encoded" "$decoded" || return
    python -I -B -S -W error "$startdir/synthetic-pbm.py" --compare "$fixture" "$decoded" || return
    pbmtools/jbgtopbm "$encoded" "$decoded" || return
    python -I -B -S -W error "$startdir/synthetic-pbm.py" --compare "$fixture" "$decoded" || return
  done
}

package() {
  _checked_tree || return
  cd "$srcdir/jbigkit-2.2" || return
  local header library tool page input
  for header in jbig.h jbig85.h jbig_ar.h; do
    install -Dm644 "libjbig/$header" "$pkgdir/usr/include/$header" || return
  done
  for library in libjbig libjbig85; do
    install -Dm755 "libjbig/$library.so.2.2" "$pkgdir/usr/lib/$library.so.2.2" || return
    ln -s "$library.so.2.2" "$pkgdir/usr/lib/$library.so" || return
  done
  for tool in jbgtopbm jbgtopbm85 pbmtojbg pbmtojbg85; do
    install -Dm755 "pbmtools/$tool" "$pkgdir/usr/bin/$tool" || return
  done
  for page in jbgtopbm.1 pbmtojbg.1; do
    install -Dm644 "pbmtools/$page" "$pkgdir/usr/share/man/man1/$page" || return
  done
  for input in COPYING LICENSE.recipe NOTICE upstream-ANNOUNCE packaging-REUSE.toml; do
    install -Dm644 "$startdir/$input" "$pkgdir/usr/share/licenses/$pkgname/$input" || return
  done
  for input in "${source[@]}"; do
    install -Dm644 "$startdir/$input" "$pkgdir/usr/share/doc/$pkgname/source/$input" || return
  done
  install -Dm644 "$startdir/PKGBUILD" "$pkgdir/usr/share/doc/$pkgname/source/PKGBUILD" || return
  _source_pack --public-bundle "$pkgdir/usr/share/doc/$pkgname/source"
}
