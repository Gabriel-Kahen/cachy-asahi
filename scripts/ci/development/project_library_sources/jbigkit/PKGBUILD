  'packaging-REUSE.toml'
  'LICENSE.recipe'
  'NOTICE'
  'PUBLICATION.md'
  'removal.md'
  'inputs.json'
  'source-filter.json'
  'source-check.py'
  'synthetic-pbm.py'
  'synthetic-0.pbm'
  'synthetic-1.pbm'
  'synthetic-2.pbm'
  'synthetic-3.pbm'
  'synthetic-4.pbm'
)
