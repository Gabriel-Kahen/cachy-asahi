pkgname=cachy-asahi-jbigkit
pkgver=2.2
pkgrel=1.1
pkgdesc='JBIG libraries and tools with project synthetic tests (filtered source)'
arch=('aarch64')
url='https://www.cl.cam.ac.uk/~mgk25/jbigkit/'
license=('GPL-2.0-or-later')
depends=('glibc')
makedepends=('gcc' 'make' 'patch' 'python')
options=('!staticlibs' '!lto' '!debug')
# Proposed until Root measures the actual project SONAMEs and architecture.
provides=('jbigkit=2.2' 'libjbig.so=2.2-64' 'libjbig85.so=2.2-64')
conflicts=('jbigkit')

source=(
  'jbigkit-2.2-project-filtered.tar.gz'
  'jbigkit-2.2-shared_lib.patch'
  'jbigkit-project-filter-tests.patch'
