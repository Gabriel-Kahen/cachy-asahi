FROM native-developer-base:cb2d8f3f2f9a5c770b7f1442
USER root
COPY deps/ /tmp/developer-deps/
COPY tools/ /opt/native-developer-tools/
COPY disabled-hooks.txt /tmp/developer-hooks.txt
RUN while IFS= read -r hook; do ln -sf /dev/null "/builder-disabled-hooks/$hook"; done < /tmp/developer-hooks.txt && pacman -U --noconfirm --noscriptlet /tmp/developer-deps/*.pkg.tar.xz && ldconfig && rm -rf /tmp/developer-deps /tmp/developer-hooks.txt /var/cache/pacman/pkg/* && pacman -Q | LC_ALL=C sort > /builder-packages.lock
COPY native-build-namespace-preflight-v1/source/ /opt/native-native-build-namespace-preflight-v1/source/
RUN /usr/bin/mkdir -m 0755 /opt/native-native-build-namespace-preflight-v1/evidence && /usr/bin/chown alarm:alarm /opt/native-native-build-namespace-preflight-v1/evidence
USER alarm
WORKDIR /tmp
RUN ["/usr/bin/bash", "--noprofile", "--norc", "-p", "-c", "test \"$BASHPID\" -eq 1 || exit 125; /usr/bin/python3 -I -B /opt/native-native-build-namespace-preflight-v1/source/native/build_tools_alpm_v2.py --inside-image --map-sha256 bf6d956b671b4c3df38aa579277319c1f4030a9e5efd14778fd9db528072a726 --token cb2d8f3f2f9a5c770b7f1442 & namespace_owner=$!; namespace_status=0; wait \"$namespace_owner\" || namespace_status=$?; exit \"$namespace_status\""]
