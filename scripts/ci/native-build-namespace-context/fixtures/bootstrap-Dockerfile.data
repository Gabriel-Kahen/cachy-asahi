FROM scratch
ADD rootfs.tar.gz /
COPY keys/ /usr/share/pacman/keyrings/
COPY deps/ /tmp/deps/
COPY pacman.conf /etc/pacman.conf
COPY disabled-hooks.txt /tmp/disabled-hooks.txt
RUN mkdir -p /builder-disabled-hooks && while IFS= read -r hook; do ln -s /dev/null "/builder-disabled-hooks/$hook"; done < /tmp/disabled-hooks.txt && pacman-key --init && pacman-key --populate archlinuxarm && pacman -U --noconfirm --noscriptlet /tmp/deps/*.pkg.tar.xz && gpgconf --homedir /etc/pacman.d/gnupg --kill gpg-agent && test ! -e /etc/pacman.d/gnupg/S.gpg-agent && test ! -L /etc/pacman.d/gnupg/S.gpg-agent && test ! -e /etc/pacman.d/gnupg/S.gpg-agent.browser && test ! -L /etc/pacman.d/gnupg/S.gpg-agent.browser && test ! -e /etc/pacman.d/gnupg/S.gpg-agent.extra && test ! -L /etc/pacman.d/gnupg/S.gpg-agent.extra && test ! -e /etc/pacman.d/gnupg/S.gpg-agent.ssh && test ! -L /etc/pacman.d/gnupg/S.gpg-agent.ssh && ldconfig && rm -rf /tmp/deps /var/cache/pacman/pkg/* && groupmod -g 1001 alarm && usermod -u 1001 -g alarm alarm && pacman -Q | LC_ALL=C sort > /builder-packages.lock
USER alarm
WORKDIR /tmp
