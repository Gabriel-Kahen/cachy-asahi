# SPDX-License-Identifier: MIT
"""Public PROJECT_TEST signature component; never overall package admission.

No default actor exists. The caller supplies an independently supervised gpgv
boundary. Packet parsing identifies public metadata; only that boundary can
establish signature mathematics. Root selection and its digest are external.
"""
import ast
import hashlib
import json
import re
from pathlib import Path

SCOPE = 'BANKSTOWN_QT3_PROJECT_TEST_SIGNATURE_ONLY'
PARSER_SHA256 = '6926902e69e639b999aa67d7ff01b617ec7c57e9074ba8d52330f21cf24edfa9'
MAX_PACKAGE = 512 * 1024 * 1024
MAX_PUBLIC = 16384
MAX_OUTPUT = 32768


def need(ok, reason):
    if not ok:
        raise ValueError(reason)


def pin(raw):
    return dict(bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())


def _packets(raw):
    """Compile ONLY packets() from the whole byte-pinned existing parser."""
    source = Path(__file__).resolve().parents[1] / 'management-tools-generic16k/signature_observer.py'
    data = source.read_bytes()
    need(len(data) == 9009 and pin(data)['sha256'] == PARSER_SHA256, 'PINNED_PACKET_PARSER')
    tree = ast.parse(data)
    functions = [n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == 'packets']
    need(len(functions) == 1, 'ONE_PACKET_PARSER')
    scope = dict(need=need, MAX_PUBLIC=MAX_PUBLIC)
    exec(compile(ast.Module(body=functions, type_ignores=[]), str(source), 'exec'), scope)
    return scope['packets'](raw)


def _fingerprint(body):
    need(len(body) >= 6 and body[0] == 4, 'BINARY_PUBLIC_V4_ONLY')
    return hashlib.sha1(b'\x99' + len(body).to_bytes(2, 'big') + body).hexdigest().upper()


def _metadata(public_key, signature):
    packets = _packets(public_key)
    need(packets[0][0] == 6 and sum(t == 6 for t, _ in packets) == 1
         and all(t in (2, 6, 13, 14) for t, _ in packets), 'PUBLIC_KEY_PACKETS_ONLY')
    fingerprints = [_fingerprint(b) for t, b in packets if t in (6, 14)]
    need(len(set(fingerprints)) == len(fingerprints), 'UNIQUE_PUBLIC_FINGERPRINTS')
    need(all(b[0] == 4 for t, b in packets if t == 2), 'V4_PUBLIC_CERTIFICATIONS_ONLY')
    detached = _packets(signature)
    need(len(detached) == 1 and detached[0][0] == 2, 'SINGLE_DETACHED_SIGNATURE')
    body = detached[0][1]
    need(len(body) >= 11 and body[0] == 4 and body[1] == 0, 'V4_BINARY_DOCUMENT_SIGNATURE')
    hashed = int.from_bytes(body[4:6], 'big')
    pos = 6 + hashed
    need(pos + 2 <= len(body), 'DETACHED_HASHED_BOUND')
    unhashed = int.from_bytes(body[pos:pos + 2], 'big')
    need(pos + 2 + unhashed + 3 <= len(body), 'DETACHED_UNHASHED_AND_MATH_BOUND')
    need(body[3] in (8, 9, 10, 11), 'APPROVED_SHA2_DETACHED_DIGEST')
    return (fingerprints, { _fingerprint(b): b[5] for t, b in packets if t in (6, 14)},
            body[2], body[3])


def _object(raw):
    def pairs(rows):
        result = {}
        for key, value in rows:
            need(key not in result, 'DUPLICATE_ROOT_FIELD')
            result[key] = value
        return result
    try:
        return json.loads(raw, object_pairs_hook=pairs)
    except (UnicodeError, json.JSONDecodeError) as error:
        raise ValueError('ROOT_JSON') from error


def _selection(raw, external_sha, now, operands, fingerprints, official_fingerprints, official_key_sha256):
    need(type(raw) is bytes and 0 < len(raw) <= 16384, 'BOUNDED_EXTERNAL_ROOT')
    need(type(external_sha) is str and re.fullmatch('[0-9a-f]{64}', external_sha)
         and pin(raw)['sha256'] == external_sha, 'EXTERNALLY_PROVIDED_ROOT_SHA256')
    root = _object(raw)
    fields = {'schema_version', 'scope', 'issuer', 'approved', 'public_only', 'issued_epoch',
              'expires_epoch', 'primary_fingerprint', 'signing_fingerprint', 'package',
              'signature', 'public_key', 'tampered_package', 'pacman'}
    need(type(root) is dict and set(root) == fields, 'EXACT_EXTERNAL_ROOT_SELECTION')
    need(type(root['schema_version']) is int and root['schema_version'] == 1
         and root['scope'] == SCOPE and root['approved'] is True and root['public_only'] is True
         and type(root['issuer']) is str and 0 < len(root['issuer']) <= 160
         and root['issuer'].strip() == root['issuer'], 'EXTERNAL_PUBLIC_TEST_SELECTION')
    issued, expires = root['issued_epoch'], root['expires_epoch']
    need(type(now) is int and type(issued) is int and type(expires) is int
         and 0 <= issued <= now < expires and 0 < expires - issued <= 86400, 'CURRENT_ROOT_MAX_24_HOURS')
    need(expires - now > 3 * 30, 'ROOT_REMAINING_LIFETIME_FOR_THREE_CONTROLS')
    for name, raw_operand in operands.items():
        descriptor = root[name]
        need(type(descriptor) is dict and set(descriptor) == {'bytes', 'sha256'}
             and type(descriptor['bytes']) is int and descriptor == pin(raw_operand), 'EXACT_' + name.upper() + '_BYTES')
    need(operands['package'] != operands['tampered_package']
         and root['package']['sha256'] != root['tampered_package']['sha256'], 'DISTINCT_TAMPER_CONTROL')
    original, tampered = operands['package'], operands['tampered_package']
    need(len(original) == len(tampered) and tampered[0] == original[0] ^ 1
         and memoryview(tampered)[1:] == memoryview(original)[1:], 'EXACT_FIRST_BYTE_BIT_FLIP_CONTROL')
    for field in ('primary_fingerprint', 'signing_fingerprint'):
        need(type(root[field]) is str and re.fullmatch('[0-9A-F]{40}', root[field]), 'FULL_V4_FINGERPRINT')
    need(root['primary_fingerprint'] == fingerprints[0]
         and root['signing_fingerprint'] in fingerprints, 'SELECTED_PUBLIC_KEY_FINGERPRINTS')
    need(type(official_fingerprints) in (set, frozenset) and official_fingerprints
         and all(type(x) is str and re.fullmatch('[0-9A-F]{40}', x) for x in official_fingerprints), 'EXTERNAL_OFFICIAL_FULL_FINGERPRINTS')
    need(type(official_key_sha256) in (set, frozenset) and official_key_sha256
         and all(type(x) is str and re.fullmatch('[0-9a-f]{64}', x) for x in official_key_sha256), 'EXTERNAL_OFFICIAL_KEY_HASHES')
    need(not set(fingerprints) & official_fingerprints
         and root['public_key']['sha256'] not in official_key_sha256, 'DISJOINT_FROM_OFFICIAL_ALARM_TRUST')
    need(root['pacman'] == dict(repository='PROJECT_TEST', SigLevel=['Required', 'TrustedOnly'],
                               LocalFileSigLevel=['Required', 'TrustedOnly']), 'REQUIRED_TRUSTEDONLY_PROJECT_TEST')
    return root


def gpgv_argv(home, keyring, signature, package):
    return ['/usr/bin/gpgv', '--homedir', str(home), '--keyring', str(keyring),
            '--status-fd', '1', '--', str(signature), str(package)]


def _result(value, argv, env, kind, root):
    fields = {'argv', 'env', 'timeout_seconds', 'exit', 'stdout', 'stderr', 'natural_exit',
              'pid', 'pgid', 'group_absent', 'seconds', 'owned_processes_absent'}
    need(type(value) is dict and set(value) == fields, 'EXACT_SUPERVISED_GPGV_RECORD')
    need(value['argv'] == argv and value['env'] == env
         and type(value['timeout_seconds']) is int and value['timeout_seconds'] == 30, 'EXACT_GPGV_ARGV_ENV_TIMEOUT')
    need(type(value['pid']) is int and type(value['pgid']) is int and value['pid'] == value['pgid'] > 1
         and value['natural_exit'] is True and value['group_absent'] is True
         and value['owned_processes_absent'] is True
         and type(value['seconds']) in (float, int) and 0 <= value['seconds'] <= 30, 'NATURAL_EXIT_AND_REAPED_GROUP')
    need(type(value['exit']) is int and 0 <= value['exit'] <= 255
         and all(type(value[f]) is bytes and len(value[f]) <= MAX_OUTPUT for f in ('stdout', 'stderr')), 'BOUNDED_GPGV_PIPES_EXIT')
    try:
        lines = value['stdout'].decode('ascii').splitlines()
    except UnicodeError as error:
        raise ValueError('ASCII_GPGV_STATUS') from error
    need(0 < len(lines) <= 64 and all(x.startswith('[GNUPG:] ') and len(x) <= 2048 for x in lines), 'BOUNDED_GPGV_STATUSES')
    statuses = [line[9:].split() for line in lines]
    need(all(s for s in statuses), 'NONEMPTY_GPGV_STATUS')
    names = [s[0] for s in statuses]
    common = {'NEWSIG', 'KEY_CONSIDERED', 'SIG_ID'}
    allowed = common | ({'GOODSIG', 'VALIDSIG'} if kind == 'positive' else
                        {'BADSIG'} if kind == 'tamper' else {'ERRSIG', 'NO_PUBKEY'})
    need(set(names) <= allowed, 'NO_UNKNOWN_EXPIRED_OR_BAD_GPGV_STATUS')
    signer, primary = root['signing_fingerprint'], root['primary_fingerprint']
    for status in statuses:
        if status[0] == 'KEY_CONSIDERED':
            need(len(status) == 3 and status[1] == primary and status[2].isdigit(), 'CURRENT_SELECTED_KEY_CONSIDERED')
        if status[0] in ('GOODSIG', 'BADSIG', 'NO_PUBKEY', 'ERRSIG'):
            need(len(status) >= 2 and status[1] == signer[-16:], 'SAME_SIGNATURE_KEY_ID')
    if kind == 'positive':
        need(value['exit'] == 0 and names.count('GOODSIG') == names.count('VALIDSIG') == 1, 'ACTUAL_PACKAGE_VALID_SIGNATURE')
        valid = next(s for s in statuses if s[0] == 'VALIDSIG')
        need(len(valid) in (10, 11) and valid[1] == signer and valid[5] == '4'
             and valid[6] == '0' and valid[7] == str(root['_public_algorithm'])
             and valid[8] == str(root['_hash_algorithm']) and valid[9] == '00'
             and (valid[10] if len(valid) == 11 else valid[1]) == primary, 'FULL_VALID_SIGNATURE_JOIN')
        need(valid[3].isdigit() and valid[4].isdigit()
             and int(valid[3]) <= root['_now'] and (int(valid[4]) == 0 or root['_now'] < int(valid[4])), 'CURRENT_SIGNATURE_STATUS')
    elif kind == 'tamper':
        need(value['exit'] != 0 and names.count('BADSIG') == 1, 'TAMPER_MUST_BE_BAD_SIGNATURE')
    else:
        need(value['exit'] != 0 and names.count('NO_PUBKEY') == 1 and names.count('ERRSIG') <= 1, 'EMPTY_HOME_MUST_BE_UNKNOWN_KEY')
    return {**{k: value[k] for k in fields - {'stdout', 'stderr'}},
            'stdout': pin(value['stdout']), 'stderr': pin(value['stderr']), 'statuses': lines, 'control': kind}


def verify(*, package, signature, public_key, tampered_package, trust_raw, external_sha,
           now, work, call, official_fingerprints, official_key_sha256):
    """Validate a TEST-only signature component using three supervised calls.

    call(argv, env, timeout=30) must report exact pipes and process-group reaping.
    No callback is supplied here. DATA tests model this boundary, never crypto.
    The trusted caller supplies the complete official ALARM primary/subkey
    fingerprint union and public-key byte hashes from its pinned official inputs.
    Omission of an official key from that union is outside this component's view.
    """
    operands = dict(package=package, signature=signature, public_key=public_key,
                    tampered_package=tampered_package)
    need(callable(call), 'EXPLICIT_SUPERVISED_SIGNATURE_BOUNDARY_REQUIRED')
    need(all(type(raw) is bytes and 0 < len(raw) <= (MAX_PACKAGE if name in ('package', 'tampered_package') else MAX_PUBLIC)
             for name, raw in operands.items()), 'BOUNDED_BINARY_OPERANDS')
    fingerprints, key_algorithms, public_algorithm, hash_algorithm = _metadata(public_key, signature)
    root = _selection(trust_raw, external_sha, now, operands, fingerprints,
                      official_fingerprints, official_key_sha256)
    root['_now'] = now
    need(key_algorithms[root['signing_fingerprint']] == public_algorithm, 'SELECTED_KEY_DETACHED_ALGORITHM_JOIN')
    root['_public_algorithm'], root['_hash_algorithm'] = public_algorithm, hash_algorithm
    work = Path(work)
    need(work.is_absolute() and work == work.resolve() and not work.exists()
         and all(not p.is_symlink() for p in (work, *work.parents)), 'FRESH_UNALIASED_PUBLIC_WORK')
    work.mkdir(mode=0o700)
    homes = [work / name for name in ('public-home', 'unknown-public-home')]
    for home in homes:
        home.mkdir(mode=0o700)
    files = {work / 'package': package, work / 'tampered-package': tampered_package,
             work / 'signature': signature, work / 'public.gpg': public_key, work / 'empty-public.gpg': b''}
    for path, raw in files.items():
        path.write_bytes(raw)
        path.chmod(0o600)

    def identity(path):
        value = path.lstat()
        return tuple(getattr(value, name) for name in
                     ('st_dev', 'st_ino', 'st_uid', 'st_nlink', 'st_mode', 'st_size', 'st_mtime_ns', 'st_ctime_ns'))

    identities = {path: identity(path) for path in (*files, *homes, work)}

    def unchanged():
        need(set(work.iterdir()) == set(files) | set(homes)
             and all(identity(path) == expected for path, expected in identities.items())
             and all(not path.is_symlink() and path.is_file() and path.stat().st_nlink == 1
                     and path.read_bytes() == raw for path, raw in files.items())
             and all(not home.is_symlink() and home.is_dir() and not list(home.iterdir()) for home in homes), 'PUBLIC_CONTROL_INPUTS_UNCHANGED')

    records = []
    for kind, home, key, data in (
        ('positive', homes[0], work / 'public.gpg', work / 'package'),
        ('tamper', homes[0], work / 'public.gpg', work / 'tampered-package'),
        ('unknown-key', homes[1], work / 'empty-public.gpg', work / 'package'),
    ):
        unchanged()
        argv = gpgv_argv(home, key, work / 'signature', data)
        env = dict(PATH='/usr/bin:/bin', HOME=str(home), GNUPGHOME=str(home), LC_ALL='C')
        observed = call(list(argv), dict(env), timeout=30)
        unchanged()
        records.append(_result(observed, argv, env, kind, root))
    return dict(schema_version=1, scope=SCOPE, status='TEST_SIGNATURE_COMPONENT_VERIFIED',
                overall_admission=False, Root_sha256=external_sha, observed_epoch=now,
                operands={name: pin(raw) for name, raw in operands.items()},
                primary_fingerprint=root['primary_fingerprint'], signing_fingerprint=root['signing_fingerprint'],
                controls=records)
