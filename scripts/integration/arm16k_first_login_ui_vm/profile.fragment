umask 077
printf entered > /home/builder/PROFILE_ENTERED
/usr/bin/python3 -I -B /usr/local/libexec/seat-user-proof.py 2>/home/builder/SEAT_ERROR
rc=$?
if [ "$rc" = 0 ];then
 /usr/bin/python3 -I -B /usr/local/libexec/ui-client.py 2>/home/builder/UI_ERROR
 rc=$?
fi
printf '%s' "$rc" > /home/builder/PROOF_EXIT_STATUS
if [ "$rc" = 0 ];then
 for n in $(seq 1 300);do
  [ -f /run/ui-session/UI_VERIFIED ] && break
  sleep .1
 done
 if [ -f /run/ui-session/UI_VERIFIED ];then printf ready > /home/builder/SHELL_RETURNED;fi
fi
PS1='seat$ '
