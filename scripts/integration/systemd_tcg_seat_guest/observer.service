[Unit]
Description=Owned real VT/seat observer (no session or authorization grants)
Wants=polkit.service systemd-logind.service getty@tty1.service
After=polkit.service systemd-logind.service systemd-udev-trigger.service

[Service]
Type=exec
RuntimeDirectory=tcg-seat
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/python3 -I -B /usr/local/libexec/seat-observer.py
TimeoutStopSec=10
RuntimeMaxSec=240
