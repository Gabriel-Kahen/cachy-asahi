[Unit]
Description=Owned x86 NM session fixture observer (no authorization grants)
Wants=NetworkManager.service polkit.service
After=NetworkManager.service polkit.service systemd-logind.service dbus.service
Before=serial-getty@ttyS0.service

[Service]
Type=notify
NotifyAccess=main
RuntimeDirectory=nm-session-fixture
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/python3 -I -B /usr/local/libexec/nm-session-fixture.py
TimeoutStartSec=60
TimeoutStopSec=10
RuntimeMaxSec=300
