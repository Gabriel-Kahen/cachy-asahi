[Unit]
Description=Owned ARM16K seat signed minimal-provider installation
After=local-fs.target systemd-tmpfiles-setup.service
Before=getty@tty1.service arm16k-virtio-seat-observer.service
[Service]
Type=oneshot
ExecStart=/usr/bin/bash /usr/local/libexec/arm16k-seat-install
RemainAfterExit=yes
TimeoutStartSec=240
MemoryMax=1G
TasksMax=128
KillMode=control-group
[Install]
WantedBy=multi-user.target
